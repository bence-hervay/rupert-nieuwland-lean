import Definitions.Polyhedra
import Mathlib.Analysis.Real.Sqrt

/-!
# The icosidodecahedron

The polyhedron `Archimedean.Icosidodecahedron.polyhedron`: the convex hull of 30 points.
-/

namespace Nieuwland.Archimedean.Icosidodecahedron

open Classical in
/-- The icosidodecahedron: the convex hull of these 30 points. -/
noncomputable def polyhedron : Polyhedron where
  vertices := [
    ![0, 0, 1/2 + 1/2 * √5],
    ![0, 0, -1/2 - 1/2 * √5],
    ![1/2 + 1/2 * √5, 0, 0],
    ![-1/2 - 1/2 * √5, 0, 0],
    ![0, 1/2 + 1/2 * √5, 0],
    ![0, -1/2 - 1/2 * √5, 0],
    ![1/2, 1/4 + 1/4 * √5, 3/4 + 1/4 * √5],
    ![1/2, 1/4 + 1/4 * √5, -3/4 - 1/4 * √5],
    ![1/2, -1/4 - 1/4 * √5, 3/4 + 1/4 * √5],
    ![1/2, -1/4 - 1/4 * √5, -3/4 - 1/4 * √5],
    ![-1/2, 1/4 + 1/4 * √5, 3/4 + 1/4 * √5],
    ![-1/2, 1/4 + 1/4 * √5, -3/4 - 1/4 * √5],
    ![-1/2, -1/4 - 1/4 * √5, 3/4 + 1/4 * √5],
    ![-1/2, -1/4 - 1/4 * √5, -3/4 - 1/4 * √5],
    ![3/4 + 1/4 * √5, 1/2, 1/4 + 1/4 * √5],
    ![3/4 + 1/4 * √5, 1/2, -1/4 - 1/4 * √5],
    ![3/4 + 1/4 * √5, -1/2, 1/4 + 1/4 * √5],
    ![3/4 + 1/4 * √5, -1/2, -1/4 - 1/4 * √5],
    ![-3/4 - 1/4 * √5, 1/2, 1/4 + 1/4 * √5],
    ![-3/4 - 1/4 * √5, 1/2, -1/4 - 1/4 * √5],
    ![-3/4 - 1/4 * √5, -1/2, 1/4 + 1/4 * √5],
    ![-3/4 - 1/4 * √5, -1/2, -1/4 - 1/4 * √5],
    ![1/4 + 1/4 * √5, 3/4 + 1/4 * √5, 1/2],
    ![1/4 + 1/4 * √5, 3/4 + 1/4 * √5, -1/2],
    ![1/4 + 1/4 * √5, -3/4 - 1/4 * √5, 1/2],
    ![1/4 + 1/4 * √5, -3/4 - 1/4 * √5, -1/2],
    ![-1/4 - 1/4 * √5, 3/4 + 1/4 * √5, 1/2],
    ![-1/4 - 1/4 * √5, 3/4 + 1/4 * √5, -1/2],
    ![-1/4 - 1/4 * √5, -3/4 - 1/4 * √5, 1/2],
    ![-1/4 - 1/4 * √5, -3/4 - 1/4 * √5, -1/2]].toFinset

end Nieuwland.Archimedean.Icosidodecahedron
