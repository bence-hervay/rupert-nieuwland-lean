set_option maxHeartbeats 0 in
/-- System 0 of `ν Archimedean.Icosidodecahedron.polyhedron`: the equation `57121 * ℓ ^ 16 - 1005660 * ℓ ^ 14 + 6295890 * ℓ ^ 12 - 19705400 * ℓ ^ 10 + 34809675 * ℓ ^ 8 - 36293000 * ℓ ^ 6 + 22183250 * ℓ ^ 4 - 7392500 * ℓ ^ 2 + 1050625 = 0` with `ℓ` in the interval of the number's decimals (the system of `archimedeanIcosidodecahedron_exact`). -/
noncomputable def archimedeanIcosidodecahedron_nu_system_0 : PolynomialSystem :=
  ⟨[([(1050625, []), (22183250, [(0, 4)]), (34809675, [(0, 8)]), (6295890, [(0, 12)]), (57121, [(0, 16)])],
     [(7392500, [(0, 2)]), (36293000, [(0, 6)]), (19705400, [(0, 10)]), (1005660, [(0, 14)])])],
   [(250221356971897248260753025633/250000000000000000000000000000, 1000885427887588993043012102533/1000000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Archimedean.Icosidodecahedron.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `archimedeanIcosidodecahedron_nu_roots`. -/
theorem archimedeanIcosidodecahedron_nu_roots_list :
    PolynomialSystem.IsRootMax [archimedeanIcosidodecahedron_nu_system_0] Archimedean.Icosidodecahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var archimedeanIcosidodecahedron_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Archimedean.Icosidodecahedron.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem archimedeanIcosidodecahedron_nu_system_0_oneRoot : archimedeanIcosidodecahedron_nu_system_0.HasUniqueRoot :=
  archimedeanIcosidodecahedron_nu_roots_list.2 _ (by simp)

