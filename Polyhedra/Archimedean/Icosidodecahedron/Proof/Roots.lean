set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Archimedean.Icosidodecahedron.polyhedron`, by roots**: `ν Archimedean.Icosidodecahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `archimedeanIcosidodecahedron_nu_system_<j>`. -/
theorem archimedeanIcosidodecahedron_nu_roots :
    ν Archimedean.Icosidodecahedron.polyhedron ∈ Set.Icc ((1000885427887588993043012102532 : ℝ) / 10 ^ 30) ((1000885427887588993043012102533 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Archimedean.Icosidodecahedron.polyhedron) :=
  ⟨archimedeanIcosidodecahedron_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) archimedeanIcosidodecahedron_nu_roots_list⟩

