  exact PolynomialSystem.ct_isPoseRoot h List.mem_cons_self Pose.ArchimedeanTruncatedCuboctahedron.len_eq Pose.ArchimedeanTruncatedCuboctahedron.reps_eq
    (Root.ParData.sqrt_spec (by decide +kernel)) Pose.ArchimedeanTruncatedCuboctahedron.par_ok Pose.ArchimedeanTruncatedCuboctahedron.zs_eq Pose.ArchimedeanTruncatedCuboctahedron.weak_ok Pose.ArchimedeanTruncatedCuboctahedron.poly_eq Pose.ArchimedeanTruncatedCuboctahedron.ok

