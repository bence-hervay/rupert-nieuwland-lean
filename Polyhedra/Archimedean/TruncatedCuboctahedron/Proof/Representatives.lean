set_option maxHeartbeats 0 in
/-- **Every system of `ν Archimedean.TruncatedCuboctahedron.polyhedron` has its one root at `ν Archimedean.TruncatedCuboctahedron.polyhedron`**: each of the systems of `archimedeanTruncatedCuboctahedron_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem archimedeanTruncatedCuboctahedron_nu_shared_list :
    PolynomialSystem.IsRootEq [archimedeanTruncatedCuboctahedron_nu_system_0] Archimedean.TruncatedCuboctahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton archimedeanTruncatedCuboctahedron_nu_roots_list

/-- **The representatives of `ν Archimedean.TruncatedCuboctahedron.polyhedron`**: the same system, each with exactly one root, at the scale `ν Archimedean.TruncatedCuboctahedron.polyhedron`. -/
theorem archimedeanTruncatedCuboctahedron_nu_reps_list :
    PolynomialSystem.IsRootEq [archimedeanTruncatedCuboctahedron_nu_system_0] Archimedean.TruncatedCuboctahedron.polyhedron.nieuwland :=
  archimedeanTruncatedCuboctahedron_nu_shared_list

