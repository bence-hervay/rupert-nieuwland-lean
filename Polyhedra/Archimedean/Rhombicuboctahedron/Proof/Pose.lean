/-- **ν and an optimal pose of `Archimedean.Rhombicuboctahedron.polyhedron` as one root**: when the representatives' systems have
exactly one root each, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it
`matAt x 42`, `matAt x 33` and `(x 51, x 52)` are a weak fit of `Archimedean.Rhombicuboctahedron.polyhedron` scaled
by `N` through itself. -/
theorem archimedeanRhombicuboctahedron_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.ArchimedeanRhombicuboctahedron.reps0, Pose.ArchimedeanRhombicuboctahedron.reps1] N) :
    PolynomialSystem.IsPoseRoot Archimedean.Rhombicuboctahedron.polyhedron Pose.ArchimedeanRhombicuboctahedron.S N 42 33 51 := by
  rw [Pose.ArchimedeanRhombicuboctahedron.S_eq]
  exact PolynomialSystem.ct_isPoseRoot h List.mem_cons_self Pose.ArchimedeanRhombicuboctahedron.len_eq Pose.ArchimedeanRhombicuboctahedron.reps_eq
    (Root.ParData.sqrt_spec (by decide +kernel)) Pose.ArchimedeanRhombicuboctahedron.par_ok Pose.ArchimedeanRhombicuboctahedron.zs_eq Pose.ArchimedeanRhombicuboctahedron.weak_ok Pose.ArchimedeanRhombicuboctahedron.poly_eq Pose.ArchimedeanRhombicuboctahedron.ok

end Nieuwland.Polyhedra
