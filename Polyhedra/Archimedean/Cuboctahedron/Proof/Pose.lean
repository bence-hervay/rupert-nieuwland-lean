/-!
# Pose root of `Archimedean.Cuboctahedron.polyhedron`

ν and one optimal pose of `Archimedean.Cuboctahedron.polyhedron` (`fixtures/nieuwland/archimedean/cuboctahedron`) as the one root of a system, downstream of the representatives' theorem `archimedeanCuboctahedron_nu_reps_list` (a closed form). The weak fit at `ν` is the exact record's over the lift `ℤ[α]` (`rupert-lean-export lift-weak`), checked by the kernel (`weak_check`); the lift's points are the solid's `Dim` points (`points_eq`). The system `S` is `cfSystem` (`Modules/Pose/PoseCheck.lean`): `x 0 = ℓ`, `x 1 = α`, the pose's chart coordinates `x 2, …, x 9`, three helpers, `R₂ = matAt x 13`, `R₁ = matAt x 22`, `t = (x 31, x 32)`. Generated by `lean/scripts/poseroot.py`.
-/

namespace Nieuwland.Pose.ArchimedeanCuboctahedron

open Check PolynomialSystem

/-- The lift's root. -/
def root : Root :=
  ⟨[36, 0, -36, 0, 1], 0, 4,
    1, [36, 0, -36, 0, 1],
    16, 15, 18, 64, 12,
    13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084096,
    13603721107969596754816819526400629342294244676148395158207755454948113876891241560677518911007075718690408328684906686901371619639491067470629903214301098,
    13603721107969596754816819526400629342294244676148395158207755454948113876891241560677518911007075718690408328684906686901371619639491067470629903214301099,
    by decide +kernel⟩

/-- The far field's points as exact values of the lift. -/
def points : List (V3 (ZTheta root)) :=
  liftPts (ZTheta root) Nieuwland.Polyhedra.ArchimedeanCuboctahedronDim.points

theorem points_eq : Polyhedron.ofPoints points = Polyhedron.ofPoints Nieuwland.Polyhedra.ArchimedeanCuboctahedronDim.points :=
  ofPoints_liftPts _ _

/-- The fit, with the hole polygon. -/
def fit : FitData (ZTheta root) :=
  { view := 1
    D := ⟨[1]⟩
    S := ⟨[1]⟩
    T := ⟨[1]⟩
    rot := 0
    q := ⟨⟨[12]⟩,
      ⟨[-72, 72, 2, -2]⟩,
      ⟨[-174, 174, 5, -5]⟩,
      ⟨[-150, 144, 5, -4]⟩⟩
    τ₀ := ⟨[0]⟩
    τ₁ := ⟨[0]⟩
    E := ⟨[1]⟩
    corners := [9, 6, 2, 10, 5, 1] }

/-- The weak fit at the exact scale, with an interior witness. -/
def weak : WeakFitData (ZTheta root) :=
  { fit := fit
    scaleNum := ⟨[0, 1]⟩
    scaleDen := 1
    h₀ := ⟨[0]⟩
    h₁ := ⟨[0]⟩
    H := ⟨[1]⟩ }

theorem weak_check : weak.check points = true := by
  decide +kernel

/-- The representatives' system (`archimedeanCuboctahedron_nu_reps_list`). -/
noncomputable def reps : PolynomialSystem :=
  ⟨[([(36, []), (1, [(0, 4)])],
     [(36, [(0, 2)])])],
   [(202922374470915297771521721661/200000000000000000000000000000, 507305936177288244428804304153/500000000000000000000000000000)]⟩

/-- `α`'s interval: the root's enclosure. -/
def I : ℚ × ℚ := (, )

/-- The intervals of `s, t, q₀, …, q₃, τ₀, τ₁`. -/
def B₁ : List (ℚ × ℚ) := [(1, 1), (1, 1), (12, 12), (510985399/500000000, 10219707981/10000000000), (24672557611/10000000000, 6168139403/2500000000), (-29266211523/10000000000, -14633105761/5000000000), (0, 0), (0, 0)]

/-- The intervals of the pose's twenty variables. -/
def B₃ : List (ℚ × ℚ) := [(0, 0), (-1, 0), (0, 1), (0, 2), (-1, 0), (-1, 0), (0, 1), (0, 1), (0, 1), (-702389076571/10000000000, 87798634569/1250000000), (-1645287967889/10000000000, 341368348357/10000000000), (-35658876517/5000000000, 1915338563213/10000000000), (-171739256997/5000000000, 4255237372579/10000000000), (-109134156341/625000000, 174614650147/1000000000), (-1645287967881/10000000000, 1645287967931/10000000000), (-750436754969/5000000000, 150087350991/1000000000), (-24050981479/1000000000, 624741211199/2500000000), (-10416472593/200000000, 2117792496379/10000000000), (0, 0), (0, 0)]

/-- The quotients of `S₀`'s equations at `ℓ = λ(α)` by `α`'s polynomial. -/
def quot : List RationalPolynomial := [[(1, [])]]

/-- The lift's points to the polyhedron's. -/
def kappa : ℚ := 1

/-- The system (`Polynomials.lean`). -/
noncomputable abbrev S : PolynomialSystem := Archimedean.Cuboctahedron.system

theorem ok : cfOk reps root weak kappa I B₁ B₃ quot = true := by
  decide +kernel

theorem S_eq : S = cfSystem reps root weak kappa I B₁ B₃ := by
  decide +kernel

theorem poly_eq : Archimedean.Cuboctahedron.polyhedron = (Polyhedron.ofPoints points).smul ((kappa : ℚ) : ℝ) := by
  rw [Nieuwland.Polyhedra.ArchimedeanCuboctahedronDim.eq_smul, points_eq]
  congr 1
  norm_num [kappa]

end Nieuwland.Pose.ArchimedeanCuboctahedron

namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Archimedean.Cuboctahedron.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Archimedean.Cuboctahedron.polyhedron` scaled by `N` through itself. -/
theorem archimedeanCuboctahedron_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.ArchimedeanCuboctahedron.reps] N) :
    PolynomialSystem.IsPoseRoot Archimedean.Cuboctahedron.polyhedron Pose.ArchimedeanCuboctahedron.S N 22 13 31 := by
  rw [Pose.ArchimedeanCuboctahedron.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.ArchimedeanCuboctahedron.weak_check Pose.ArchimedeanCuboctahedron.poly_eq Pose.ArchimedeanCuboctahedron.ok

end Nieuwland.Polyhedra
