import Polyhedra.Archimedean.Cuboctahedron.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Archimedean.Cuboctahedron.polyhedron`

`archimedeanCuboctahedron_nu_system_<j>`: the systems of `archimedeanCuboctahedron_exact` (`Nieuwland.Certs.NieuwlandArchimedeanCuboctahedron.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`archimedeanCuboctahedron_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Archimedean.Cuboctahedron.polyhedron` is the largest scale among
those roots (`archimedeanCuboctahedron_nu_roots_list`). `archimedeanCuboctahedron_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `archimedeanCuboctahedron_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`archimedeanCuboctahedron_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandArchimedeanCuboctahedron` and `Nieuwland.Certs.NieuwlandArchimedeanCuboctahedron.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Archimedean.Cuboctahedron.polyhedron`: the equation `ℓ ^ 4 - 36 * ℓ ^ 2 + 36 = 0` with `ℓ` in the interval of the number's decimals (the system of `archimedeanCuboctahedron_exact`). -/
noncomputable def archimedeanCuboctahedron_nu_system_0 : PolynomialSystem :=
  ⟨[([(36, []), (1, [(0, 4)])],
     [(36, [(0, 2)])])],
   [(202922374470915297771521721661/200000000000000000000000000000, 507305936177288244428804304153/500000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Archimedean.Cuboctahedron.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `archimedeanCuboctahedron_nu_roots`. -/
theorem archimedeanCuboctahedron_nu_roots_list :
    PolynomialSystem.IsRootMax [archimedeanCuboctahedron_nu_system_0] Archimedean.Cuboctahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var archimedeanCuboctahedron_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Archimedean.Cuboctahedron.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem archimedeanCuboctahedron_nu_system_0_oneRoot : archimedeanCuboctahedron_nu_system_0.HasUniqueRoot :=
  archimedeanCuboctahedron_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Archimedean.Cuboctahedron.polyhedron`, by roots**: `ν Archimedean.Cuboctahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `archimedeanCuboctahedron_nu_system_<j>`. -/
theorem archimedeanCuboctahedron_nu_roots :
    ν Archimedean.Cuboctahedron.polyhedron ∈ Set.Icc ((1014611872354576488857608608305 : ℝ) / 10 ^ 30) ((1014611872354576488857608608306 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Archimedean.Cuboctahedron.polyhedron) :=
  ⟨archimedeanCuboctahedron_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) archimedeanCuboctahedron_nu_roots_list⟩

end

end Nieuwland.Polyhedra
