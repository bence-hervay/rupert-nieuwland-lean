set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Archimedean.TruncatedTetrahedron.polyhedron`, by representatives**: `ν Archimedean.TruncatedTetrahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `archimedeanTruncatedTetrahedron_nu_reps_list`. -/
theorem archimedeanTruncatedTetrahedron_nu_reps :
    ν Archimedean.TruncatedTetrahedron.polyhedron ∈ Set.Icc ((1014255728416475319117432226624 : ℝ) / 10 ^ 30) ((1014255728416475319117432226625 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Archimedean.TruncatedTetrahedron.polyhedron) :=
  ⟨archimedeanTruncatedTetrahedron_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) archimedeanTruncatedTetrahedron_nu_reps_list⟩

end

