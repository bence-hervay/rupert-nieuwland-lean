/-- **ν and an optimal pose of `Archimedean.TruncatedTetrahedron.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Archimedean.TruncatedTetrahedron.polyhedron` scaled by `N` through itself. -/
theorem archimedeanTruncatedTetrahedron_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.ArchimedeanTruncatedTetrahedron.reps] N) :
    PolynomialSystem.IsPoseRoot Archimedean.TruncatedTetrahedron.polyhedron Pose.ArchimedeanTruncatedTetrahedron.S N 22 13 31 := by
  rw [Pose.ArchimedeanTruncatedTetrahedron.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.ArchimedeanTruncatedTetrahedron.weak_check Pose.ArchimedeanTruncatedTetrahedron.poly_eq Pose.ArchimedeanTruncatedTetrahedron.ok

end Nieuwland.Polyhedra
