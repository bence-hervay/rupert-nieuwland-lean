import Polyhedra.Archimedean.TruncatedTetrahedron.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Archimedean.TruncatedTetrahedron.polyhedron`

`archimedeanTruncatedTetrahedron_nu_system_<j>`: the systems of `archimedeanTruncatedTetrahedron_exact` (`Nieuwland.Certs.NieuwlandArchimedeanTruncatedTetrahedron.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`archimedeanTruncatedTetrahedron_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Archimedean.TruncatedTetrahedron.polyhedron` is the largest scale among
those roots (`archimedeanTruncatedTetrahedron_nu_roots_list`). `archimedeanTruncatedTetrahedron_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `archimedeanTruncatedTetrahedron_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`archimedeanTruncatedTetrahedron_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandArchimedeanTruncatedTetrahedron` and `Nieuwland.Certs.NieuwlandArchimedeanTruncatedTetrahedron.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Archimedean.TruncatedTetrahedron.polyhedron`: the equation `10000 * ℓ ^ 8 - 72600 * ℓ ^ 6 + 64441 * ℓ ^ 4 - 1344 * ℓ ^ 2 + 1024 = 0` with `ℓ` in the interval of the number's decimals (the system of `archimedeanTruncatedTetrahedron_exact`). -/
noncomputable def archimedeanTruncatedTetrahedron_nu_system_0 : PolynomialSystem :=
  ⟨[([(1024, []), (64441, [(0, 4)]), (10000, [(0, 8)])],
     [(1344, [(0, 2)]), (72600, [(0, 6)])])],
   [(15847745756507426861209878541/15625000000000000000000000000, 8114045827331802552939457813/8000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Archimedean.TruncatedTetrahedron.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `archimedeanTruncatedTetrahedron_nu_roots`. -/
theorem archimedeanTruncatedTetrahedron_nu_roots_list :
    PolynomialSystem.IsRootMax [archimedeanTruncatedTetrahedron_nu_system_0] Archimedean.TruncatedTetrahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var archimedeanTruncatedTetrahedron_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Archimedean.TruncatedTetrahedron.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem archimedeanTruncatedTetrahedron_nu_system_0_oneRoot : archimedeanTruncatedTetrahedron_nu_system_0.HasUniqueRoot :=
  archimedeanTruncatedTetrahedron_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Archimedean.TruncatedTetrahedron.polyhedron`, by roots**: `ν Archimedean.TruncatedTetrahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `archimedeanTruncatedTetrahedron_nu_system_<j>`. -/
theorem archimedeanTruncatedTetrahedron_nu_roots :
    ν Archimedean.TruncatedTetrahedron.polyhedron ∈ Set.Icc ((1014255728416475319117432226624 : ℝ) / 10 ^ 30) ((1014255728416475319117432226625 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Archimedean.TruncatedTetrahedron.polyhedron) :=
  ⟨archimedeanTruncatedTetrahedron_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) archimedeanTruncatedTetrahedron_nu_roots_list⟩

end

end Nieuwland.Polyhedra
