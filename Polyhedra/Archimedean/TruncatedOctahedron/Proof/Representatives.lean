/-!
# One shared scale: `ν Archimedean.TruncatedOctahedron.polyhedron`

`archimedeanTruncatedOctahedron_nu_shared_list`: **every system of `archimedeanTruncatedOctahedron_nu_roots_list` has its one root at the scale
`ν Archimedean.TruncatedOctahedron.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `archimedeanTruncatedOctahedron_nu_reps_list`:
the same for the same system, and `archimedeanTruncatedOctahedron_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Archimedean.TruncatedOctahedron.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandArchimedeanTruncatedOctahedron`, `Nieuwland.Certs.NieuwlandArchimedeanTruncatedOctahedron.Exact` and
`Nieuwland.Certs.NieuwlandArchimedeanTruncatedOctahedron.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Archimedean.TruncatedOctahedron.polyhedron` has its one root at `ν Archimedean.TruncatedOctahedron.polyhedron`**: each of the systems of `archimedeanTruncatedOctahedron_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem archimedeanTruncatedOctahedron_nu_shared_list :
    PolynomialSystem.IsRootEq [archimedeanTruncatedOctahedron_nu_system_0] Archimedean.TruncatedOctahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton archimedeanTruncatedOctahedron_nu_roots_list

/-- **The representatives of `ν Archimedean.TruncatedOctahedron.polyhedron`**: the same system, each with exactly one root, at the scale `ν Archimedean.TruncatedOctahedron.polyhedron`. -/
theorem archimedeanTruncatedOctahedron_nu_reps_list :
    PolynomialSystem.IsRootEq [archimedeanTruncatedOctahedron_nu_system_0] Archimedean.TruncatedOctahedron.polyhedron.nieuwland :=
  archimedeanTruncatedOctahedron_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Archimedean.TruncatedOctahedron.polyhedron`, by representatives**: `ν Archimedean.TruncatedOctahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `archimedeanTruncatedOctahedron_nu_reps_list`. -/
theorem archimedeanTruncatedOctahedron_nu_reps :
    ν Archimedean.TruncatedOctahedron.polyhedron ∈ Set.Icc ((1014611872354576488857608608305 : ℝ) / 10 ^ 30) ((1014611872354576488857608608306 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Archimedean.TruncatedOctahedron.polyhedron) :=
  ⟨archimedeanTruncatedOctahedron_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) archimedeanTruncatedOctahedron_nu_reps_list⟩

end

