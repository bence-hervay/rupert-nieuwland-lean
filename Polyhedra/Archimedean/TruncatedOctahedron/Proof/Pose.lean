    τ₁ := ⟨[0]⟩
    E := ⟨[1]⟩
    corners := [15, 11, 23, 7, 18, 2, 12, 8, 20, 4, 17, 1] }

/-- The weak fit at the exact scale, with an interior witness. -/
def weak : WeakFitData (ZTheta root) :=
  { fit := fit
    scaleNum := ⟨[0, 1]⟩
    scaleDen := 1
    h₀ := ⟨[0]⟩
    h₁ := ⟨[0]⟩
    H := ⟨[1]⟩ }

theorem weak_check : weak.check points = true := by
  decide +kernel

/-- The representatives' system (`archimedeanTruncatedOctahedron_nu_reps_list`). -/
noncomputable def reps : PolynomialSystem :=
  ⟨[([(36, []), (1, [(0, 4)])],
     [(36, [(0, 2)])])],
   [(202922374470915297771521721661/200000000000000000000000000000, 507305936177288244428804304153/500000000000000000000000000000)]⟩

/-- `α`'s interval: the root's enclosure. -/
def I : ℚ × ℚ := (, )

/-- The intervals of `s, t, q₀, …, q₃, τ₀, τ₁`. -/
def B₁ : List (ℚ × ℚ) := [(-1767766953/2500000000, -7071067811/10000000000), (-1767766953/2500000000, -7071067811/10000000000), (649997757/312500000, 831997129/400000000), (510985399/500000000, 10219707981/10000000000), (12, 12), (-6168139403/2500000000, -24672557611/10000000000), (0, 0), (0, 0)]

