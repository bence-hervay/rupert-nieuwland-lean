/-- The quotients of `S₀`'s equations at `ℓ = λ(α)` by `α`'s polynomial. -/
def quot : List RationalPolynomial := [[(1, [])]]

/-- The lift's points to the polyhedron's. -/
def kappa : ℚ := 1

/-- The system (`Polynomials.lean`). -/
noncomputable abbrev S : PolynomialSystem := Archimedean.TruncatedOctahedron.system

theorem ok : cfOk reps root weak kappa I B₁ B₃ quot = true := by
  decide +kernel

theorem S_eq : S = cfSystem reps root weak kappa I B₁ B₃ := by
  decide +kernel

theorem poly_eq : Archimedean.TruncatedOctahedron.polyhedron = (Polyhedron.ofPoints points).smul ((kappa : ℚ) : ℝ) := by
  rw [Nieuwland.Polyhedra.ArchimedeanTruncatedOctahedronDim.eq_smul, points_eq]
  congr 1
  norm_num [kappa]

end Nieuwland.Pose.ArchimedeanTruncatedOctahedron

namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Archimedean.TruncatedOctahedron.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Archimedean.TruncatedOctahedron.polyhedron` scaled by `N` through itself. -/
theorem archimedeanTruncatedOctahedron_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.ArchimedeanTruncatedOctahedron.reps] N) :
    PolynomialSystem.IsPoseRoot Archimedean.TruncatedOctahedron.polyhedron Pose.ArchimedeanTruncatedOctahedron.S N 22 13 31 := by
  rw [Pose.ArchimedeanTruncatedOctahedron.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.ArchimedeanTruncatedOctahedron.weak_check Pose.ArchimedeanTruncatedOctahedron.poly_eq Pose.ArchimedeanTruncatedOctahedron.ok

end Nieuwland.Polyhedra
