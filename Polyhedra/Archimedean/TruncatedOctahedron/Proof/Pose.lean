    by decide +kernel⟩

/-- The far field's points as exact values of the lift. -/
def points : List (V3 (ZTheta root)) :=
  liftPts (ZTheta root) Nieuwland.Polyhedra.ArchimedeanTruncatedOctahedronDim.points

theorem points_eq : Polyhedron.ofPoints points = Polyhedron.ofPoints Nieuwland.Polyhedra.ArchimedeanTruncatedOctahedronDim.points :=
  ofPoints_liftPts _ _

/-- The fit, with the hole polygon. -/
def fit : FitData (ZTheta root) :=
  { view := 1
    D := ⟨[24]⟩
    S := ⟨[-18, 0, 1]⟩
    T := ⟨[-18, 0, 1]⟩
    rot := 2
