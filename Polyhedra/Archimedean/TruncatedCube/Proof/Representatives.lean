/-!
# One shared scale: `ν Archimedean.TruncatedCube.polyhedron`

`archimedeanTruncatedCube_nu_shared_list`: **every system of `archimedeanTruncatedCube_nu_roots_list` has its one root at the scale
`ν Archimedean.TruncatedCube.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `archimedeanTruncatedCube_nu_reps_list`:
the same for the same system, and `archimedeanTruncatedCube_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Archimedean.TruncatedCube.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandArchimedeanTruncatedCube`, `Nieuwland.Certs.NieuwlandArchimedeanTruncatedCube.Exact` and
`Nieuwland.Certs.NieuwlandArchimedeanTruncatedCube.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Archimedean.TruncatedCube.polyhedron` has its one root at `ν Archimedean.TruncatedCube.polyhedron`**: each of the systems of `archimedeanTruncatedCube_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem archimedeanTruncatedCube_nu_shared_list :
    PolynomialSystem.IsRootEq [archimedeanTruncatedCube_nu_system_0] Archimedean.TruncatedCube.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton archimedeanTruncatedCube_nu_roots_list

/-- **The representatives of `ν Archimedean.TruncatedCube.polyhedron`**: the same system, each with exactly one root, at the scale `ν Archimedean.TruncatedCube.polyhedron`. -/
theorem archimedeanTruncatedCube_nu_reps_list :
    PolynomialSystem.IsRootEq [archimedeanTruncatedCube_nu_system_0] Archimedean.TruncatedCube.polyhedron.nieuwland :=
  archimedeanTruncatedCube_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Archimedean.TruncatedCube.polyhedron`, by representatives**: `ν Archimedean.TruncatedCube.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `archimedeanTruncatedCube_nu_reps_list`. -/
theorem archimedeanTruncatedCube_nu_reps :
    ν Archimedean.TruncatedCube.polyhedron ∈ Set.Icc ((1030662492707397797492443451309 : ℝ) / 10 ^ 30) ((1030662492707397797492443451310 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Archimedean.TruncatedCube.polyhedron) :=
  ⟨archimedeanTruncatedCube_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) archimedeanTruncatedCube_nu_reps_list⟩

end

