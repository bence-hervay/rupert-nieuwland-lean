import Polyhedra.Archimedean.TruncatedCube.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Archimedean.TruncatedCube.polyhedron`

`archimedeanTruncatedCube_nu_system_<j>`: the systems of `archimedeanTruncatedCube_exact` (`Nieuwland.Certs.NieuwlandArchimedeanTruncatedCube.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`archimedeanTruncatedCube_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Archimedean.TruncatedCube.polyhedron` is the largest scale among
those roots (`archimedeanTruncatedCube_nu_roots_list`). `archimedeanTruncatedCube_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `archimedeanTruncatedCube_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`archimedeanTruncatedCube_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandArchimedeanTruncatedCube` and `Nieuwland.Certs.NieuwlandArchimedeanTruncatedCube.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Archimedean.TruncatedCube.polyhedron`: the equation `4 * ℓ ^ 4 - 16 * ℓ ^ 3 + 4 * ℓ ^ 2 - 8 * ℓ + 17 = 0` with `ℓ` in the interval of the number's decimals (the system of `archimedeanTruncatedCube_exact`). -/
noncomputable def archimedeanTruncatedCube_nu_system_0 : PolynomialSystem :=
  ⟨[([(17, []), (4, [(0, 2)]), (4, [(0, 4)])],
     [(8, [(0, 1)]), (16, [(0, 3)])])],
   [(1030662492707397797492443451309/1000000000000000000000000000000, 103066249270739779749244345131/100000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Archimedean.TruncatedCube.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `archimedeanTruncatedCube_nu_roots`. -/
theorem archimedeanTruncatedCube_nu_roots_list :
    PolynomialSystem.IsRootMax [archimedeanTruncatedCube_nu_system_0] Archimedean.TruncatedCube.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var archimedeanTruncatedCube_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Archimedean.TruncatedCube.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem archimedeanTruncatedCube_nu_system_0_oneRoot : archimedeanTruncatedCube_nu_system_0.HasUniqueRoot :=
  archimedeanTruncatedCube_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Archimedean.TruncatedCube.polyhedron`, by roots**: `ν Archimedean.TruncatedCube.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `archimedeanTruncatedCube_nu_system_<j>`. -/
theorem archimedeanTruncatedCube_nu_roots :
    ν Archimedean.TruncatedCube.polyhedron ∈ Set.Icc ((1030662492707397797492443451309 : ℝ) / 10 ^ 30) ((1030662492707397797492443451310 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Archimedean.TruncatedCube.polyhedron) :=
  ⟨archimedeanTruncatedCube_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) archimedeanTruncatedCube_nu_roots_list⟩

end

end Nieuwland.Polyhedra
