namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Archimedean.TruncatedCube.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Archimedean.TruncatedCube.polyhedron` scaled by `N` through itself. -/
theorem archimedeanTruncatedCube_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.ArchimedeanTruncatedCube.reps] N) :
    PolynomialSystem.IsPoseRoot Archimedean.TruncatedCube.polyhedron Pose.ArchimedeanTruncatedCube.S N 22 13 31 := by
  rw [Pose.ArchimedeanTruncatedCube.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.ArchimedeanTruncatedCube.weak_check Pose.ArchimedeanTruncatedCube.poly_eq Pose.ArchimedeanTruncatedCube.ok

end Nieuwland.Polyhedra
