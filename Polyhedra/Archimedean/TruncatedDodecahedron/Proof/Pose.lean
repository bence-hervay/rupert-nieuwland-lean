  decide +kernel

theorem reps_eq : reps0 = touch.explicitB Nieuwland.Polyhedra.ArchimedeanTruncatedDodecahedronDim.points F vb := by
  decide +kernel

theorem ok : ctOk reps0 touch kappa B = true := by
  decide +kernel

