theorem poly_eq : Archimedean.TruncatedDodecahedron.polyhedron = (Polyhedron.ofPoints Nieuwland.Polyhedra.ArchimedeanTruncatedDodecahedronDim.points).smul ((kappa : ℚ) : ℝ) := by
  rw [Nieuwland.Polyhedra.ArchimedeanTruncatedDodecahedronDim.eq_smul]
  congr 1
  norm_num [kappa]

