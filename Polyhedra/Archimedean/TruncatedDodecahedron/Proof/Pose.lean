/-- **ν and an optimal pose of `Archimedean.TruncatedDodecahedron.polyhedron` as one root**: when the representatives' systems have
exactly one root each, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it
`matAt x 47`, `matAt x 38` and `(x 56, x 57)` are a weak fit of `Archimedean.TruncatedDodecahedron.polyhedron` scaled
by `N` through itself. -/
theorem archimedeanTruncatedDodecahedron_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.ArchimedeanTruncatedDodecahedron.reps0] N) :
    PolynomialSystem.IsPoseRoot Archimedean.TruncatedDodecahedron.polyhedron Pose.ArchimedeanTruncatedDodecahedron.S N 47 38 56 := by
  rw [Pose.ArchimedeanTruncatedDodecahedron.S_eq]
  exact PolynomialSystem.ct_isPoseRoot h List.mem_cons_self Pose.ArchimedeanTruncatedDodecahedron.len_eq Pose.ArchimedeanTruncatedDodecahedron.reps_eq
    (Root.ParData.sqrt_spec (by decide +kernel)) Pose.ArchimedeanTruncatedDodecahedron.par_ok Pose.ArchimedeanTruncatedDodecahedron.zs_eq Pose.ArchimedeanTruncatedDodecahedron.weak_ok Pose.ArchimedeanTruncatedDodecahedron.poly_eq Pose.ArchimedeanTruncatedDodecahedron.ok

end Nieuwland.Polyhedra
