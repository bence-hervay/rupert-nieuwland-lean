def B : List (ℚ × ℚ) := [(0, 1), (0, 0), (0, 625908217/1250000000), (-147633691/5000000000, 0), (0, 2501454203/2000000000), (0, 294838937/5000000000), (-625908217/1250000000, 0), (-294838937/5000000000, 0), (0, 1), (-626217287/10000000000, 12725089837/10000000000), (-1454947421/10000000000, 1084957413/5000000000), (-5228234257/10000000000, 5219022309/10000000000), (-1939619307/10000000000, 596147283/5000000000), (-137091831/2500000000, 6627756869/5000000000), (-5246277/1000000000, 4764680677/10000000000), (-1030867703/2000000000, 5411532921/10000000000), (-1134242387/2500000000, 331305839/10000000000), (-107967961/1000000000, 12461621899/10000000000), (0, 0), (0, 0)]

/-- The system (`Polynomials.lean`). -/
noncomputable abbrev S : PolynomialSystem := Archimedean.TruncatedDodecahedron.system

theorem par_ok : Root.RootBasis.parCheck (ZSqrt 5) touch.par = true := by
  decide +kernel

/-- The contacts of the record's duplicates and coincidences, whose identities check on the balls of the box (compiled evaluation: the identities' polynomials are expanded by well-founded recursion, which the kernel does not evaluate). -/
def zs : List (ℕ × ℕ × ℕ) := [(52, 28, 28), (52, 28, 52), (10, 33, 32), (25, 27, 6)]

theorem zs_eq : Root.Sys.zeroCons (ZSqrt 5) (touch.sys Nieuwland.Polyhedra.ArchimedeanTruncatedDodecahedronDim.points) (touch.kraw Nieuwland.Polyhedra.ArchimedeanTruncatedDodecahedronDim.points).boxBalls touch.W = zs := by
  native_decide

