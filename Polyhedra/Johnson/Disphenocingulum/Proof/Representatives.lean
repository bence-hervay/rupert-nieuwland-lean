set_option maxHeartbeats 0 in
/-- **Every system of `ν Johnson.Disphenocingulum.polyhedron` has its one root at `ν Johnson.Disphenocingulum.polyhedron`**: each of the systems of `johnsonDisphenocingulum_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem johnsonDisphenocingulum_nu_shared_list :
    PolynomialSystem.IsRootEq [johnsonDisphenocingulum_nu_system_0] Johnson.Disphenocingulum.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton johnsonDisphenocingulum_nu_roots_list

/-- **The representatives of `ν Johnson.Disphenocingulum.polyhedron`**: the same system, each with exactly one root, at the scale `ν Johnson.Disphenocingulum.polyhedron`. -/
theorem johnsonDisphenocingulum_nu_reps_list :
    PolynomialSystem.IsRootEq [johnsonDisphenocingulum_nu_system_0] Johnson.Disphenocingulum.polyhedron.nieuwland :=
  johnsonDisphenocingulum_nu_shared_list

