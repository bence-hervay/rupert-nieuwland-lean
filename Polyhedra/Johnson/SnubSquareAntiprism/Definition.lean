/-!
# The snub square antiprism

The polyhedron `Johnson.SnubSquareAntiprism.polyhedron`: the convex hull of 16 points,
with coordinates in `ℚ(θ)` (`polyEval c θ` is `∑ cᵢ θⁱ`).
-/

namespace Nieuwland.Johnson.SnubSquareAntiprism

/-- `θ`: the largest root of
`-1/8192 - 7/512 * x ^ 2 + 11/16 * x ^ 4 - 187/32 * x ^ 6 + 355/32 * x ^ 8 + 9 * x ^ 10 + x ^ 12`
in the interval `(0, 3/8)` (`realRoot`, `Definitions/Polynomials.lean`). -/
noncomputable def theta : ℝ :=
  realRoot [-1/8192, 0, -7/512, 0, 11/16, 0, -187/32, 0, 355/32, 0, 9, 0, 1] 0 (3/8)

@[inherit_doc] local notation "θ" => theta

open Classical in
