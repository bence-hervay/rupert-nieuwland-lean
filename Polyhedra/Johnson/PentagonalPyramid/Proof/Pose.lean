theorem lift_ok : liftOk (ZTheta.embed (R := Nieuwland.Polyhedra.JohnsonPentagonalPyramidDim.root) 2 alphaF) 1 1 Nieuwland.Polyhedra.JohnsonPentagonalPyramidDim.points points = true := by
  decide +kernel

theorem points_eq : Polyhedron.ofPoints points = (Polyhedron.ofPoints Nieuwland.Polyhedra.JohnsonPentagonalPyramidDim.points).smul (((1 : ℕ) : ℝ) * ((2 : ℕ) : ℝ) ^ 3 / ((1 : ℕ) : ℝ)) :=
  ofPoints_of_liftOk (ZTheta.re_embed alpha_ok (k := 3) rfl) lift_ok

