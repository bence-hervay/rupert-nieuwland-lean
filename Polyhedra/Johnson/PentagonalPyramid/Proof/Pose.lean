namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Johnson.PentagonalPyramid.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Johnson.PentagonalPyramid.polyhedron` scaled by `N` through itself. -/
theorem johnsonPentagonalPyramid_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.JohnsonPentagonalPyramid.reps] N) :
    PolynomialSystem.IsPoseRoot Johnson.PentagonalPyramid.polyhedron Pose.JohnsonPentagonalPyramid.S N 22 13 31 := by
  rw [Pose.JohnsonPentagonalPyramid.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.JohnsonPentagonalPyramid.weak_check Pose.JohnsonPentagonalPyramid.poly_eq Pose.JohnsonPentagonalPyramid.ok

end Nieuwland.Polyhedra
