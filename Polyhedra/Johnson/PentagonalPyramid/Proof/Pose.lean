theorem alpha_ok : thetaOk Nieuwland.Polyhedra.JohnsonPentagonalPyramidDim.root 2 alphaF = true := by
  decide +kernel

/-- The points of the solid as exact values of the lift, times 400. -/
def points : List (V3 (ZTheta root)) :=
