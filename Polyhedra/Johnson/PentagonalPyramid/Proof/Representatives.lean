import Polyhedra.Johnson.PentagonalPyramid.Proof.Roots
import Modules.Root.Reps

set_option linter.style.longLine false

/-!
# One shared scale: `ν Johnson.PentagonalPyramid.polyhedron`

`johnsonPentagonalPyramid_nu_shared_list`: **every system of `johnsonPentagonalPyramid_nu_roots_list` has its one root at the scale
`ν Johnson.PentagonalPyramid.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `johnsonPentagonalPyramid_nu_reps_list`:
the same for the same system, and `johnsonPentagonalPyramid_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Johnson.PentagonalPyramid.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonPentagonalPyramid`, `Nieuwland.Certs.NieuwlandJohnsonPentagonalPyramid.Exact` and
`Nieuwland.Certs.NieuwlandJohnsonPentagonalPyramid.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Johnson.PentagonalPyramid.polyhedron` has its one root at `ν Johnson.PentagonalPyramid.polyhedron`**: each of the systems of `johnsonPentagonalPyramid_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem johnsonPentagonalPyramid_nu_shared_list :
    PolynomialSystem.IsRootEq [johnsonPentagonalPyramid_nu_system_0] Johnson.PentagonalPyramid.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton johnsonPentagonalPyramid_nu_roots_list

/-- **The representatives of `ν Johnson.PentagonalPyramid.polyhedron`**: the same system, each with exactly one root, at the scale `ν Johnson.PentagonalPyramid.polyhedron`. -/
theorem johnsonPentagonalPyramid_nu_reps_list :
    PolynomialSystem.IsRootEq [johnsonPentagonalPyramid_nu_system_0] Johnson.PentagonalPyramid.polyhedron.nieuwland :=
  johnsonPentagonalPyramid_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.PentagonalPyramid.polyhedron`, by representatives**: `ν Johnson.PentagonalPyramid.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `johnsonPentagonalPyramid_nu_reps_list`. -/
theorem johnsonPentagonalPyramid_nu_reps :
    ν Johnson.PentagonalPyramid.polyhedron ∈ Set.Icc ((1051462224238267212051338169695 : ℝ) / 10 ^ 30) ((1051462224238267212051338169696 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Johnson.PentagonalPyramid.polyhedron) :=
  ⟨johnsonPentagonalPyramid_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) johnsonPentagonalPyramid_nu_reps_list⟩

end

end Nieuwland.Polyhedra
