theorem poly_eq : Johnson.ParabidiminishedRhombicosidodecahedron.polyhedron = (Polyhedron.ofPoints points).smul ((kappa : ℚ) : ℝ) := by
  rw [Nieuwland.Polyhedra.JohnsonParabidiminishedRhombicosidodecahedronDim.eq_smul, points_eq, Polyhedron.smul_smul_eq]
  congr 1
  norm_num [kappa]

end Nieuwland.Pose.JohnsonParabidiminishedRhombicosidodecahedron

namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Johnson.ParabidiminishedRhombicosidodecahedron.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Johnson.ParabidiminishedRhombicosidodecahedron.polyhedron` scaled by `N` through itself. -/
theorem johnsonParabidiminishedRhombicosidodecahedron_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.JohnsonParabidiminishedRhombicosidodecahedron.reps] N) :
    PolynomialSystem.IsPoseRoot Johnson.ParabidiminishedRhombicosidodecahedron.polyhedron Pose.JohnsonParabidiminishedRhombicosidodecahedron.S N 22 13 31 := by
  rw [Pose.JohnsonParabidiminishedRhombicosidodecahedron.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.JohnsonParabidiminishedRhombicosidodecahedron.weak_check Pose.JohnsonParabidiminishedRhombicosidodecahedron.poly_eq Pose.JohnsonParabidiminishedRhombicosidodecahedron.ok

end Nieuwland.Polyhedra
