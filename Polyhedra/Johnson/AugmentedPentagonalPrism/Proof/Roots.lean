import Polyhedra.Johnson.AugmentedPentagonalPrism.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Johnson.AugmentedPentagonalPrism.polyhedron`

`johnsonAugmentedPentagonalPrism_nu_system_<j>`: the systems of `johnsonAugmentedPentagonalPrism_exact` (`Nieuwland.Certs.NieuwlandJohnsonAugmentedPentagonalPrism.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`johnsonAugmentedPentagonalPrism_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Johnson.AugmentedPentagonalPrism.polyhedron` is the largest scale among
those roots (`johnsonAugmentedPentagonalPrism_nu_roots_list`). `johnsonAugmentedPentagonalPrism_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `johnsonAugmentedPentagonalPrism_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`johnsonAugmentedPentagonalPrism_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonAugmentedPentagonalPrism` and `Nieuwland.Certs.NieuwlandJohnsonAugmentedPentagonalPrism.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Johnson.AugmentedPentagonalPrism.polyhedron`: the equation `61 * ℓ ^ 4 - 140 * ℓ ^ 2 + 80 = 0` with `ℓ` in the interval of the number's decimals (the system of `johnsonAugmentedPentagonalPrism_exact`). -/
noncomputable def johnsonAugmentedPentagonalPrism_nu_system_0 : PolynomialSystem :=
  ⟨[([(80, []), (61, [(0, 4)])],
     [(140, [(0, 2)])])],
   [(1036449361727931406321035110919/1000000000000000000000000000000, 25911234043198285158025877773/25000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Johnson.AugmentedPentagonalPrism.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `johnsonAugmentedPentagonalPrism_nu_roots`. -/
theorem johnsonAugmentedPentagonalPrism_nu_roots_list :
    PolynomialSystem.IsRootMax [johnsonAugmentedPentagonalPrism_nu_system_0] Johnson.AugmentedPentagonalPrism.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var johnsonAugmentedPentagonalPrism_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Johnson.AugmentedPentagonalPrism.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem johnsonAugmentedPentagonalPrism_nu_system_0_oneRoot : johnsonAugmentedPentagonalPrism_nu_system_0.HasUniqueRoot :=
  johnsonAugmentedPentagonalPrism_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.AugmentedPentagonalPrism.polyhedron`, by roots**: `ν Johnson.AugmentedPentagonalPrism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `johnsonAugmentedPentagonalPrism_nu_system_<j>`. -/
theorem johnsonAugmentedPentagonalPrism_nu_roots :
    ν Johnson.AugmentedPentagonalPrism.polyhedron ∈ Set.Icc ((1036449361727931406321035110919 : ℝ) / 10 ^ 30) ((1036449361727931406321035110920 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Johnson.AugmentedPentagonalPrism.polyhedron) :=
  ⟨johnsonAugmentedPentagonalPrism_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) johnsonAugmentedPentagonalPrism_nu_roots_list⟩

end

end Nieuwland.Polyhedra
