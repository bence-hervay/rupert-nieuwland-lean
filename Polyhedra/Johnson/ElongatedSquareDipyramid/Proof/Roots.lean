set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Johnson.ElongatedSquareDipyramid.polyhedron`

`johnsonElongatedSquareDipyramid_nu_system_<j>`: the systems of `johnsonElongatedSquareDipyramid_exact` (`Nieuwland.Certs.NieuwlandJohnsonElongatedSquareDipyramid.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`johnsonElongatedSquareDipyramid_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Johnson.ElongatedSquareDipyramid.polyhedron` is the largest scale among
those roots (`johnsonElongatedSquareDipyramid_nu_roots_list`). `johnsonElongatedSquareDipyramid_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `johnsonElongatedSquareDipyramid_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`johnsonElongatedSquareDipyramid_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonElongatedSquareDipyramid` and `Nieuwland.Certs.NieuwlandJohnsonElongatedSquareDipyramid.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Johnson.ElongatedSquareDipyramid.polyhedron`: the equation `2 * ℓ ^ 2 - 3 = 0` with `ℓ` in the interval of the number's decimals (the system of `johnsonElongatedSquareDipyramid_exact`). -/
noncomputable def johnsonElongatedSquareDipyramid_nu_system_0 : PolynomialSystem :=
  ⟨[([(2, [(0, 2)])],
     [(3, [])])],
   [(153093108923948631137330254669/125000000000000000000000000000, 1224744871391589049098642037353/1000000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Johnson.ElongatedSquareDipyramid.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `johnsonElongatedSquareDipyramid_nu_roots`. -/
theorem johnsonElongatedSquareDipyramid_nu_roots_list :
    PolynomialSystem.IsRootMax [johnsonElongatedSquareDipyramid_nu_system_0] Johnson.ElongatedSquareDipyramid.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var johnsonElongatedSquareDipyramid_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Johnson.ElongatedSquareDipyramid.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem johnsonElongatedSquareDipyramid_nu_system_0_oneRoot : johnsonElongatedSquareDipyramid_nu_system_0.HasUniqueRoot :=
  johnsonElongatedSquareDipyramid_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.ElongatedSquareDipyramid.polyhedron`, by roots**: `ν Johnson.ElongatedSquareDipyramid.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `johnsonElongatedSquareDipyramid_nu_system_<j>`. -/
theorem johnsonElongatedSquareDipyramid_nu_roots :
    ν Johnson.ElongatedSquareDipyramid.polyhedron ∈ Set.Icc ((1224744871391589049098642037352 : ℝ) / 10 ^ 30) ((1224744871391589049098642037353 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Johnson.ElongatedSquareDipyramid.polyhedron) :=
  ⟨johnsonElongatedSquareDipyramid_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) johnsonElongatedSquareDipyramid_nu_roots_list⟩

end

end Nieuwland.Polyhedra
