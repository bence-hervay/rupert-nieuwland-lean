import Polyhedra.Johnson.PentagonalCupola.Proof.Roots
import Modules.Root.Reps

set_option linter.style.longLine false

/-!
# One shared scale: `ν Johnson.PentagonalCupola.polyhedron`

`johnsonPentagonalCupola_nu_shared_list`: **every system of `johnsonPentagonalCupola_nu_roots_list` has its one root at the scale
`ν Johnson.PentagonalCupola.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `johnsonPentagonalCupola_nu_reps_list`:
the same for the same system, and `johnsonPentagonalCupola_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Johnson.PentagonalCupola.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonPentagonalCupola`, `Nieuwland.Certs.NieuwlandJohnsonPentagonalCupola.Exact` and
`Nieuwland.Certs.NieuwlandJohnsonPentagonalCupola.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Johnson.PentagonalCupola.polyhedron` has its one root at `ν Johnson.PentagonalCupola.polyhedron`**: each of the systems of `johnsonPentagonalCupola_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem johnsonPentagonalCupola_nu_shared_list :
    PolynomialSystem.IsRootEq [johnsonPentagonalCupola_nu_system_0] Johnson.PentagonalCupola.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton johnsonPentagonalCupola_nu_roots_list

/-- **The representatives of `ν Johnson.PentagonalCupola.polyhedron`**: the same system, each with exactly one root, at the scale `ν Johnson.PentagonalCupola.polyhedron`. -/
theorem johnsonPentagonalCupola_nu_reps_list :
    PolynomialSystem.IsRootEq [johnsonPentagonalCupola_nu_system_0] Johnson.PentagonalCupola.polyhedron.nieuwland :=
  johnsonPentagonalCupola_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.PentagonalCupola.polyhedron`, by representatives**: `ν Johnson.PentagonalCupola.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `johnsonPentagonalCupola_nu_reps_list`. -/
theorem johnsonPentagonalCupola_nu_reps :
    ν Johnson.PentagonalCupola.polyhedron ∈ Set.Icc ((1051462224238267212051338169695 : ℝ) / 10 ^ 30) ((1051462224238267212051338169696 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Johnson.PentagonalCupola.polyhedron) :=
  ⟨johnsonPentagonalCupola_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) johnsonPentagonalCupola_nu_reps_list⟩

end

end Nieuwland.Polyhedra
