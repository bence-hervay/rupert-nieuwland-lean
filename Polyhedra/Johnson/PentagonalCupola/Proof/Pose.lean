namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Johnson.PentagonalCupola.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Johnson.PentagonalCupola.polyhedron` scaled by `N` through itself. -/
theorem johnsonPentagonalCupola_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.JohnsonPentagonalCupola.reps] N) :
    PolynomialSystem.IsPoseRoot Johnson.PentagonalCupola.polyhedron Pose.JohnsonPentagonalCupola.S N 22 13 31 := by
  rw [Pose.JohnsonPentagonalCupola.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.JohnsonPentagonalCupola.weak_check Pose.JohnsonPentagonalCupola.poly_eq Pose.JohnsonPentagonalCupola.ok

end Nieuwland.Polyhedra
