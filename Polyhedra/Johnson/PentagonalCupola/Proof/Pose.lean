theorem points_eq : Polyhedron.ofPoints points = (Polyhedron.ofPoints Nieuwland.Polyhedra.JohnsonPentagonalCupolaDim.points).smul (((1 : ℕ) : ℝ) * ((10 : ℕ) : ℝ) / ((1 : ℕ) : ℝ)) :=
