/-- **The Nieuwland number of `Johnson.Bilunabirotunda.polyhedron`, by representatives**: `ν Johnson.Bilunabirotunda.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `johnsonBilunabirotunda_nu_reps_list`. -/
theorem johnsonBilunabirotunda_nu_reps :
    ν Johnson.Bilunabirotunda.polyhedron ∈ Set.Icc ((1203409213649296372438348659060 : ℝ) / 10 ^ 30) ((1203409213649296372438348659061 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Johnson.Bilunabirotunda.polyhedron) :=
  ⟨johnsonBilunabirotunda_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) johnsonBilunabirotunda_nu_reps_list⟩

end

