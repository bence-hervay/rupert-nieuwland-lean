import Polyhedra.Johnson.Sphenocorona.Proof.Roots
import Modules.Root.Reps

set_option linter.style.longLine false

/-!
# One shared scale: `ν Johnson.Sphenocorona.polyhedron`

`johnsonSphenocorona_nu_shared_list`: **every system of `johnsonSphenocorona_nu_roots_list` has its one root at the scale
`ν Johnson.Sphenocorona.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): links from root 0 reach each of the roots 0, 1. `johnsonSphenocorona_nu_reps_list`:
the same for the system of root 0 alone (one picture class: the roots {0, 1}), and `johnsonSphenocorona_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Johnson.Sphenocorona.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). The roots' scales are shown equal by links (`Root.linkGroupsOk`, evaluated by compiled code in `Nieuwland.Certs.NieuwlandJohnsonSphenocorona.links_ok`): isometries of the solid that take one root's contacts onto another's give a pose map taking the first root's zero to a zero of the other's system inside the other's Krawczyk box, where its zero is unique (`Root.scale_eq_of_linksOk`, `Modules/Root/LinkCheck.lean`; `Root.isRootEq_of_links`, `Modules/Root/Reps.lean`). The representatives are the first root of each class of roots whose pictures (the hole's silhouette and the placed plug's) are congruent: a fact of the data measured in floating point (`lean/scripts/links.py`), not a theorem; the links show the scales equal either way.
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonSphenocorona`, `Nieuwland.Certs.NieuwlandJohnsonSphenocorona.Exact` and
`Nieuwland.Certs.NieuwlandJohnsonSphenocorona.Roots`, which it does not change.
-/

namespace Nieuwland.Certs.NieuwlandJohnsonSphenocorona

open Nieuwland

/-- The link from root 0 to root 1 (`Root.LinkRec`): per contact its image, the flips, the antipodes, and the frames of the hole's and the plug's isometries. -/
def link_0_1 : Root.LinkRec :=
  ⟨[0, 1, 2, 3, 4, 5], [false, false, false, false, false, false], [false, false, false, false, false, false], [(0, 0), (1, 1), (2, 2), (8, 8)], 0, [(4, 4), (5, 5), (6, 7), (7, 6)], 0⟩

/-- **The links' checks** (`Root.linkGroupsOk`, `Modules/Root/Reps.lean`): each link's isometries and contacts, and the image of its source root's zero inside its target's box; compiled code evaluates it, and `links_ok` rests on the axiom that `native_decide` records for it. -/
theorem links_ok :
    Root.linkGroupsOk points [touch0, touch1] touch0 [0]
      [(0, [(1, link_0_1)])] = true := by
  native_decide

end Nieuwland.Certs.NieuwlandJohnsonSphenocorona

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Johnson.Sphenocorona.polyhedron` has its one root at `ν Johnson.Sphenocorona.polyhedron`**: each of the systems of `johnsonSphenocorona_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem johnsonSphenocorona_nu_shared_list :
    PolynomialSystem.IsRootEq [johnsonSphenocorona_nu_system_0, johnsonSphenocorona_nu_system_1] Johnson.Sphenocorona.polyhedron.nieuwland :=
  Root.isRootEq_of_links (F := (Root.ParData.theta Nieuwland.Certs.NieuwlandJohnsonSphenocorona.root)) (Root.ParData.theta_spec Nieuwland.Certs.NieuwlandJohnsonSphenocorona.root)
    (Root.ParData.theta_unique Nieuwland.Certs.NieuwlandJohnsonSphenocorona.root) (by decide)
    (fun _ h ↦ Root.ok_of_certOk Nieuwland.Certs.NieuwlandJohnsonSphenocorona.touch_ok h) johnsonSphenocorona_nu_roots_list [0, 1]
    (.cons johnsonSphenocorona_nu_system_0_of (.cons johnsonSphenocorona_nu_system_1_of .nil))
    _ Nieuwland.Certs.NieuwlandJohnsonSphenocorona.links_ok (by decide) (by simp) (fun _ h ↦ h)

/-- **The representatives of `ν Johnson.Sphenocorona.polyhedron`**: the system of root 0 alone (one picture class: the roots {0, 1}), each with exactly one root, at the scale `ν Johnson.Sphenocorona.polyhedron`. -/
theorem johnsonSphenocorona_nu_reps_list :
    PolynomialSystem.IsRootEq [johnsonSphenocorona_nu_system_0] Johnson.Sphenocorona.polyhedron.nieuwland :=
  johnsonSphenocorona_nu_shared_list.sub (by simp) (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.Sphenocorona.polyhedron`, by representatives**: `ν Johnson.Sphenocorona.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `johnsonSphenocorona_nu_reps_list`. -/
theorem johnsonSphenocorona_nu_reps :
    ν Johnson.Sphenocorona.polyhedron ∈ Set.Icc ((1080318725757473443217512546021 : ℝ) / 10 ^ 30) ((1080318725757473443217512546022 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Johnson.Sphenocorona.polyhedron) :=
  ⟨johnsonSphenocorona_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) johnsonSphenocorona_nu_reps_list⟩

end

end Nieuwland.Polyhedra
