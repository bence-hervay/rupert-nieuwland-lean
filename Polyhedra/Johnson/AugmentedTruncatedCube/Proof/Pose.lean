theorem par_ok : Root.RootBasis.parCheck (ZSqrt 2) touch.par = true := by
  decide +kernel

/-- The contacts of the record's duplicates and coincidences, whose identities check on the balls of the box (compiled evaluation: the identities' polynomials are expanded by well-founded recursion, which the kernel does not evaluate). -/
def zs : List (ℕ × ℕ × ℕ) := [(5, 13, 12), (13, 12, 13), (16, 26, 8)]

theorem zs_eq : Root.Sys.zeroCons (ZSqrt 2) (touch.sys Nieuwland.Polyhedra.JohnsonAugmentedTruncatedCubeDim.points) (touch.kraw Nieuwland.Polyhedra.JohnsonAugmentedTruncatedCubeDim.points).boxBalls touch.W = zs := by
