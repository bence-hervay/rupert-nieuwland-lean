set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.Gyrobifastigium.polyhedron`, by representatives**: `ν Johnson.Gyrobifastigium.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `johnsonGyrobifastigium_nu_reps_list`. -/
theorem johnsonGyrobifastigium_nu_reps :
    ν Johnson.Gyrobifastigium.polyhedron ∈ Set.Icc ((1044017198851747025849862724799 : ℝ) / 10 ^ 30) ((1044017198851747025849862724800 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Johnson.Gyrobifastigium.polyhedron) :=
  ⟨johnsonGyrobifastigium_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) johnsonGyrobifastigium_nu_reps_list⟩

end

