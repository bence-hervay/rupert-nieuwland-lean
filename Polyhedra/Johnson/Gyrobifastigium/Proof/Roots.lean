import Polyhedra.Johnson.Gyrobifastigium.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Johnson.Gyrobifastigium.polyhedron`

`johnsonGyrobifastigium_nu_system_<j>`: the systems of `johnsonGyrobifastigium_exact` (`Nieuwland.Certs.NieuwlandJohnsonGyrobifastigium.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`johnsonGyrobifastigium_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Johnson.Gyrobifastigium.polyhedron` is the largest scale among
those roots (`johnsonGyrobifastigium_nu_roots_list`). `johnsonGyrobifastigium_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `johnsonGyrobifastigium_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`johnsonGyrobifastigium_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonGyrobifastigium` and `Nieuwland.Certs.NieuwlandJohnsonGyrobifastigium.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Johnson.Gyrobifastigium.polyhedron`: the equation `31 * ℓ ^ 4 - 40 * ℓ ^ 3 - 8 * ℓ ^ 2 + 32 * ℓ - 16 = 0` with `ℓ` in the interval of the number's decimals (the system of `johnsonGyrobifastigium_exact`). -/
noncomputable def johnsonGyrobifastigium_nu_system_0 : PolynomialSystem :=
  ⟨[([(32, [(0, 1)]), (31, [(0, 4)])],
     [(16, []), (8, [(0, 2)]), (40, [(0, 3)])])],
   [(1044017198851747025849862724799/1000000000000000000000000000000, 652510749282341891156164203/625000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Johnson.Gyrobifastigium.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `johnsonGyrobifastigium_nu_roots`. -/
theorem johnsonGyrobifastigium_nu_roots_list :
    PolynomialSystem.IsRootMax [johnsonGyrobifastigium_nu_system_0] Johnson.Gyrobifastigium.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var johnsonGyrobifastigium_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Johnson.Gyrobifastigium.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem johnsonGyrobifastigium_nu_system_0_oneRoot : johnsonGyrobifastigium_nu_system_0.HasUniqueRoot :=
  johnsonGyrobifastigium_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.Gyrobifastigium.polyhedron`, by roots**: `ν Johnson.Gyrobifastigium.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `johnsonGyrobifastigium_nu_system_<j>`. -/
theorem johnsonGyrobifastigium_nu_roots :
    ν Johnson.Gyrobifastigium.polyhedron ∈ Set.Icc ((1044017198851747025849862724799 : ℝ) / 10 ^ 30) ((1044017198851747025849862724800 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Johnson.Gyrobifastigium.polyhedron) :=
  ⟨johnsonGyrobifastigium_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) johnsonGyrobifastigium_nu_roots_list⟩

end

end Nieuwland.Polyhedra
