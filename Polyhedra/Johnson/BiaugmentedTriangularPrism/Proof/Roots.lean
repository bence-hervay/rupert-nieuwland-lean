noncomputable def johnsonBiaugmentedTriangularPrism_nu_system_0 : PolynomialSystem :=
  ⟨[([(15570769, []), (14183776, [(0, 4)]), (57600, [(0, 8)])],
     [(26171344, [(0, 2)]), (2622720, [(0, 6)])])],
   [(281162918448269956392369661381/250000000000000000000000000000, 44986066951723193022779145821/40000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Johnson.BiaugmentedTriangularPrism.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `johnsonBiaugmentedTriangularPrism_nu_roots`. -/
theorem johnsonBiaugmentedTriangularPrism_nu_roots_list :
    PolynomialSystem.IsRootMax [johnsonBiaugmentedTriangularPrism_nu_system_0] Johnson.BiaugmentedTriangularPrism.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var johnsonBiaugmentedTriangularPrism_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Johnson.BiaugmentedTriangularPrism.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem johnsonBiaugmentedTriangularPrism_nu_system_0_oneRoot : johnsonBiaugmentedTriangularPrism_nu_system_0.HasUniqueRoot :=
  johnsonBiaugmentedTriangularPrism_nu_roots_list.2 _ (by simp)

