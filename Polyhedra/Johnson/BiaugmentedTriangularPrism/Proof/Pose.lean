theorem johnsonBiaugmentedTriangularPrism_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.JohnsonBiaugmentedTriangularPrism.reps] N) :
    PolynomialSystem.IsPoseRoot Johnson.BiaugmentedTriangularPrism.polyhedron Pose.JohnsonBiaugmentedTriangularPrism.S N 22 13 31 := by
