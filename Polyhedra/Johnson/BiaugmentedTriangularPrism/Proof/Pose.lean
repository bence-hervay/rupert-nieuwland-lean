  exact PolynomialSystem.cf_isPoseRoot h Pose.JohnsonBiaugmentedTriangularPrism.weak_check Pose.JohnsonBiaugmentedTriangularPrism.poly_eq Pose.JohnsonBiaugmentedTriangularPrism.ok

