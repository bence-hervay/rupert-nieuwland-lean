import Polyhedra.Johnson.PentagonalRotunda.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Johnson.PentagonalRotunda.polyhedron`

`johnsonPentagonalRotunda_nu_system_<j>`: the systems of `johnsonPentagonalRotunda_exact` (`Nieuwland.Certs.NieuwlandJohnsonPentagonalRotunda.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`johnsonPentagonalRotunda_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Johnson.PentagonalRotunda.polyhedron` is the largest scale among
those roots (`johnsonPentagonalRotunda_nu_roots_list`). `johnsonPentagonalRotunda_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `johnsonPentagonalRotunda_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`johnsonPentagonalRotunda_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonPentagonalRotunda` and `Nieuwland.Certs.NieuwlandJohnsonPentagonalRotunda.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Johnson.PentagonalRotunda.polyhedron`: the equation `6241 * ℓ ^ 8 - 638840 * ℓ ^ 6 + 2930800 * ℓ ^ 4 - 4240000 * ℓ ^ 2 + 1952000 = 0` with `ℓ` in the interval of the number's decimals (the system of `johnsonPentagonalRotunda_exact`). -/
noncomputable def johnsonPentagonalRotunda_nu_system_0 : PolynomialSystem :=
  ⟨[([(1952000, []), (2930800, [(0, 4)]), (6241, [(0, 8)])],
     [(4240000, [(0, 2)]), (638840, [(0, 6)])])],
   [(15978127358358014724710742393/15625000000000000000000000000, 1022600150934912942381487513153/1000000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Johnson.PentagonalRotunda.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `johnsonPentagonalRotunda_nu_roots`. -/
theorem johnsonPentagonalRotunda_nu_roots_list :
    PolynomialSystem.IsRootMax [johnsonPentagonalRotunda_nu_system_0] Johnson.PentagonalRotunda.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var johnsonPentagonalRotunda_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Johnson.PentagonalRotunda.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem johnsonPentagonalRotunda_nu_system_0_oneRoot : johnsonPentagonalRotunda_nu_system_0.HasUniqueRoot :=
  johnsonPentagonalRotunda_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.PentagonalRotunda.polyhedron`, by roots**: `ν Johnson.PentagonalRotunda.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `johnsonPentagonalRotunda_nu_system_<j>`. -/
theorem johnsonPentagonalRotunda_nu_roots :
    ν Johnson.PentagonalRotunda.polyhedron ∈ Set.Icc ((1022600150934912942381487513152 : ℝ) / 10 ^ 30) ((1022600150934912942381487513153 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Johnson.PentagonalRotunda.polyhedron) :=
  ⟨johnsonPentagonalRotunda_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) johnsonPentagonalRotunda_nu_roots_list⟩

end

end Nieuwland.Polyhedra
