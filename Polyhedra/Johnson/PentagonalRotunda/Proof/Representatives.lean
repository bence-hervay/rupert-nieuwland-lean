import Polyhedra.Johnson.PentagonalRotunda.Proof.Roots
import Modules.Root.Reps

set_option linter.style.longLine false

/-!
# One shared scale: `ν Johnson.PentagonalRotunda.polyhedron`

`johnsonPentagonalRotunda_nu_shared_list`: **every system of `johnsonPentagonalRotunda_nu_roots_list` has its one root at the scale
`ν Johnson.PentagonalRotunda.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `johnsonPentagonalRotunda_nu_reps_list`:
the same for the same system, and `johnsonPentagonalRotunda_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Johnson.PentagonalRotunda.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonPentagonalRotunda`, `Nieuwland.Certs.NieuwlandJohnsonPentagonalRotunda.Exact` and
`Nieuwland.Certs.NieuwlandJohnsonPentagonalRotunda.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Johnson.PentagonalRotunda.polyhedron` has its one root at `ν Johnson.PentagonalRotunda.polyhedron`**: each of the systems of `johnsonPentagonalRotunda_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem johnsonPentagonalRotunda_nu_shared_list :
    PolynomialSystem.IsRootEq [johnsonPentagonalRotunda_nu_system_0] Johnson.PentagonalRotunda.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton johnsonPentagonalRotunda_nu_roots_list

/-- **The representatives of `ν Johnson.PentagonalRotunda.polyhedron`**: the same system, each with exactly one root, at the scale `ν Johnson.PentagonalRotunda.polyhedron`. -/
theorem johnsonPentagonalRotunda_nu_reps_list :
    PolynomialSystem.IsRootEq [johnsonPentagonalRotunda_nu_system_0] Johnson.PentagonalRotunda.polyhedron.nieuwland :=
  johnsonPentagonalRotunda_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.PentagonalRotunda.polyhedron`, by representatives**: `ν Johnson.PentagonalRotunda.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `johnsonPentagonalRotunda_nu_reps_list`. -/
theorem johnsonPentagonalRotunda_nu_reps :
    ν Johnson.PentagonalRotunda.polyhedron ∈ Set.Icc ((1022600150934912942381487513152 : ℝ) / 10 ^ 30) ((1022600150934912942381487513153 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Johnson.PentagonalRotunda.polyhedron) :=
  ⟨johnsonPentagonalRotunda_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) johnsonPentagonalRotunda_nu_reps_list⟩

end

end Nieuwland.Polyhedra
