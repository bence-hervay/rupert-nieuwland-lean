    (Root.ParData.sqrt_unique (by decide +kernel)) (by decide)
    (fun _ h ↦ Root.ok_of_certOk Nieuwland.Certs.NieuwlandJohnsonAugmentedTruncatedDodecahedron.touch_ok h) johnsonAugmentedTruncatedDodecahedron_nu_roots_list [0, 1, 2, 3, 4, 5]
