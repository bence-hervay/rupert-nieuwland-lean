import Polyhedra.Johnson.AugmentedTruncatedTetrahedron.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Johnson.AugmentedTruncatedTetrahedron.polyhedron`

`johnsonAugmentedTruncatedTetrahedron_nu_system_<j>`: the systems of `johnsonAugmentedTruncatedTetrahedron_exact` (`Nieuwland.Certs.NieuwlandJohnsonAugmentedTruncatedTetrahedron.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`johnsonAugmentedTruncatedTetrahedron_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Johnson.AugmentedTruncatedTetrahedron.polyhedron` is the largest scale among
those roots (`johnsonAugmentedTruncatedTetrahedron_nu_roots_list`). `johnsonAugmentedTruncatedTetrahedron_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `johnsonAugmentedTruncatedTetrahedron_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`johnsonAugmentedTruncatedTetrahedron_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonAugmentedTruncatedTetrahedron` and `Nieuwland.Certs.NieuwlandJohnsonAugmentedTruncatedTetrahedron.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Johnson.AugmentedTruncatedTetrahedron.polyhedron`: the equation `1521 * ℓ ^ 8 - 19486 * ℓ ^ 6 + 20621 * ℓ ^ 4 - 356 * ℓ ^ 2 + 4 = 0` with `ℓ` in the interval of the number's decimals (the system of `johnsonAugmentedTruncatedTetrahedron_exact`). -/
noncomputable def johnsonAugmentedTruncatedTetrahedron_nu_system_0 : PolynomialSystem :=
  ⟨[([(4, []), (20621, [(0, 4)]), (1521, [(0, 8)])],
     [(356, [(0, 2)]), (19486, [(0, 6)])])],
   [(1069920024601572765919639043289/1000000000000000000000000000000, 106992002460157276591963904329/100000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Johnson.AugmentedTruncatedTetrahedron.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `johnsonAugmentedTruncatedTetrahedron_nu_roots`. -/
theorem johnsonAugmentedTruncatedTetrahedron_nu_roots_list :
    PolynomialSystem.IsRootMax [johnsonAugmentedTruncatedTetrahedron_nu_system_0] Johnson.AugmentedTruncatedTetrahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var johnsonAugmentedTruncatedTetrahedron_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Johnson.AugmentedTruncatedTetrahedron.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem johnsonAugmentedTruncatedTetrahedron_nu_system_0_oneRoot : johnsonAugmentedTruncatedTetrahedron_nu_system_0.HasUniqueRoot :=
  johnsonAugmentedTruncatedTetrahedron_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.AugmentedTruncatedTetrahedron.polyhedron`, by roots**: `ν Johnson.AugmentedTruncatedTetrahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `johnsonAugmentedTruncatedTetrahedron_nu_system_<j>`. -/
theorem johnsonAugmentedTruncatedTetrahedron_nu_roots :
    ν Johnson.AugmentedTruncatedTetrahedron.polyhedron ∈ Set.Icc ((1069920024601572765919639043289 : ℝ) / 10 ^ 30) ((1069920024601572765919639043290 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Johnson.AugmentedTruncatedTetrahedron.polyhedron) :=
  ⟨johnsonAugmentedTruncatedTetrahedron_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) johnsonAugmentedTruncatedTetrahedron_nu_roots_list⟩

end

end Nieuwland.Polyhedra
