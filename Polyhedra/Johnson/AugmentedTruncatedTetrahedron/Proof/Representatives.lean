/-!
# One shared scale: `ν Johnson.AugmentedTruncatedTetrahedron.polyhedron`

`johnsonAugmentedTruncatedTetrahedron_nu_shared_list`: **every system of `johnsonAugmentedTruncatedTetrahedron_nu_roots_list` has its one root at the scale
`ν Johnson.AugmentedTruncatedTetrahedron.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `johnsonAugmentedTruncatedTetrahedron_nu_reps_list`:
the same for the same system, and `johnsonAugmentedTruncatedTetrahedron_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Johnson.AugmentedTruncatedTetrahedron.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonAugmentedTruncatedTetrahedron`, `Nieuwland.Certs.NieuwlandJohnsonAugmentedTruncatedTetrahedron.Exact` and
`Nieuwland.Certs.NieuwlandJohnsonAugmentedTruncatedTetrahedron.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Johnson.AugmentedTruncatedTetrahedron.polyhedron` has its one root at `ν Johnson.AugmentedTruncatedTetrahedron.polyhedron`**: each of the systems of `johnsonAugmentedTruncatedTetrahedron_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem johnsonAugmentedTruncatedTetrahedron_nu_shared_list :
    PolynomialSystem.IsRootEq [johnsonAugmentedTruncatedTetrahedron_nu_system_0] Johnson.AugmentedTruncatedTetrahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton johnsonAugmentedTruncatedTetrahedron_nu_roots_list

/-- **The representatives of `ν Johnson.AugmentedTruncatedTetrahedron.polyhedron`**: the same system, each with exactly one root, at the scale `ν Johnson.AugmentedTruncatedTetrahedron.polyhedron`. -/
theorem johnsonAugmentedTruncatedTetrahedron_nu_reps_list :
    PolynomialSystem.IsRootEq [johnsonAugmentedTruncatedTetrahedron_nu_system_0] Johnson.AugmentedTruncatedTetrahedron.polyhedron.nieuwland :=
  johnsonAugmentedTruncatedTetrahedron_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.AugmentedTruncatedTetrahedron.polyhedron`, by representatives**: `ν Johnson.AugmentedTruncatedTetrahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `johnsonAugmentedTruncatedTetrahedron_nu_reps_list`. -/
theorem johnsonAugmentedTruncatedTetrahedron_nu_reps :
    ν Johnson.AugmentedTruncatedTetrahedron.polyhedron ∈ Set.Icc ((1069920024601572765919639043289 : ℝ) / 10 ^ 30) ((1069920024601572765919639043290 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Johnson.AugmentedTruncatedTetrahedron.polyhedron) :=
  ⟨johnsonAugmentedTruncatedTetrahedron_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) johnsonAugmentedTruncatedTetrahedron_nu_reps_list⟩

end

