/-!
# One shared scale: `ν Johnson.AugmentedTriangularPrism.polyhedron`

`johnsonAugmentedTriangularPrism_nu_shared_list`: **every system of `johnsonAugmentedTriangularPrism_nu_roots_list` has its one root at the scale
`ν Johnson.AugmentedTriangularPrism.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `johnsonAugmentedTriangularPrism_nu_reps_list`:
the same for the same system, and `johnsonAugmentedTriangularPrism_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Johnson.AugmentedTriangularPrism.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonAugmentedTriangularPrism`, `Nieuwland.Certs.NieuwlandJohnsonAugmentedTriangularPrism.Exact` and
`Nieuwland.Certs.NieuwlandJohnsonAugmentedTriangularPrism.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Johnson.AugmentedTriangularPrism.polyhedron` has its one root at `ν Johnson.AugmentedTriangularPrism.polyhedron`**: each of the systems of `johnsonAugmentedTriangularPrism_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem johnsonAugmentedTriangularPrism_nu_shared_list :
    PolynomialSystem.IsRootEq [johnsonAugmentedTriangularPrism_nu_system_0] Johnson.AugmentedTriangularPrism.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton johnsonAugmentedTriangularPrism_nu_roots_list

/-- **The representatives of `ν Johnson.AugmentedTriangularPrism.polyhedron`**: the same system, each with exactly one root, at the scale `ν Johnson.AugmentedTriangularPrism.polyhedron`. -/
theorem johnsonAugmentedTriangularPrism_nu_reps_list :
    PolynomialSystem.IsRootEq [johnsonAugmentedTriangularPrism_nu_system_0] Johnson.AugmentedTriangularPrism.polyhedron.nieuwland :=
  johnsonAugmentedTriangularPrism_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.AugmentedTriangularPrism.polyhedron`, by representatives**: `ν Johnson.AugmentedTriangularPrism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `johnsonAugmentedTriangularPrism_nu_reps_list`. -/
theorem johnsonAugmentedTriangularPrism_nu_reps :
    ν Johnson.AugmentedTriangularPrism.polyhedron ∈ Set.Icc ((1070051340515580668599031095373 : ℝ) / 10 ^ 30) ((1070051340515580668599031095374 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Johnson.AugmentedTriangularPrism.polyhedron) :=
  ⟨johnsonAugmentedTriangularPrism_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) johnsonAugmentedTriangularPrism_nu_reps_list⟩

end

end Nieuwland.Polyhedra
