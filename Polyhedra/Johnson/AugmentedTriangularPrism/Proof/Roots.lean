import Polyhedra.Johnson.AugmentedTriangularPrism.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Johnson.AugmentedTriangularPrism.polyhedron`

`johnsonAugmentedTriangularPrism_nu_system_<j>`: the systems of `johnsonAugmentedTriangularPrism_exact` (`Nieuwland.Certs.NieuwlandJohnsonAugmentedTriangularPrism.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`johnsonAugmentedTriangularPrism_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Johnson.AugmentedTriangularPrism.polyhedron` is the largest scale among
those roots (`johnsonAugmentedTriangularPrism_nu_roots_list`). `johnsonAugmentedTriangularPrism_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `johnsonAugmentedTriangularPrism_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`johnsonAugmentedTriangularPrism_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonAugmentedTriangularPrism` and `Nieuwland.Certs.NieuwlandJohnsonAugmentedTriangularPrism.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Johnson.AugmentedTriangularPrism.polyhedron`: the equation `5184 * ℓ ^ 16 - 29376 * ℓ ^ 14 + 76896 * ℓ ^ 12 - 114504 * ℓ ^ 10 + 96985 * ℓ ^ 8 - 42800 * ℓ ^ 6 + 8148 * ℓ ^ 4 - 512 * ℓ ^ 2 + 4 = 0` with `ℓ` in the interval of the number's decimals (the system of `johnsonAugmentedTriangularPrism_exact`). -/
noncomputable def johnsonAugmentedTriangularPrism_nu_system_0 : PolynomialSystem :=
  ⟨[([(4, []), (8148, [(0, 4)]), (96985, [(0, 8)]), (76896, [(0, 12)]), (5184, [(0, 16)])],
     [(512, [(0, 2)]), (42800, [(0, 6)]), (114504, [(0, 10)]), (29376, [(0, 14)])])],
   [(1070051340515580668599031095373/1000000000000000000000000000000, 535025670257790334299515547687/500000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Johnson.AugmentedTriangularPrism.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `johnsonAugmentedTriangularPrism_nu_roots`. -/
theorem johnsonAugmentedTriangularPrism_nu_roots_list :
    PolynomialSystem.IsRootMax [johnsonAugmentedTriangularPrism_nu_system_0] Johnson.AugmentedTriangularPrism.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var johnsonAugmentedTriangularPrism_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Johnson.AugmentedTriangularPrism.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem johnsonAugmentedTriangularPrism_nu_system_0_oneRoot : johnsonAugmentedTriangularPrism_nu_system_0.HasUniqueRoot :=
  johnsonAugmentedTriangularPrism_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.AugmentedTriangularPrism.polyhedron`, by roots**: `ν Johnson.AugmentedTriangularPrism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `johnsonAugmentedTriangularPrism_nu_system_<j>`. -/
theorem johnsonAugmentedTriangularPrism_nu_roots :
    ν Johnson.AugmentedTriangularPrism.polyhedron ∈ Set.Icc ((1070051340515580668599031095373 : ℝ) / 10 ^ 30) ((1070051340515580668599031095374 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Johnson.AugmentedTriangularPrism.polyhedron) :=
  ⟨johnsonAugmentedTriangularPrism_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) johnsonAugmentedTriangularPrism_nu_roots_list⟩

end

end Nieuwland.Polyhedra
