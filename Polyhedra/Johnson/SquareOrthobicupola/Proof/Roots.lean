import Polyhedra.Johnson.SquareOrthobicupola.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Johnson.SquareOrthobicupola.polyhedron`

`johnsonSquareOrthobicupola_nu_system_<j>`: the systems of `johnsonSquareOrthobicupola_exact` (`Nieuwland.Certs.NieuwlandJohnsonSquareOrthobicupola.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`johnsonSquareOrthobicupola_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Johnson.SquareOrthobicupola.polyhedron` is the largest scale among
those roots (`johnsonSquareOrthobicupola_nu_roots_list`). `johnsonSquareOrthobicupola_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `johnsonSquareOrthobicupola_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`johnsonSquareOrthobicupola_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonSquareOrthobicupola` and `Nieuwland.Certs.NieuwlandJohnsonSquareOrthobicupola.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Johnson.SquareOrthobicupola.polyhedron`: the equation `ℓ ^ 4 - 8 * ℓ ^ 2 + 8 = 0` with `ℓ` in the interval of the number's decimals (the system of `johnsonSquareOrthobicupola_exact`). -/
noncomputable def johnsonSquareOrthobicupola_nu_system_0 : PolynomialSystem :=
  ⟨[([(8, []), (1, [(0, 4)])],
     [(8, [(0, 2)])])],
   [(270598050073098492199861602683/250000000000000000000000000000, 1082392200292393968799446410733/1000000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Johnson.SquareOrthobicupola.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `johnsonSquareOrthobicupola_nu_roots`. -/
theorem johnsonSquareOrthobicupola_nu_roots_list :
    PolynomialSystem.IsRootMax [johnsonSquareOrthobicupola_nu_system_0] Johnson.SquareOrthobicupola.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var johnsonSquareOrthobicupola_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Johnson.SquareOrthobicupola.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem johnsonSquareOrthobicupola_nu_system_0_oneRoot : johnsonSquareOrthobicupola_nu_system_0.HasUniqueRoot :=
  johnsonSquareOrthobicupola_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.SquareOrthobicupola.polyhedron`, by roots**: `ν Johnson.SquareOrthobicupola.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `johnsonSquareOrthobicupola_nu_system_<j>`. -/
theorem johnsonSquareOrthobicupola_nu_roots :
    ν Johnson.SquareOrthobicupola.polyhedron ∈ Set.Icc ((1082392200292393968799446410732 : ℝ) / 10 ^ 30) ((1082392200292393968799446410733 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Johnson.SquareOrthobicupola.polyhedron) :=
  ⟨johnsonSquareOrthobicupola_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) johnsonSquareOrthobicupola_nu_roots_list⟩

end

end Nieuwland.Polyhedra
