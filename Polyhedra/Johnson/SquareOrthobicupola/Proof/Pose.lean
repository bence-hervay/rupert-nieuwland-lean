namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Johnson.SquareOrthobicupola.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Johnson.SquareOrthobicupola.polyhedron` scaled by `N` through itself. -/
theorem johnsonSquareOrthobicupola_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.JohnsonSquareOrthobicupola.reps] N) :
    PolynomialSystem.IsPoseRoot Johnson.SquareOrthobicupola.polyhedron Pose.JohnsonSquareOrthobicupola.S N 22 13 31 := by
  rw [Pose.JohnsonSquareOrthobicupola.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.JohnsonSquareOrthobicupola.weak_check Pose.JohnsonSquareOrthobicupola.poly_eq Pose.JohnsonSquareOrthobicupola.ok

end Nieuwland.Polyhedra
