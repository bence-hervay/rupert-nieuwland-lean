theorem sqrt_ok : sqrtOk 2 2 sqrtD = true := by
  decide +kernel

/-- The points of the solid as exact values of the lift, times 4. -/
def points : List (V3 (ZTheta root)) :=
  [⟨⟨[6, 0, -1]⟩, ⟨[2]⟩, ⟨[0]⟩⟩, ⟨⟨[6, 0, -1]⟩, ⟨[-2]⟩, ⟨[0]⟩⟩, ⟨⟨[-6, 0, 1]⟩, ⟨[2]⟩, ⟨[0]⟩⟩, ⟨⟨[-6, 0, 1]⟩, ⟨[-2]⟩, ⟨[0]⟩⟩, ⟨⟨[2]⟩, ⟨[6, 0, -1]⟩, ⟨[0]⟩⟩, ⟨⟨[2]⟩, ⟨[-6, 0, 1]⟩, ⟨[0]⟩⟩, ⟨⟨[-2]⟩, ⟨[6, 0, -1]⟩, ⟨[0]⟩⟩, ⟨⟨[-2]⟩, ⟨[-6, 0, 1]⟩, ⟨[0]⟩⟩, ⟨⟨[2]⟩, ⟨[2]⟩, ⟨[4, 0, -1]⟩⟩, ⟨⟨[2]⟩, ⟨[2]⟩, ⟨[-4, 0, 1]⟩⟩, ⟨⟨[2]⟩, ⟨[-2]⟩, ⟨[4, 0, -1]⟩⟩, ⟨⟨[2]⟩, ⟨[-2]⟩, ⟨[-4, 0, 1]⟩⟩, ⟨⟨[-2]⟩, ⟨[2]⟩, ⟨[4, 0, -1]⟩⟩, ⟨⟨[-2]⟩, ⟨[2]⟩, ⟨[-4, 0, 1]⟩⟩, ⟨⟨[-2]⟩, ⟨[-2]⟩, ⟨[4, 0, -1]⟩⟩, ⟨⟨[-2]⟩, ⟨[-2]⟩, ⟨[-4, 0, 1]⟩⟩]

/-- The lift's points are the far field's under the embedding of `ℤ[√2]` (`ZSqrt.embed`), up to
the integer factors `1` and `1`. -/
theorem lift_ok : liftOk (ZSqrt.embed (d := 2) 2 sqrtD) 1 1 Nieuwland.Polyhedra.JohnsonSquareOrthobicupolaDim.points points = true := by
  decide +kernel

theorem points_eq : Polyhedron.ofPoints points = (Polyhedron.ofPoints Nieuwland.Polyhedra.JohnsonSquareOrthobicupolaDim.points).smul (((1 : ℕ) : ℝ) * ((2 : ℕ) : ℝ) / ((1 : ℕ) : ℝ)) :=
  ofPoints_of_liftOk (ZSqrt.re_embed sqrt_ok) lift_ok

