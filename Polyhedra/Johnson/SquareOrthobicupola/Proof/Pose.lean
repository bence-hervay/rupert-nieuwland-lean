/-- The system (`Polynomials.lean`). -/
noncomputable abbrev S : PolynomialSystem := Johnson.SquareOrthobicupola.system

theorem ok : cfOk reps root weak kappa I B₁ B₃ quot = true := by
  decide +kernel

theorem S_eq : S = cfSystem reps root weak kappa I B₁ B₃ := by
  decide +kernel

theorem poly_eq : Johnson.SquareOrthobicupola.polyhedron = (Polyhedron.ofPoints points).smul ((kappa : ℚ) : ℝ) := by
  rw [Nieuwland.Polyhedra.JohnsonSquareOrthobicupolaDim.eq_smul, points_eq, Polyhedron.smul_smul_eq]
  congr 1
