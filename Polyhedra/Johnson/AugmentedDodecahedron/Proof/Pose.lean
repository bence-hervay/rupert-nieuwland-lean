/-- The system (`Polynomials.lean`). -/
noncomputable abbrev S : PolynomialSystem := Johnson.AugmentedDodecahedron.system

theorem par_ok : Root.RootBasis.parCheck (ZSqrt 5) touch.par = true := by
  decide +kernel

/-- The contacts of the record's duplicates and coincidences, whose identities check on the balls of the box (compiled evaluation: the identities' polynomials are expanded by well-founded recursion, which the kernel does not evaluate). -/
def zs : List (ℕ × ℕ × ℕ) := [(14, 4, 9)]

theorem zs_eq : Root.Sys.zeroCons (ZSqrt 5) (touch.sys Nieuwland.Polyhedra.JohnsonAugmentedDodecahedronDim.points) (touch.kraw Nieuwland.Polyhedra.JohnsonAugmentedDodecahedronDim.points).boxBalls touch.W = zs := by
  native_decide

