theorem poly_eq : Johnson.AugmentedDodecahedron.polyhedron = (Polyhedron.ofPoints Nieuwland.Polyhedra.JohnsonAugmentedDodecahedronDim.points).smul ((kappa : ℚ) : ℝ) := by
