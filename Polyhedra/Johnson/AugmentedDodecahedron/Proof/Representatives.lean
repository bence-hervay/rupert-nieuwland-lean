/-- **The links' checks** (`Root.linkGroupsOk`, `Modules/Root/Reps.lean`): each link's isometries and contacts, and the image of its source root's zero inside its target's box; compiled code evaluates it, and `links_ok` rests on the axiom that `native_decide` records for it. -/
theorem links_ok :
    Root.linkGroupsOk points [touch0, touch1, touch2, touch3, touch4, touch5] touch0 [0]
      [(0, [(1, link_0_1), (2, link_0_2), (3, link_0_3), (4, link_0_4), (5, link_0_5)])] = true := by
  native_decide

end Nieuwland.Certs.NieuwlandJohnsonAugmentedDodecahedron

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Johnson.AugmentedDodecahedron.polyhedron` has its one root at `ν Johnson.AugmentedDodecahedron.polyhedron`**: each of the systems of `johnsonAugmentedDodecahedron_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem johnsonAugmentedDodecahedron_nu_shared_list :
    PolynomialSystem.IsRootEq [johnsonAugmentedDodecahedron_nu_system_0, johnsonAugmentedDodecahedron_nu_system_1, johnsonAugmentedDodecahedron_nu_system_2, johnsonAugmentedDodecahedron_nu_system_3, johnsonAugmentedDodecahedron_nu_system_4, johnsonAugmentedDodecahedron_nu_system_5] Johnson.AugmentedDodecahedron.polyhedron.nieuwland :=
  Root.isRootEq_of_links (F := (Root.ParData.sqrt 5 2 3)) (Root.ParData.sqrt_spec (by decide +kernel))
    (Root.ParData.sqrt_unique (by decide +kernel)) (by decide)
    (fun _ h ↦ Root.ok_of_certOk Nieuwland.Certs.NieuwlandJohnsonAugmentedDodecahedron.touch_ok h) johnsonAugmentedDodecahedron_nu_roots_list [0, 1, 2, 3, 4, 5]
    (.cons johnsonAugmentedDodecahedron_nu_system_0_of (.cons johnsonAugmentedDodecahedron_nu_system_1_of (.cons johnsonAugmentedDodecahedron_nu_system_2_of (.cons johnsonAugmentedDodecahedron_nu_system_3_of (.cons johnsonAugmentedDodecahedron_nu_system_4_of (.cons johnsonAugmentedDodecahedron_nu_system_5_of .nil))))))
    _ Nieuwland.Certs.NieuwlandJohnsonAugmentedDodecahedron.links_ok (by decide) (by simp) (fun _ h ↦ h)

/-- **The representatives of `ν Johnson.AugmentedDodecahedron.polyhedron`**: the system of root 0 alone (one picture class: the roots {0, 1, 2, 3, 4, 5}), each with exactly one root, at the scale `ν Johnson.AugmentedDodecahedron.polyhedron`. -/
theorem johnsonAugmentedDodecahedron_nu_reps_list :
    PolynomialSystem.IsRootEq [johnsonAugmentedDodecahedron_nu_system_0] Johnson.AugmentedDodecahedron.polyhedron.nieuwland :=
  johnsonAugmentedDodecahedron_nu_shared_list.sub (by simp) (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.AugmentedDodecahedron.polyhedron`, by representatives**: `ν Johnson.AugmentedDodecahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `johnsonAugmentedDodecahedron_nu_reps_list`. -/
theorem johnsonAugmentedDodecahedron_nu_reps :
    ν Johnson.AugmentedDodecahedron.polyhedron ∈ Set.Icc ((1014157239072207580360323082815 : ℝ) / 10 ^ 30) ((1014157239072207580360323082816 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Johnson.AugmentedDodecahedron.polyhedron) :=
  ⟨johnsonAugmentedDodecahedron_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) johnsonAugmentedDodecahedron_nu_reps_list⟩

end

