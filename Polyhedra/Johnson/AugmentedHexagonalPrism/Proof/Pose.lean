/-- **ν and an optimal pose of `Johnson.AugmentedHexagonalPrism.polyhedron` as one root**: when the representatives' systems have
exactly one root each, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it
`matAt x 57`, `matAt x 48` and `(x 66, x 67)` are a weak fit of `Johnson.AugmentedHexagonalPrism.polyhedron` scaled
by `N` through itself. -/
theorem johnsonAugmentedHexagonalPrism_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.JohnsonAugmentedHexagonalPrism.reps0] N) :
    PolynomialSystem.IsPoseRoot Johnson.AugmentedHexagonalPrism.polyhedron Pose.JohnsonAugmentedHexagonalPrism.S N 57 48 66 := by
  rw [Pose.JohnsonAugmentedHexagonalPrism.S_eq]
  exact PolynomialSystem.ct_isPoseRoot h List.mem_cons_self Pose.JohnsonAugmentedHexagonalPrism.len_eq Pose.JohnsonAugmentedHexagonalPrism.reps_eq
    (Root.ParData.theta_spec Nieuwland.Polyhedra.JohnsonAugmentedHexagonalPrismDim.root) Pose.JohnsonAugmentedHexagonalPrism.par_ok Pose.JohnsonAugmentedHexagonalPrism.zs_eq Pose.JohnsonAugmentedHexagonalPrism.weak_ok Pose.JohnsonAugmentedHexagonalPrism.poly_eq Pose.JohnsonAugmentedHexagonalPrism.ok

end Nieuwland.Polyhedra
