/-- The lift's points to the polyhedron's. -/
def kappa : ℚ := 1/19745107780230946618285816

/-- The system (`Polynomials.lean`). -/
noncomputable abbrev S : PolynomialSystem := Johnson.SquareGyrobicupola.system

theorem ok : cfOk reps root weak kappa I B₁ B₃ quot = true := by
  decide +kernel

theorem S_eq : S = cfSystem reps root weak kappa I B₁ B₃ := by
  decide +kernel

theorem poly_eq : Johnson.SquareGyrobicupola.polyhedron = (Polyhedron.ofPoints points).smul ((kappa : ℚ) : ℝ) := by
  rw [Nieuwland.Polyhedra.JohnsonSquareGyrobicupolaDim.eq_smul, points_eq, Polyhedron.smul_smul_eq]
  congr 1
  norm_num [kappa]

end Nieuwland.Pose.JohnsonSquareGyrobicupola

namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Johnson.SquareGyrobicupola.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Johnson.SquareGyrobicupola.polyhedron` scaled by `N` through itself. -/
theorem johnsonSquareGyrobicupola_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.JohnsonSquareGyrobicupola.reps] N) :
    PolynomialSystem.IsPoseRoot Johnson.SquareGyrobicupola.polyhedron Pose.JohnsonSquareGyrobicupola.S N 22 13 31 := by
  rw [Pose.JohnsonSquareGyrobicupola.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.JohnsonSquareGyrobicupola.weak_check Pose.JohnsonSquareGyrobicupola.poly_eq Pose.JohnsonSquareGyrobicupola.ok

end Nieuwland.Polyhedra
