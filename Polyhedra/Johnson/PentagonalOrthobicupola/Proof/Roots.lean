import Polyhedra.Johnson.PentagonalOrthobicupola.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Johnson.PentagonalOrthobicupola.polyhedron`

`johnsonPentagonalOrthobicupola_nu_system_<j>`: the systems of `johnsonPentagonalOrthobicupola_exact` (`Nieuwland.Certs.NieuwlandJohnsonPentagonalOrthobicupola.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`johnsonPentagonalOrthobicupola_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Johnson.PentagonalOrthobicupola.polyhedron` is the largest scale among
those roots (`johnsonPentagonalOrthobicupola_nu_roots_list`). `johnsonPentagonalOrthobicupola_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `johnsonPentagonalOrthobicupola_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`johnsonPentagonalOrthobicupola_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonPentagonalOrthobicupola` and `Nieuwland.Certs.NieuwlandJohnsonPentagonalOrthobicupola.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Johnson.PentagonalOrthobicupola.polyhedron`: the equation `5 * ℓ ^ 4 - 20 * ℓ ^ 2 + 16 = 0` with `ℓ` in the interval of the number's decimals (the system of `johnsonPentagonalOrthobicupola_exact`). -/
noncomputable def johnsonPentagonalOrthobicupola_nu_system_0 : PolynomialSystem :=
  ⟨[([(16, []), (5, [(0, 4)])],
     [(20, [(0, 2)])])],
   [(210292444847653442410267633939/200000000000000000000000000000, 32858194507445850376604317803/31250000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Johnson.PentagonalOrthobicupola.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `johnsonPentagonalOrthobicupola_nu_roots`. -/
theorem johnsonPentagonalOrthobicupola_nu_roots_list :
    PolynomialSystem.IsRootMax [johnsonPentagonalOrthobicupola_nu_system_0] Johnson.PentagonalOrthobicupola.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var johnsonPentagonalOrthobicupola_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Johnson.PentagonalOrthobicupola.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem johnsonPentagonalOrthobicupola_nu_system_0_oneRoot : johnsonPentagonalOrthobicupola_nu_system_0.HasUniqueRoot :=
  johnsonPentagonalOrthobicupola_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.PentagonalOrthobicupola.polyhedron`, by roots**: `ν Johnson.PentagonalOrthobicupola.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `johnsonPentagonalOrthobicupola_nu_system_<j>`. -/
theorem johnsonPentagonalOrthobicupola_nu_roots :
    ν Johnson.PentagonalOrthobicupola.polyhedron ∈ Set.Icc ((1051462224238267212051338169695 : ℝ) / 10 ^ 30) ((1051462224238267212051338169696 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Johnson.PentagonalOrthobicupola.polyhedron) :=
  ⟨johnsonPentagonalOrthobicupola_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) johnsonPentagonalOrthobicupola_nu_roots_list⟩

end

end Nieuwland.Polyhedra
