/-!
# Exactly one root per system: `ν Johnson.TriangularOrthobicupola.polyhedron`

`johnsonTriangularOrthobicupola_nu_system_<j>`: the systems of `johnsonTriangularOrthobicupola_exact` (`Nieuwland.Certs.NieuwlandJohnsonTriangularOrthobicupola.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`johnsonTriangularOrthobicupola_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Johnson.TriangularOrthobicupola.polyhedron` is the largest scale among
those roots (`johnsonTriangularOrthobicupola_nu_roots_list`). `johnsonTriangularOrthobicupola_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `johnsonTriangularOrthobicupola_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`johnsonTriangularOrthobicupola_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonTriangularOrthobicupola` and `Nieuwland.Certs.NieuwlandJohnsonTriangularOrthobicupola.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Johnson.TriangularOrthobicupola.polyhedron`: the equation `4489 * ℓ ^ 4 - 23904 * ℓ ^ 2 + 20736 = 0` with `ℓ` in the interval of the number's decimals (the system of `johnsonTriangularOrthobicupola_exact`). -/
noncomputable def johnsonTriangularOrthobicupola_nu_system_0 : PolynomialSystem :=
  ⟨[([(20736, []), (4489, [(0, 4)])],
     [(23904, [(0, 2)])])],
   [(261126578198426703135844220557/250000000000000000000000000000, 1044506312793706812543376882229/1000000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Johnson.TriangularOrthobicupola.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `johnsonTriangularOrthobicupola_nu_roots`. -/
theorem johnsonTriangularOrthobicupola_nu_roots_list :
    PolynomialSystem.IsRootMax [johnsonTriangularOrthobicupola_nu_system_0] Johnson.TriangularOrthobicupola.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var johnsonTriangularOrthobicupola_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Johnson.TriangularOrthobicupola.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem johnsonTriangularOrthobicupola_nu_system_0_oneRoot : johnsonTriangularOrthobicupola_nu_system_0.HasUniqueRoot :=
  johnsonTriangularOrthobicupola_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.TriangularOrthobicupola.polyhedron`, by roots**: `ν Johnson.TriangularOrthobicupola.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `johnsonTriangularOrthobicupola_nu_system_<j>`. -/
theorem johnsonTriangularOrthobicupola_nu_roots :
    ν Johnson.TriangularOrthobicupola.polyhedron ∈ Set.Icc ((1044506312793706812543376882228 : ℝ) / 10 ^ 30) ((1044506312793706812543376882229 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Johnson.TriangularOrthobicupola.polyhedron) :=
  ⟨johnsonTriangularOrthobicupola_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) johnsonTriangularOrthobicupola_nu_roots_list⟩

end

