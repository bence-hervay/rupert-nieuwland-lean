import Polyhedra.Johnson.SquarePyramid.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Johnson.SquarePyramid.polyhedron`

`johnsonSquarePyramid_nu_system_<j>`: the systems of `johnsonSquarePyramid_exact` (`Nieuwland.Certs.NieuwlandJohnsonSquarePyramid.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`johnsonSquarePyramid_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Johnson.SquarePyramid.polyhedron` is the largest scale among
those roots (`johnsonSquarePyramid_nu_roots_list`). `johnsonSquarePyramid_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `johnsonSquarePyramid_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`johnsonSquarePyramid_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonSquarePyramid` and `Nieuwland.Certs.NieuwlandJohnsonSquarePyramid.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Johnson.SquarePyramid.polyhedron`: the equation `ℓ ^ 2 - 8 * ℓ + 8 = 0` with `ℓ` in the interval of the number's decimals (the system of `johnsonSquarePyramid_exact`). -/
noncomputable def johnsonSquarePyramid_nu_system_0 : PolynomialSystem :=
  ⟨[([(8, []), (1, [(0, 2)])],
     [(8, [(0, 1)])])],
   [(58578643762690495119831127579/50000000000000000000000000000, 1171572875253809902396622551581/1000000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Johnson.SquarePyramid.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `johnsonSquarePyramid_nu_roots`. -/
theorem johnsonSquarePyramid_nu_roots_list :
    PolynomialSystem.IsRootMax [johnsonSquarePyramid_nu_system_0] Johnson.SquarePyramid.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var johnsonSquarePyramid_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Johnson.SquarePyramid.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem johnsonSquarePyramid_nu_system_0_oneRoot : johnsonSquarePyramid_nu_system_0.HasUniqueRoot :=
  johnsonSquarePyramid_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.SquarePyramid.polyhedron`, by roots**: `ν Johnson.SquarePyramid.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `johnsonSquarePyramid_nu_system_<j>`. -/
theorem johnsonSquarePyramid_nu_roots :
    ν Johnson.SquarePyramid.polyhedron ∈ Set.Icc ((1171572875253809902396622551580 : ℝ) / 10 ^ 30) ((1171572875253809902396622551581 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Johnson.SquarePyramid.polyhedron) :=
  ⟨johnsonSquarePyramid_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) johnsonSquarePyramid_nu_roots_list⟩

end

end Nieuwland.Polyhedra
