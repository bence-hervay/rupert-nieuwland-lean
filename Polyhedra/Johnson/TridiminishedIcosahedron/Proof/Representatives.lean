set_option maxHeartbeats 0 in
/-- **Every system of `ν Johnson.TridiminishedIcosahedron.polyhedron` has its one root at `ν Johnson.TridiminishedIcosahedron.polyhedron`**: each of the systems of `johnsonTridiminishedIcosahedron_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem johnsonTridiminishedIcosahedron_nu_shared_list :
    PolynomialSystem.IsRootEq [johnsonTridiminishedIcosahedron_nu_system_0] Johnson.TridiminishedIcosahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton johnsonTridiminishedIcosahedron_nu_roots_list

/-- **The representatives of `ν Johnson.TridiminishedIcosahedron.polyhedron`**: the same system, each with exactly one root, at the scale `ν Johnson.TridiminishedIcosahedron.polyhedron`. -/
theorem johnsonTridiminishedIcosahedron_nu_reps_list :
    PolynomialSystem.IsRootEq [johnsonTridiminishedIcosahedron_nu_system_0] Johnson.TridiminishedIcosahedron.polyhedron.nieuwland :=
  johnsonTridiminishedIcosahedron_nu_shared_list

