set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.TriaugmentedDodecahedron.polyhedron`, by representatives**: `ν Johnson.TriaugmentedDodecahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `johnsonTriaugmentedDodecahedron_nu_reps_list`. -/
theorem johnsonTriaugmentedDodecahedron_nu_reps :
    ν Johnson.TriaugmentedDodecahedron.polyhedron ∈ Set.Icc ((1006280581239854206635290203601 : ℝ) / 10 ^ 30) ((1006280581239854206635290203602 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Johnson.TriaugmentedDodecahedron.polyhedron) :=
  ⟨johnsonTriaugmentedDodecahedron_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) johnsonTriaugmentedDodecahedron_nu_reps_list⟩

end

