import Polyhedra.Johnson.TriaugmentedDodecahedron.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Johnson.TriaugmentedDodecahedron.polyhedron`

`johnsonTriaugmentedDodecahedron_nu_system_<j>`: the systems of `johnsonTriaugmentedDodecahedron_exact` (`Nieuwland.Certs.NieuwlandJohnsonTriaugmentedDodecahedron.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`johnsonTriaugmentedDodecahedron_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Johnson.TriaugmentedDodecahedron.polyhedron` is the largest scale among
those roots (`johnsonTriaugmentedDodecahedron_nu_roots_list`). `johnsonTriaugmentedDodecahedron_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `johnsonTriaugmentedDodecahedron_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`johnsonTriaugmentedDodecahedron_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonTriaugmentedDodecahedron` and `Nieuwland.Certs.NieuwlandJohnsonTriaugmentedDodecahedron.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Johnson.TriaugmentedDodecahedron.polyhedron`: the equation `7569 * ℓ ^ 6 - 20706 * ℓ ^ 5 - 45799 * ℓ ^ 4 + 91488 * ℓ ^ 3 + 22244 * ℓ ^ 2 - 74000 * ℓ + 19184 = 0` with `ℓ` in the interval of the number's decimals (the system of `johnsonTriaugmentedDodecahedron_exact`). -/
noncomputable def johnsonTriaugmentedDodecahedron_nu_system_0 : PolynomialSystem :=
  ⟨[([(19184, []), (22244, [(0, 2)]), (91488, [(0, 3)]), (7569, [(0, 6)])],
     [(74000, [(0, 1)]), (45799, [(0, 4)]), (20706, [(0, 5)])])],
   [(1006280581239854206635290203601/1000000000000000000000000000000, 503140290619927103317645101801/500000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Johnson.TriaugmentedDodecahedron.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `johnsonTriaugmentedDodecahedron_nu_roots`. -/
theorem johnsonTriaugmentedDodecahedron_nu_roots_list :
    PolynomialSystem.IsRootMax [johnsonTriaugmentedDodecahedron_nu_system_0] Johnson.TriaugmentedDodecahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var johnsonTriaugmentedDodecahedron_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Johnson.TriaugmentedDodecahedron.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem johnsonTriaugmentedDodecahedron_nu_system_0_oneRoot : johnsonTriaugmentedDodecahedron_nu_system_0.HasUniqueRoot :=
  johnsonTriaugmentedDodecahedron_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.TriaugmentedDodecahedron.polyhedron`, by roots**: `ν Johnson.TriaugmentedDodecahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `johnsonTriaugmentedDodecahedron_nu_system_<j>`. -/
theorem johnsonTriaugmentedDodecahedron_nu_roots :
    ν Johnson.TriaugmentedDodecahedron.polyhedron ∈ Set.Icc ((1006280581239854206635290203601 : ℝ) / 10 ^ 30) ((1006280581239854206635290203602 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Johnson.TriaugmentedDodecahedron.polyhedron) :=
  ⟨johnsonTriaugmentedDodecahedron_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) johnsonTriaugmentedDodecahedron_nu_roots_list⟩

end

end Nieuwland.Polyhedra
