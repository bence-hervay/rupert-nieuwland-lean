import Polyhedra.Johnson.TriangularCupola.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Johnson.TriangularCupola.polyhedron`

`johnsonTriangularCupola_nu_system_<j>`: the systems of `johnsonTriangularCupola_exact` (`Nieuwland.Certs.NieuwlandJohnsonTriangularCupola.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`johnsonTriangularCupola_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Johnson.TriangularCupola.polyhedron` is the largest scale among
those roots (`johnsonTriangularCupola_nu_roots_list`). `johnsonTriangularCupola_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `johnsonTriangularCupola_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`johnsonTriangularCupola_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonTriangularCupola` and `Nieuwland.Certs.NieuwlandJohnsonTriangularCupola.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Johnson.TriangularCupola.polyhedron`: the equation `4489 * ℓ ^ 4 - 14376 * ℓ ^ 2 + 10512 = 0` with `ℓ` in the interval of the number's decimals (the system of `johnsonTriangularCupola_exact`). -/
noncomputable def johnsonTriangularCupola_nu_system_0 : PolynomialSystem :=
  ⟨[([(10512, []), (4489, [(0, 4)])],
     [(14376, [(0, 2)])])],
   [(531458610568028969251375166709/500000000000000000000000000000, 1062917221136057938502750333419/1000000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Johnson.TriangularCupola.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `johnsonTriangularCupola_nu_roots`. -/
theorem johnsonTriangularCupola_nu_roots_list :
    PolynomialSystem.IsRootMax [johnsonTriangularCupola_nu_system_0] Johnson.TriangularCupola.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var johnsonTriangularCupola_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Johnson.TriangularCupola.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem johnsonTriangularCupola_nu_system_0_oneRoot : johnsonTriangularCupola_nu_system_0.HasUniqueRoot :=
  johnsonTriangularCupola_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.TriangularCupola.polyhedron`, by roots**: `ν Johnson.TriangularCupola.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `johnsonTriangularCupola_nu_system_<j>`. -/
theorem johnsonTriangularCupola_nu_roots :
    ν Johnson.TriangularCupola.polyhedron ∈ Set.Icc ((1062917221136057938502750333418 : ℝ) / 10 ^ 30) ((1062917221136057938502750333419 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Johnson.TriangularCupola.polyhedron) :=
  ⟨johnsonTriangularCupola_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) johnsonTriangularCupola_nu_roots_list⟩

end

end Nieuwland.Polyhedra
