import Modules.Root.Reps

set_option linter.style.longLine false

/-!
# One shared scale: `ν Johnson.TriangularCupola.polyhedron`

`johnsonTriangularCupola_nu_shared_list`: **every system of `johnsonTriangularCupola_nu_roots_list` has its one root at the scale
`ν Johnson.TriangularCupola.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `johnsonTriangularCupola_nu_reps_list`:
the same for the same system, and `johnsonTriangularCupola_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Johnson.TriangularCupola.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonTriangularCupola`, `Nieuwland.Certs.NieuwlandJohnsonTriangularCupola.Exact` and
`Nieuwland.Certs.NieuwlandJohnsonTriangularCupola.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Johnson.TriangularCupola.polyhedron` has its one root at `ν Johnson.TriangularCupola.polyhedron`**: each of the systems of `johnsonTriangularCupola_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem johnsonTriangularCupola_nu_shared_list :
    PolynomialSystem.IsRootEq [johnsonTriangularCupola_nu_system_0] Johnson.TriangularCupola.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton johnsonTriangularCupola_nu_roots_list

/-- **The representatives of `ν Johnson.TriangularCupola.polyhedron`**: the same system, each with exactly one root, at the scale `ν Johnson.TriangularCupola.polyhedron`. -/
theorem johnsonTriangularCupola_nu_reps_list :
    PolynomialSystem.IsRootEq [johnsonTriangularCupola_nu_system_0] Johnson.TriangularCupola.polyhedron.nieuwland :=
  johnsonTriangularCupola_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.TriangularCupola.polyhedron`, by representatives**: `ν Johnson.TriangularCupola.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `johnsonTriangularCupola_nu_reps_list`. -/
theorem johnsonTriangularCupola_nu_reps :
    ν Johnson.TriangularCupola.polyhedron ∈ Set.Icc ((1062917221136057938502750333418 : ℝ) / 10 ^ 30) ((1062917221136057938502750333419 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Johnson.TriangularCupola.polyhedron) :=
  ⟨johnsonTriangularCupola_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) johnsonTriangularCupola_nu_reps_list⟩

end

end Nieuwland.Polyhedra
