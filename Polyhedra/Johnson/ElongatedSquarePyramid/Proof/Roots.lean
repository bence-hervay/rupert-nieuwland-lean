/-!
# Exactly one root per system: `ν Johnson.ElongatedSquarePyramid.polyhedron`

`johnsonElongatedSquarePyramid_nu_system_<j>`: the systems of `johnsonElongatedSquarePyramid_exact` (`Nieuwland.Certs.NieuwlandJohnsonElongatedSquarePyramid.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`johnsonElongatedSquarePyramid_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Johnson.ElongatedSquarePyramid.polyhedron` is the largest scale among
those roots (`johnsonElongatedSquarePyramid_nu_roots_list`). `johnsonElongatedSquarePyramid_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `johnsonElongatedSquarePyramid_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`johnsonElongatedSquarePyramid_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonElongatedSquarePyramid` and `Nieuwland.Certs.NieuwlandJohnsonElongatedSquarePyramid.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Johnson.ElongatedSquarePyramid.polyhedron`: the equation `ℓ ^ 4 + 4 * ℓ ^ 3 - 12 * ℓ ^ 2 + 8 = 0` with `ℓ` in the interval of the number's decimals (the system of `johnsonElongatedSquarePyramid_exact`). -/
noncomputable def johnsonElongatedSquarePyramid_nu_system_0 : PolynomialSystem :=
  ⟨[([(8, []), (4, [(0, 3)]), (1, [(0, 4)])],
     [(12, [(0, 2)])])],
   [(57171686447737692645749045831/50000000000000000000000000000, 1143433728954753852914980916621/1000000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Johnson.ElongatedSquarePyramid.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `johnsonElongatedSquarePyramid_nu_roots`. -/
theorem johnsonElongatedSquarePyramid_nu_roots_list :
    PolynomialSystem.IsRootMax [johnsonElongatedSquarePyramid_nu_system_0] Johnson.ElongatedSquarePyramid.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var johnsonElongatedSquarePyramid_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Johnson.ElongatedSquarePyramid.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem johnsonElongatedSquarePyramid_nu_system_0_oneRoot : johnsonElongatedSquarePyramid_nu_system_0.HasUniqueRoot :=
  johnsonElongatedSquarePyramid_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.ElongatedSquarePyramid.polyhedron`, by roots**: `ν Johnson.ElongatedSquarePyramid.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `johnsonElongatedSquarePyramid_nu_system_<j>`. -/
theorem johnsonElongatedSquarePyramid_nu_roots :
    ν Johnson.ElongatedSquarePyramid.polyhedron ∈ Set.Icc ((1143433728954753852914980916620 : ℝ) / 10 ^ 30) ((1143433728954753852914980916621 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Johnson.ElongatedSquarePyramid.polyhedron) :=
  ⟨johnsonElongatedSquarePyramid_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) johnsonElongatedSquarePyramid_nu_roots_list⟩

end

