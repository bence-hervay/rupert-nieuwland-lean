  exact PolynomialSystem.ct_isPoseRoot h List.mem_cons_self Pose.JohnsonMetabidiminishedRhombicosidodecahedron.len_eq Pose.JohnsonMetabidiminishedRhombicosidodecahedron.reps_eq
    (Root.ParData.sqrt_spec (by decide +kernel)) Pose.JohnsonMetabidiminishedRhombicosidodecahedron.par_ok Pose.JohnsonMetabidiminishedRhombicosidodecahedron.zs_eq Pose.JohnsonMetabidiminishedRhombicosidodecahedron.weak_ok Pose.JohnsonMetabidiminishedRhombicosidodecahedron.poly_eq Pose.JohnsonMetabidiminishedRhombicosidodecahedron.ok

