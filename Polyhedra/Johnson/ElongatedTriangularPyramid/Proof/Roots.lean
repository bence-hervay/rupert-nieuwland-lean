open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.ElongatedTriangularPyramid.polyhedron`, by roots**: `ν Johnson.ElongatedTriangularPyramid.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `johnsonElongatedTriangularPyramid_nu_system_<j>`. -/
theorem johnsonElongatedTriangularPyramid_nu_roots :
    ν Johnson.ElongatedTriangularPyramid.polyhedron ∈ Set.Icc ((1116804344284627853845378013779 : ℝ) / 10 ^ 30) ((1116804344284627853845378013780 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Johnson.ElongatedTriangularPyramid.polyhedron) :=
  ⟨johnsonElongatedTriangularPyramid_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) johnsonElongatedTriangularPyramid_nu_roots_list⟩

end

