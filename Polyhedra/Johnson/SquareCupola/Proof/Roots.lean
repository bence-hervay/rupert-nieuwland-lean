import Polyhedra.Johnson.SquareCupola.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Johnson.SquareCupola.polyhedron`

`johnsonSquareCupola_nu_system_<j>`: the systems of `johnsonSquareCupola_exact` (`Nieuwland.Certs.NieuwlandJohnsonSquareCupola.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`johnsonSquareCupola_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Johnson.SquareCupola.polyhedron` is the largest scale among
those roots (`johnsonSquareCupola_nu_roots_list`). `johnsonSquareCupola_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `johnsonSquareCupola_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`johnsonSquareCupola_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonSquareCupola` and `Nieuwland.Certs.NieuwlandJohnsonSquareCupola.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Johnson.SquareCupola.polyhedron`: the equation `ℓ ^ 4 - 8 * ℓ ^ 2 + 8 = 0` with `ℓ` in the interval of the number's decimals (the system of `johnsonSquareCupola_exact`). -/
noncomputable def johnsonSquareCupola_nu_system_0 : PolynomialSystem :=
  ⟨[([(8, []), (1, [(0, 4)])],
     [(8, [(0, 2)])])],
   [(270598050073098492199861602683/250000000000000000000000000000, 1082392200292393968799446410733/1000000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Johnson.SquareCupola.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `johnsonSquareCupola_nu_roots`. -/
theorem johnsonSquareCupola_nu_roots_list :
    PolynomialSystem.IsRootMax [johnsonSquareCupola_nu_system_0] Johnson.SquareCupola.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var johnsonSquareCupola_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Johnson.SquareCupola.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem johnsonSquareCupola_nu_system_0_oneRoot : johnsonSquareCupola_nu_system_0.HasUniqueRoot :=
  johnsonSquareCupola_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.SquareCupola.polyhedron`, by roots**: `ν Johnson.SquareCupola.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `johnsonSquareCupola_nu_system_<j>`. -/
theorem johnsonSquareCupola_nu_roots :
    ν Johnson.SquareCupola.polyhedron ∈ Set.Icc ((1082392200292393968799446410732 : ℝ) / 10 ^ 30) ((1082392200292393968799446410733 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Johnson.SquareCupola.polyhedron) :=
  ⟨johnsonSquareCupola_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) johnsonSquareCupola_nu_roots_list⟩

end

end Nieuwland.Polyhedra
