import Polyhedra.Johnson.SquareCupola.Proof.Roots
import Modules.Root.Reps

set_option linter.style.longLine false

/-!
# One shared scale: `ν Johnson.SquareCupola.polyhedron`

`johnsonSquareCupola_nu_shared_list`: **every system of `johnsonSquareCupola_nu_roots_list` has its one root at the scale
`ν Johnson.SquareCupola.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `johnsonSquareCupola_nu_reps_list`:
the same for the same system, and `johnsonSquareCupola_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Johnson.SquareCupola.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandJohnsonSquareCupola`, `Nieuwland.Certs.NieuwlandJohnsonSquareCupola.Exact` and
`Nieuwland.Certs.NieuwlandJohnsonSquareCupola.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Johnson.SquareCupola.polyhedron` has its one root at `ν Johnson.SquareCupola.polyhedron`**: each of the systems of `johnsonSquareCupola_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem johnsonSquareCupola_nu_shared_list :
    PolynomialSystem.IsRootEq [johnsonSquareCupola_nu_system_0] Johnson.SquareCupola.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton johnsonSquareCupola_nu_roots_list

/-- **The representatives of `ν Johnson.SquareCupola.polyhedron`**: the same system, each with exactly one root, at the scale `ν Johnson.SquareCupola.polyhedron`. -/
theorem johnsonSquareCupola_nu_reps_list :
    PolynomialSystem.IsRootEq [johnsonSquareCupola_nu_system_0] Johnson.SquareCupola.polyhedron.nieuwland :=
  johnsonSquareCupola_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Johnson.SquareCupola.polyhedron`, by representatives**: `ν Johnson.SquareCupola.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `johnsonSquareCupola_nu_reps_list`. -/
theorem johnsonSquareCupola_nu_reps :
    ν Johnson.SquareCupola.polyhedron ∈ Set.Icc ((1082392200292393968799446410732 : ℝ) / 10 ^ 30) ((1082392200292393968799446410733 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Johnson.SquareCupola.polyhedron) :=
  ⟨johnsonSquareCupola_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) johnsonSquareCupola_nu_reps_list⟩

end

end Nieuwland.Polyhedra
