import Polyhedra.Prism.HendecagonalPrism.Proof.Roots
import Modules.Root.Reps

set_option linter.style.longLine false

/-!
# One shared scale: `ν Prism.HendecagonalPrism.polyhedron`

`prismHendecagonalPrism_nu_shared_list`: **every system of `prismHendecagonalPrism_nu_roots_list` has its one root at the scale
`ν Prism.HendecagonalPrism.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `prismHendecagonalPrism_nu_reps_list`:
the same for the same system, and `prismHendecagonalPrism_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Prism.HendecagonalPrism.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPrismHendecagonalPrism`, `Nieuwland.Certs.NieuwlandPrismHendecagonalPrism.Exact` and
`Nieuwland.Certs.NieuwlandPrismHendecagonalPrism.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Prism.HendecagonalPrism.polyhedron` has its one root at `ν Prism.HendecagonalPrism.polyhedron`**: each of the systems of `prismHendecagonalPrism_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem prismHendecagonalPrism_nu_shared_list :
    PolynomialSystem.IsRootEq [prismHendecagonalPrism_nu_system_0] Prism.HendecagonalPrism.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton prismHendecagonalPrism_nu_roots_list

/-- **The representatives of `ν Prism.HendecagonalPrism.polyhedron`**: the same system, each with exactly one root, at the scale `ν Prism.HendecagonalPrism.polyhedron`. -/
theorem prismHendecagonalPrism_nu_reps_list :
    PolynomialSystem.IsRootEq [prismHendecagonalPrism_nu_system_0] Prism.HendecagonalPrism.polyhedron.nieuwland :=
  prismHendecagonalPrism_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Prism.HendecagonalPrism.polyhedron`, by representatives**: `ν Prism.HendecagonalPrism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `prismHendecagonalPrism_nu_reps_list`. -/
theorem prismHendecagonalPrism_nu_reps :
    ν Prism.HendecagonalPrism.polyhedron ∈ Set.Icc ((1004386372860925187826928417016 : ℝ) / 10 ^ 30) ((1004386372860925187826928417017 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Prism.HendecagonalPrism.polyhedron) :=
  ⟨prismHendecagonalPrism_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) prismHendecagonalPrism_nu_reps_list⟩

end

end Nieuwland.Polyhedra
