/-!
# Exactly one root per system: `ν Prism.HendecagonalPrism.polyhedron`

`prismHendecagonalPrism_nu_system_<j>`: the systems of `prismHendecagonalPrism_exact` (`Nieuwland.Certs.NieuwlandPrismHendecagonalPrism.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`prismHendecagonalPrism_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Prism.HendecagonalPrism.polyhedron` is the largest scale among
those roots (`prismHendecagonalPrism_nu_roots_list`). `prismHendecagonalPrism_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `prismHendecagonalPrism_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`prismHendecagonalPrism_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPrismHendecagonalPrism` and `Nieuwland.Certs.NieuwlandPrismHendecagonalPrism.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Prism.HendecagonalPrism.polyhedron`: the equation `36590401 * ℓ ^ 20 - 637032730872 * ℓ ^ 18 + 14808917668656 * ℓ ^ 16 - 103814057328640 * ℓ ^ 14 + 368265816701696 * ℓ ^ 12 - 778943106359296 * ℓ ^ 10 + 1047883045367808 * ℓ ^ 8 - 909719444422656 * ℓ ^ 6 + 495680929267712 * ℓ ^ 4 - 154655086608384 * ℓ ^ 2 + 21129981853696 = 0` with `ℓ` in the interval of the number's decimals (the system of `prismHendecagonalPrism_exact`). -/
noncomputable def prismHendecagonalPrism_nu_system_0 : PolynomialSystem :=
  ⟨[([(21129981853696, []), (495680929267712, [(0, 4)]), (1047883045367808, [(0, 8)]), (368265816701696, [(0, 12)]), (14808917668656, [(0, 16)]), (36590401, [(0, 20)])],
     [(154655086608384, [(0, 2)]), (909719444422656, [(0, 6)]), (778943106359296, [(0, 10)]), (103814057328640, [(0, 14)]), (637032730872, [(0, 18)])])],
   [(125548296607615648478366052127/125000000000000000000000000000, 1004386372860925187826928417017/1000000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Prism.HendecagonalPrism.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `prismHendecagonalPrism_nu_roots`. -/
theorem prismHendecagonalPrism_nu_roots_list :
    PolynomialSystem.IsRootMax [prismHendecagonalPrism_nu_system_0] Prism.HendecagonalPrism.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var prismHendecagonalPrism_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Prism.HendecagonalPrism.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem prismHendecagonalPrism_nu_system_0_oneRoot : prismHendecagonalPrism_nu_system_0.HasUniqueRoot :=
  prismHendecagonalPrism_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Prism.HendecagonalPrism.polyhedron`, by roots**: `ν Prism.HendecagonalPrism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `prismHendecagonalPrism_nu_system_<j>`. -/
theorem prismHendecagonalPrism_nu_roots :
    ν Prism.HendecagonalPrism.polyhedron ∈ Set.Icc ((1004386372860925187826928417016 : ℝ) / 10 ^ 30) ((1004386372860925187826928417017 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Prism.HendecagonalPrism.polyhedron) :=
  ⟨prismHendecagonalPrism_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) prismHendecagonalPrism_nu_roots_list⟩

end

