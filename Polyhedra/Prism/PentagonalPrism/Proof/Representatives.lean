import Polyhedra.Prism.PentagonalPrism.Proof.Roots
import Modules.Root.Reps

set_option linter.style.longLine false

/-!
# One shared scale: `ν Prism.PentagonalPrism.polyhedron`

`prismPentagonalPrism_nu_shared_list`: **every system of `prismPentagonalPrism_nu_roots_list` has its one root at the scale
`ν Prism.PentagonalPrism.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `prismPentagonalPrism_nu_reps_list`:
the same for the same system, and `prismPentagonalPrism_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Prism.PentagonalPrism.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPrismPentagonalPrism`, `Nieuwland.Certs.NieuwlandPrismPentagonalPrism.Exact` and
`Nieuwland.Certs.NieuwlandPrismPentagonalPrism.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Prism.PentagonalPrism.polyhedron` has its one root at `ν Prism.PentagonalPrism.polyhedron`**: each of the systems of `prismPentagonalPrism_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem prismPentagonalPrism_nu_shared_list :
    PolynomialSystem.IsRootEq [prismPentagonalPrism_nu_system_0] Prism.PentagonalPrism.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton prismPentagonalPrism_nu_roots_list

/-- **The representatives of `ν Prism.PentagonalPrism.polyhedron`**: the same system, each with exactly one root, at the scale `ν Prism.PentagonalPrism.polyhedron`. -/
theorem prismPentagonalPrism_nu_reps_list :
    PolynomialSystem.IsRootEq [prismPentagonalPrism_nu_system_0] Prism.PentagonalPrism.polyhedron.nieuwland :=
  prismPentagonalPrism_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Prism.PentagonalPrism.polyhedron`, by representatives**: `ν Prism.PentagonalPrism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `prismPentagonalPrism_nu_reps_list`. -/
theorem prismPentagonalPrism_nu_reps :
    ν Prism.PentagonalPrism.polyhedron ∈ Set.Icc ((1013466507109677849770070380282 : ℝ) / 10 ^ 30) ((1013466507109677849770070380283 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Prism.PentagonalPrism.polyhedron) :=
  ⟨prismPentagonalPrism_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) prismPentagonalPrism_nu_reps_list⟩

end

end Nieuwland.Polyhedra
