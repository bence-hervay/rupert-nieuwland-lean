theorem par_ok : Root.RootBasis.parCheck (ZTheta Nieuwland.Polyhedra.PrismPentagonalPrismDim.root) touch.par = true := by
  decide +kernel

/-- The contacts of the record's duplicates and coincidences, whose identities check on the balls of the box (compiled evaluation: the identities' polynomials are expanded by well-founded recursion, which the kernel does not evaluate). -/
def zs : List (ℕ × ℕ × ℕ) := [(2, 3, 3), (7, 5, 6)]

theorem zs_eq : Root.Sys.zeroCons (ZTheta Nieuwland.Polyhedra.PrismPentagonalPrismDim.root) (touch.sys Nieuwland.Polyhedra.PrismPentagonalPrismDim.points) (touch.kraw Nieuwland.Polyhedra.PrismPentagonalPrismDim.points).boxBalls touch.W = zs := by
  native_decide

