import Polyhedra.Prism.TriangularPrism.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Prism.TriangularPrism.polyhedron`

`prismTriangularPrism_nu_system_<j>`: the systems of `prismTriangularPrism_exact` (`Nieuwland.Certs.NieuwlandPrismTriangularPrism.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`prismTriangularPrism_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Prism.TriangularPrism.polyhedron` is the largest scale among
those roots (`prismTriangularPrism_nu_roots_list`). `prismTriangularPrism_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `prismTriangularPrism_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`prismTriangularPrism_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPrismTriangularPrism` and `Nieuwland.Certs.NieuwlandPrismTriangularPrism.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Prism.TriangularPrism.polyhedron`: the equation `ℓ ^ 4 - 9 * ℓ ^ 2 + 9 = 0` with `ℓ` in the interval of the number's decimals (the system of `prismTriangularPrism_exact`). -/
noncomputable def prismTriangularPrism_nu_system_0 : PolynomialSystem :=
  ⟨[([(9, []), (1, [(0, 4)])],
     [(9, [(0, 2)])])],
   [(535233134659634897912954764569/500000000000000000000000000000, 1070466269319269795825909529139/1000000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Prism.TriangularPrism.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `prismTriangularPrism_nu_roots`. -/
theorem prismTriangularPrism_nu_roots_list :
    PolynomialSystem.IsRootMax [prismTriangularPrism_nu_system_0] Prism.TriangularPrism.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var prismTriangularPrism_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Prism.TriangularPrism.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem prismTriangularPrism_nu_system_0_oneRoot : prismTriangularPrism_nu_system_0.HasUniqueRoot :=
  prismTriangularPrism_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Prism.TriangularPrism.polyhedron`, by roots**: `ν Prism.TriangularPrism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `prismTriangularPrism_nu_system_<j>`. -/
theorem prismTriangularPrism_nu_roots :
    ν Prism.TriangularPrism.polyhedron ∈ Set.Icc ((1070466269319269795825909529138 : ℝ) / 10 ^ 30) ((1070466269319269795825909529139 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Prism.TriangularPrism.polyhedron) :=
  ⟨prismTriangularPrism_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) prismTriangularPrism_nu_roots_list⟩

end

end Nieuwland.Polyhedra
