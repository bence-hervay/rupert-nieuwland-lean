import Polyhedra.Prism.TriangularPrism.Proof.Roots
import Modules.Root.Reps

set_option linter.style.longLine false

/-!
# One shared scale: `ν Prism.TriangularPrism.polyhedron`

`prismTriangularPrism_nu_shared_list`: **every system of `prismTriangularPrism_nu_roots_list` has its one root at the scale
`ν Prism.TriangularPrism.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `prismTriangularPrism_nu_reps_list`:
the same for the same system, and `prismTriangularPrism_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Prism.TriangularPrism.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPrismTriangularPrism`, `Nieuwland.Certs.NieuwlandPrismTriangularPrism.Exact` and
`Nieuwland.Certs.NieuwlandPrismTriangularPrism.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Prism.TriangularPrism.polyhedron` has its one root at `ν Prism.TriangularPrism.polyhedron`**: each of the systems of `prismTriangularPrism_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem prismTriangularPrism_nu_shared_list :
    PolynomialSystem.IsRootEq [prismTriangularPrism_nu_system_0] Prism.TriangularPrism.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton prismTriangularPrism_nu_roots_list

/-- **The representatives of `ν Prism.TriangularPrism.polyhedron`**: the same system, each with exactly one root, at the scale `ν Prism.TriangularPrism.polyhedron`. -/
theorem prismTriangularPrism_nu_reps_list :
    PolynomialSystem.IsRootEq [prismTriangularPrism_nu_system_0] Prism.TriangularPrism.polyhedron.nieuwland :=
  prismTriangularPrism_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Prism.TriangularPrism.polyhedron`, by representatives**: `ν Prism.TriangularPrism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `prismTriangularPrism_nu_reps_list`. -/
theorem prismTriangularPrism_nu_reps :
    ν Prism.TriangularPrism.polyhedron ∈ Set.Icc ((1070466269319269795825909529138 : ℝ) / 10 ^ 30) ((1070466269319269795825909529139 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Prism.TriangularPrism.polyhedron) :=
  ⟨prismTriangularPrism_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) prismTriangularPrism_nu_reps_list⟩

end

end Nieuwland.Polyhedra
