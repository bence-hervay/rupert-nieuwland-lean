    by decide +kernel⟩

/-- `3 √3` in the lift (`sqrt_ok`). -/
def sqrtD : (ZTheta root) :=
  ⟨[0, 6, 0, -1]⟩

theorem sqrt_ok : sqrtOk 3 3 sqrtD = true := by
  decide +kernel

/-- The points of the solid as exact values of the lift, times 18. -/
def points : List (V3 (ZTheta root)) :=
  [⟨⟨[0, 12, 0, -2]⟩, ⟨[0]⟩, ⟨[-9]⟩⟩, ⟨⟨[0, -6, 0, 1]⟩, ⟨[9]⟩, ⟨[-9]⟩⟩, ⟨⟨[0, -6, 0, 1]⟩, ⟨[-9]⟩, ⟨[-9]⟩⟩, ⟨⟨[0, 12, 0, -2]⟩, ⟨[0]⟩, ⟨[9]⟩⟩, ⟨⟨[0, -6, 0, 1]⟩, ⟨[9]⟩, ⟨[9]⟩⟩, ⟨⟨[0, -6, 0, 1]⟩, ⟨[-9]⟩, ⟨[9]⟩⟩]

/-- The lift's points are the far field's under the embedding of `ℤ[√3]` (`ZSqrt.embed`), up to
the integer factors `1` and `1`. -/
theorem lift_ok : liftOk (ZSqrt.embed (d := 3) 3 sqrtD) 1 1 Nieuwland.Polyhedra.PrismTriangularPrismDim.points points = true := by
  decide +kernel

theorem points_eq : Polyhedron.ofPoints points = (Polyhedron.ofPoints Nieuwland.Polyhedra.PrismTriangularPrismDim.points).smul (((1 : ℕ) : ℝ) * ((3 : ℕ) : ℝ) / ((1 : ℕ) : ℝ)) :=
  ofPoints_of_liftOk (ZSqrt.re_embed sqrt_ok) lift_ok

/-- The fit, with the hole polygon. -/
def fit : FitData (ZTheta root) :=
  { view := 2
    D := ⟨[3]⟩
    S := ⟨[0, -9, 0, 1]⟩
    T := ⟨[0, 0, -1]⟩
    rot := 3
    q := ⟨⟨[48, -12, -12, 3]⟩,
      ⟨[9, -27, -5, 4]⟩,
      ⟨[9, -27, -5, 4]⟩,
      ⟨[33]⟩⟩
    τ₀ := ⟨[0, -6, 0, 1]⟩
    τ₁ := ⟨[-9, 0, 6]⟩
    E := ⟨[1]⟩
    corners := [2, 5, 3, 4, 1] }

/-- The weak fit at the exact scale, with an interior witness. -/
def weak : WeakFitData (ZTheta root) :=
  { fit := fit
    scaleNum := ⟨[0, 1]⟩
    scaleDen := 1
    h₀ := ⟨[0, 15, 0, -1]⟩
    h₁ := ⟨[0, 0, 3]⟩
    H := ⟨[5]⟩ }

theorem weak_check : weak.check points = true := by
  decide +kernel

/-- The representatives' system (`prismTriangularPrism_nu_reps_list`). -/
noncomputable def reps : PolynomialSystem :=
  ⟨[([(9, []), (1, [(0, 4)])],
     [(9, [(0, 2)])])],
   [(535233134659634897912954764569/500000000000000000000000000000, 1070466269319269795825909529139/1000000000000000000000000000000)]⟩

/-- `α`'s interval: the root's enclosure. -/
def I : ℚ × ℚ := (, )

/-- The intervals of `s, t, q₀, …, q₃, τ₀, τ₁`. -/
def B₁ : List (ℚ × ℚ) := [(-28025170769/10000000000, -1751573173/625000000), (-3819660113/10000000000, -238728757/625000000), (250835639427/10000000000, 62708909857/2500000000), (-51813746669/2500000000, -8290199467/400000000), (-51813746669/2500000000, -8290199467/400000000), (33, 33), (-1443375673/5000000000, -577350269/2000000000), (-73771243/625000000, -1180339887/10000000000)]

/-- The intervals of the pose's twenty variables. -/
def B₃ : List (ℚ × ℚ) := [(0, 1), (0, 0), (0, 28025170769/10000000000), (-2140932539/2000000000, 0), (0, 5533813729/625000000), (0, 3819660113/10000000000), (-28025170769/10000000000, 0), (-3819660113/10000000000, 0), (0, 1), (-53520615152731/10000000000, 39726170554841/10000000000), (-2100729005217/250000000, 4295462950207/5000000000), (-12038108271103/2500000000, 24076216542149/5000000000), (-16558211123909/10000000000, 242872914052297/10000000000), (-152846230168077/10000000000, 111462896374071/10000000000), (-124395189514451/10000000000, 62197594759371/5000000000), (-52954906661331/10000000000, 52954906660091/10000000000), (-52196427470203/10000000000, 26098213735157/5000000000), (-12562374501747/10000000000, 89880707605613/10000000000), (-1443375673/5000000000, 0), (-2612712431/2500000000, 618033989/2000000000)]

/-- The quotients of `S₀`'s equations at `ℓ = λ(α)` by `α`'s polynomial. -/
def quot : List RationalPolynomial := [[(1, [])]]

/-- The lift's points to the polyhedron's. -/
def kappa : ℚ := 1/18

/-- The system (`Polynomials.lean`). -/
noncomputable abbrev S : PolynomialSystem := Prism.TriangularPrism.system

theorem ok : cfOk reps root weak kappa I B₁ B₃ quot = true := by
  decide +kernel

theorem S_eq : S = cfSystem reps root weak kappa I B₁ B₃ := by
  decide +kernel

theorem poly_eq : Prism.TriangularPrism.polyhedron = (Polyhedron.ofPoints points).smul ((kappa : ℚ) : ℝ) := by
  rw [Nieuwland.Polyhedra.PrismTriangularPrismDim.eq_smul, points_eq, Polyhedron.smul_smul_eq]
  congr 1
  norm_num [kappa]

end Nieuwland.Pose.PrismTriangularPrism

namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Prism.TriangularPrism.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Prism.TriangularPrism.polyhedron` scaled by `N` through itself. -/
theorem prismTriangularPrism_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.PrismTriangularPrism.reps] N) :
    PolynomialSystem.IsPoseRoot Prism.TriangularPrism.polyhedron Pose.PrismTriangularPrism.S N 22 13 31 := by
  rw [Pose.PrismTriangularPrism.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.PrismTriangularPrism.weak_check Pose.PrismTriangularPrism.poly_eq Pose.PrismTriangularPrism.ok

end Nieuwland.Polyhedra
