import Polyhedra.Prism.DodecagonalPrism.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Prism.DodecagonalPrism.polyhedron`

`prismDodecagonalPrism_nu_system_<j>`: the systems of `prismDodecagonalPrism_exact` (`Nieuwland.Certs.NieuwlandPrismDodecagonalPrism.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`prismDodecagonalPrism_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Prism.DodecagonalPrism.polyhedron` is the largest scale among
those roots (`prismDodecagonalPrism_nu_roots_list`). `prismDodecagonalPrism_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `prismDodecagonalPrism_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`prismDodecagonalPrism_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPrismDodecagonalPrism` and `Nieuwland.Certs.NieuwlandPrismDodecagonalPrism.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Prism.DodecagonalPrism.polyhedron`: the equation `32 * ℓ ^ 4 - 32 * ℓ ^ 3 + 72 * ℓ ^ 2 + 112 * ℓ - 193 = 0` with `ℓ` in the interval of the number's decimals (the system of `prismDodecagonalPrism_exact`). -/
noncomputable def prismDodecagonalPrism_nu_system_0 : PolynomialSystem :=
  ⟨[([(112, [(0, 1)]), (72, [(0, 2)]), (32, [(0, 4)])],
     [(193, []), (32, [(0, 3)])])],
   [(206138161717707776185244789169/200000000000000000000000000000, 515345404294269440463111972923/500000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Prism.DodecagonalPrism.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `prismDodecagonalPrism_nu_roots`. -/
theorem prismDodecagonalPrism_nu_roots_list :
    PolynomialSystem.IsRootMax [prismDodecagonalPrism_nu_system_0] Prism.DodecagonalPrism.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var prismDodecagonalPrism_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Prism.DodecagonalPrism.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem prismDodecagonalPrism_nu_system_0_oneRoot : prismDodecagonalPrism_nu_system_0.HasUniqueRoot :=
  prismDodecagonalPrism_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Prism.DodecagonalPrism.polyhedron`, by roots**: `ν Prism.DodecagonalPrism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `prismDodecagonalPrism_nu_system_<j>`. -/
theorem prismDodecagonalPrism_nu_roots :
    ν Prism.DodecagonalPrism.polyhedron ∈ Set.Icc ((1030690808588538880926223945845 : ℝ) / 10 ^ 30) ((1030690808588538880926223945846 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Prism.DodecagonalPrism.polyhedron) :=
  ⟨prismDodecagonalPrism_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) prismDodecagonalPrism_nu_roots_list⟩

end

end Nieuwland.Polyhedra
