import Modules.Root.Reps

set_option linter.style.longLine false

/-!
# One shared scale: `ν Prism.EnneagonalPrism.polyhedron`

`prismEnneagonalPrism_nu_shared_list`: **every system of `prismEnneagonalPrism_nu_roots_list` has its one root at the scale
`ν Prism.EnneagonalPrism.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): links from root 0 reach each of the roots 0, 1. `prismEnneagonalPrism_nu_reps_list`:
the same for the system of root 0 alone (one picture class: the roots {0, 1}), and `prismEnneagonalPrism_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Prism.EnneagonalPrism.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). The roots' scales are shown equal by links (`Root.linkGroupsOk`, evaluated by compiled code in `Nieuwland.Certs.NieuwlandPrismEnneagonalPrism.links_ok`): isometries of the solid that take one root's contacts onto another's give a pose map taking the first root's zero to a zero of the other's system inside the other's Krawczyk box, where its zero is unique (`Root.scale_eq_of_linksOk`, `Modules/Root/LinkCheck.lean`; `Root.isRootEq_of_links`, `Modules/Root/Reps.lean`). The representatives are the first root of each class of roots whose pictures (the hole's silhouette and the placed plug's) are congruent: a fact of the data measured in floating point (`lean/scripts/links.py`), not a theorem; the links show the scales equal either way.
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPrismEnneagonalPrism`, `Nieuwland.Certs.NieuwlandPrismEnneagonalPrism.Exact` and
`Nieuwland.Certs.NieuwlandPrismEnneagonalPrism.Roots`, which it does not change.
-/

namespace Nieuwland.Certs.NieuwlandPrismEnneagonalPrism

open Nieuwland

/-- The link from root 0 to root 1 (`Root.LinkRec`): per contact its image, the flips, the antipodes, and the frames of the hole's and the plug's isometries. -/
def link_0_1 : Root.LinkRec :=
  ⟨[2, 0, 1, 4, 5, 3], [true, true, true, true, true, true], [false, false, false, false, false, false], [(3, 8), (4, 7), (7, 4), (9, 11)], 0, [(3, 7), (4, 8), (8, 3), (12, 16)], 0⟩

/-- **The links' checks** (`Root.linkGroupsOk`, `Modules/Root/Reps.lean`): each link's isometries and contacts, and the image of its source root's zero inside its target's box; compiled code evaluates it, and `links_ok` rests on the axiom that `native_decide` records for it. -/
theorem links_ok :
    Root.linkGroupsOk points [touch0, touch1] touch0 [0]
      [(0, [(1, link_0_1)])] = true := by
  native_decide

end Nieuwland.Certs.NieuwlandPrismEnneagonalPrism

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Prism.EnneagonalPrism.polyhedron` has its one root at `ν Prism.EnneagonalPrism.polyhedron`**: each of the systems of `prismEnneagonalPrism_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem prismEnneagonalPrism_nu_shared_list :
    PolynomialSystem.IsRootEq [prismEnneagonalPrism_nu_system_0, prismEnneagonalPrism_nu_system_1] Prism.EnneagonalPrism.polyhedron.nieuwland :=
  Root.isRootEq_of_links (F := (Root.ParData.theta Nieuwland.Certs.NieuwlandPrismEnneagonalPrism.root)) (Root.ParData.theta_spec Nieuwland.Certs.NieuwlandPrismEnneagonalPrism.root)
    (Root.ParData.theta_unique Nieuwland.Certs.NieuwlandPrismEnneagonalPrism.root) (by decide)
    (fun _ h ↦ Root.ok_of_certOk Nieuwland.Certs.NieuwlandPrismEnneagonalPrism.touch_ok h) prismEnneagonalPrism_nu_roots_list [0, 1]
    (.cons prismEnneagonalPrism_nu_system_0_of (.cons prismEnneagonalPrism_nu_system_1_of .nil))
    _ Nieuwland.Certs.NieuwlandPrismEnneagonalPrism.links_ok (by decide) (by simp) (fun _ h ↦ h)

/-- **The representatives of `ν Prism.EnneagonalPrism.polyhedron`**: the system of root 0 alone (one picture class: the roots {0, 1}), each with exactly one root, at the scale `ν Prism.EnneagonalPrism.polyhedron`. -/
theorem prismEnneagonalPrism_nu_reps_list :
    PolynomialSystem.IsRootEq [prismEnneagonalPrism_nu_system_0] Prism.EnneagonalPrism.polyhedron.nieuwland :=
  prismEnneagonalPrism_nu_shared_list.sub (by simp) (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Prism.EnneagonalPrism.polyhedron`, by representatives**: `ν Prism.EnneagonalPrism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `prismEnneagonalPrism_nu_reps_list`. -/
theorem prismEnneagonalPrism_nu_reps :
    ν Prism.EnneagonalPrism.polyhedron ∈ Set.Icc ((1005458714564326396569064680313 : ℝ) / 10 ^ 30) ((1005458714564326396569064680314 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Prism.EnneagonalPrism.polyhedron) :=
  ⟨prismEnneagonalPrism_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) prismEnneagonalPrism_nu_reps_list⟩

end

end Nieuwland.Polyhedra
