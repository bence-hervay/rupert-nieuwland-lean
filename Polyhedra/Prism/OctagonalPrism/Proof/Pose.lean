/-- The lift's points are the far field's under the embedding of `ℤ[√2]` (`ZSqrt.embed`), up to
the integer factors `1` and `1`. -/
theorem lift_ok : liftOk (ZSqrt.embed (d := 2) 14 sqrtD) 1 1 Nieuwland.Polyhedra.PrismOctagonalPrismDim.points points = true := by
  decide +kernel

theorem points_eq : Polyhedron.ofPoints points = (Polyhedron.ofPoints Nieuwland.Polyhedra.PrismOctagonalPrismDim.points).smul (((1 : ℕ) : ℝ) * ((14 : ℕ) : ℝ) / ((1 : ℕ) : ℝ)) :=
  ofPoints_of_liftOk (ZSqrt.re_embed sqrt_ok) lift_ok

