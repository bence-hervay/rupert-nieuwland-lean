/-- The system (`Polynomials.lean`). -/
noncomputable abbrev S : PolynomialSystem := Prism.OctagonalPrism.system

theorem ok : cfOk reps root weak kappa I B₁ B₃ quot = true := by
  decide +kernel

theorem S_eq : S = cfSystem reps root weak kappa I B₁ B₃ := by
  decide +kernel

theorem poly_eq : Prism.OctagonalPrism.polyhedron = (Polyhedron.ofPoints points).smul ((kappa : ℚ) : ℝ) := by
  rw [Nieuwland.Polyhedra.PrismOctagonalPrismDim.eq_smul, points_eq, Polyhedron.smul_smul_eq]
  congr 1
  norm_num [kappa]

end Nieuwland.Pose.PrismOctagonalPrism

namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Prism.OctagonalPrism.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Prism.OctagonalPrism.polyhedron` scaled by `N` through itself. -/
theorem prismOctagonalPrism_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.PrismOctagonalPrism.reps] N) :
    PolynomialSystem.IsPoseRoot Prism.OctagonalPrism.polyhedron Pose.PrismOctagonalPrism.S N 22 13 31 := by
  rw [Pose.PrismOctagonalPrism.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.PrismOctagonalPrism.weak_check Pose.PrismOctagonalPrism.poly_eq Pose.PrismOctagonalPrism.ok

end Nieuwland.Polyhedra
