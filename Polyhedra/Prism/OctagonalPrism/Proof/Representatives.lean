import Polyhedra.Prism.OctagonalPrism.Proof.Roots
import Modules.Root.Reps

set_option linter.style.longLine false

/-!
# One shared scale: `ν Prism.OctagonalPrism.polyhedron`

`prismOctagonalPrism_nu_shared_list`: **every system of `prismOctagonalPrism_nu_roots_list` has its one root at the scale
`ν Prism.OctagonalPrism.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `prismOctagonalPrism_nu_reps_list`:
the same for the same system, and `prismOctagonalPrism_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Prism.OctagonalPrism.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPrismOctagonalPrism`, `Nieuwland.Certs.NieuwlandPrismOctagonalPrism.Exact` and
`Nieuwland.Certs.NieuwlandPrismOctagonalPrism.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Prism.OctagonalPrism.polyhedron` has its one root at `ν Prism.OctagonalPrism.polyhedron`**: each of the systems of `prismOctagonalPrism_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem prismOctagonalPrism_nu_shared_list :
    PolynomialSystem.IsRootEq [prismOctagonalPrism_nu_system_0] Prism.OctagonalPrism.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton prismOctagonalPrism_nu_roots_list

/-- **The representatives of `ν Prism.OctagonalPrism.polyhedron`**: the same system, each with exactly one root, at the scale `ν Prism.OctagonalPrism.polyhedron`. -/
theorem prismOctagonalPrism_nu_reps_list :
    PolynomialSystem.IsRootEq [prismOctagonalPrism_nu_system_0] Prism.OctagonalPrism.polyhedron.nieuwland :=
  prismOctagonalPrism_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Prism.OctagonalPrism.polyhedron`, by representatives**: `ν Prism.OctagonalPrism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `prismOctagonalPrism_nu_reps_list`. -/
theorem prismOctagonalPrism_nu_reps :
    ν Prism.OctagonalPrism.polyhedron ∈ Set.Icc ((1059619101218428896564535253241 : ℝ) / 10 ^ 30) ((1059619101218428896564535253242 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Prism.OctagonalPrism.polyhedron) :=
  ⟨prismOctagonalPrism_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) prismOctagonalPrism_nu_reps_list⟩

end

end Nieuwland.Polyhedra
