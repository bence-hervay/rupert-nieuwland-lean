set_option linter.style.longLine false

/-!
# One shared scale: `ν Prism.DecagonalPrism.polyhedron`

`prismDecagonalPrism_nu_shared_list`: **every system of `prismDecagonalPrism_nu_roots_list` has its one root at the scale
`ν Prism.DecagonalPrism.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `prismDecagonalPrism_nu_reps_list`:
the same for the same system, and `prismDecagonalPrism_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Prism.DecagonalPrism.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPrismDecagonalPrism`, `Nieuwland.Certs.NieuwlandPrismDecagonalPrism.Exact` and
`Nieuwland.Certs.NieuwlandPrismDecagonalPrism.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Prism.DecagonalPrism.polyhedron` has its one root at `ν Prism.DecagonalPrism.polyhedron`**: each of the systems of `prismDecagonalPrism_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem prismDecagonalPrism_nu_shared_list :
    PolynomialSystem.IsRootEq [prismDecagonalPrism_nu_system_0] Prism.DecagonalPrism.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton prismDecagonalPrism_nu_roots_list

/-- **The representatives of `ν Prism.DecagonalPrism.polyhedron`**: the same system, each with exactly one root, at the scale `ν Prism.DecagonalPrism.polyhedron`. -/
theorem prismDecagonalPrism_nu_reps_list :
    PolynomialSystem.IsRootEq [prismDecagonalPrism_nu_system_0] Prism.DecagonalPrism.polyhedron.nieuwland :=
  prismDecagonalPrism_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Prism.DecagonalPrism.polyhedron`, by representatives**: `ν Prism.DecagonalPrism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `prismDecagonalPrism_nu_reps_list`. -/
theorem prismDecagonalPrism_nu_reps :
    ν Prism.DecagonalPrism.polyhedron ∈ Set.Icc ((1042030336564058065843113417329 : ℝ) / 10 ^ 30) ((1042030336564058065843113417330 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Prism.DecagonalPrism.polyhedron) :=
  ⟨prismDecagonalPrism_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) prismDecagonalPrism_nu_reps_list⟩

end

end Nieuwland.Polyhedra
