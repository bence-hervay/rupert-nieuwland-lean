import Polyhedra.Prism.DecagonalPrism.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Prism.DecagonalPrism.polyhedron`

`prismDecagonalPrism_nu_system_<j>`: the systems of `prismDecagonalPrism_exact` (`Nieuwland.Certs.NieuwlandPrismDecagonalPrism.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`prismDecagonalPrism_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Prism.DecagonalPrism.polyhedron` is the largest scale among
those roots (`prismDecagonalPrism_nu_roots_list`). `prismDecagonalPrism_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `prismDecagonalPrism_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`prismDecagonalPrism_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPrismDecagonalPrism` and `Nieuwland.Certs.NieuwlandPrismDecagonalPrism.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Prism.DecagonalPrism.polyhedron`: the equation `80 * ℓ ^ 4 - 80 * ℓ ^ 3 - 160 * ℓ ^ 2 + 260 * ℓ - 101 = 0` with `ℓ` in the interval of the number's decimals (the system of `prismDecagonalPrism_exact`). -/
noncomputable def prismDecagonalPrism_nu_system_0 : PolynomialSystem :=
  ⟨[([(260, [(0, 1)]), (80, [(0, 4)])],
     [(101, []), (160, [(0, 2)]), (80, [(0, 3)])])],
   [(1042030336564058065843113417329/1000000000000000000000000000000, 104203033656405806584311341733/100000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Prism.DecagonalPrism.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `prismDecagonalPrism_nu_roots`. -/
theorem prismDecagonalPrism_nu_roots_list :
    PolynomialSystem.IsRootMax [prismDecagonalPrism_nu_system_0] Prism.DecagonalPrism.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var prismDecagonalPrism_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Prism.DecagonalPrism.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem prismDecagonalPrism_nu_system_0_oneRoot : prismDecagonalPrism_nu_system_0.HasUniqueRoot :=
  prismDecagonalPrism_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Prism.DecagonalPrism.polyhedron`, by roots**: `ν Prism.DecagonalPrism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `prismDecagonalPrism_nu_system_<j>`. -/
theorem prismDecagonalPrism_nu_roots :
    ν Prism.DecagonalPrism.polyhedron ∈ Set.Icc ((1042030336564058065843113417329 : ℝ) / 10 ^ 30) ((1042030336564058065843113417330 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Prism.DecagonalPrism.polyhedron) :=
  ⟨prismDecagonalPrism_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) prismDecagonalPrism_nu_roots_list⟩

end

end Nieuwland.Polyhedra
