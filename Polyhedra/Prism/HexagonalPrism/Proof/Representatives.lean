import Polyhedra.Prism.HexagonalPrism.Proof.Roots
import Modules.Root.Reps

set_option linter.style.longLine false

/-!
# One shared scale: `ν Prism.HexagonalPrism.polyhedron`

`prismHexagonalPrism_nu_shared_list`: **every system of `prismHexagonalPrism_nu_roots_list` has its one root at the scale
`ν Prism.HexagonalPrism.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `prismHexagonalPrism_nu_reps_list`:
the same for the same system, and `prismHexagonalPrism_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Prism.HexagonalPrism.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPrismHexagonalPrism`, `Nieuwland.Certs.NieuwlandPrismHexagonalPrism.Exact` and
`Nieuwland.Certs.NieuwlandPrismHexagonalPrism.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Prism.HexagonalPrism.polyhedron` has its one root at `ν Prism.HexagonalPrism.polyhedron`**: each of the systems of `prismHexagonalPrism_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem prismHexagonalPrism_nu_shared_list :
    PolynomialSystem.IsRootEq [prismHexagonalPrism_nu_system_0] Prism.HexagonalPrism.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton prismHexagonalPrism_nu_roots_list

/-- **The representatives of `ν Prism.HexagonalPrism.polyhedron`**: the same system, each with exactly one root, at the scale `ν Prism.HexagonalPrism.polyhedron`. -/
theorem prismHexagonalPrism_nu_reps_list :
    PolynomialSystem.IsRootEq [prismHexagonalPrism_nu_system_0] Prism.HexagonalPrism.polyhedron.nieuwland :=
  prismHexagonalPrism_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Prism.HexagonalPrism.polyhedron`, by representatives**: `ν Prism.HexagonalPrism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `prismHexagonalPrism_nu_reps_list`. -/
theorem prismHexagonalPrism_nu_reps :
    ν Prism.HexagonalPrism.polyhedron ∈ Set.Icc ((1083333333333333333333333333333 : ℝ) / 10 ^ 30) ((1083333333333333333333333333334 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Prism.HexagonalPrism.polyhedron) :=
  ⟨prismHexagonalPrism_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) prismHexagonalPrism_nu_reps_list⟩

end

end Nieuwland.Polyhedra
