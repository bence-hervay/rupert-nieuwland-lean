/-- The system (`Polynomials.lean`). -/
noncomputable abbrev S : PolynomialSystem := Prism.HexagonalPrism.system

theorem ok : cfOk reps root weak kappa I B₁ B₃ quot = true := by
  decide +kernel

theorem S_eq : S = cfSystem reps root weak kappa I B₁ B₃ := by
  decide +kernel

theorem poly_eq : Prism.HexagonalPrism.polyhedron = (Polyhedron.ofPoints points).smul ((kappa : ℚ) : ℝ) := by
  rw [Nieuwland.Polyhedra.PrismHexagonalPrismDim.eq_smul, points_eq, Polyhedron.smul_smul_eq]
  congr 1
  norm_num [kappa]

end Nieuwland.Pose.PrismHexagonalPrism

namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Prism.HexagonalPrism.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Prism.HexagonalPrism.polyhedron` scaled by `N` through itself. -/
theorem prismHexagonalPrism_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.PrismHexagonalPrism.reps] N) :
    PolynomialSystem.IsPoseRoot Prism.HexagonalPrism.polyhedron Pose.PrismHexagonalPrism.S N 22 13 31 := by
  rw [Pose.PrismHexagonalPrism.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.PrismHexagonalPrism.weak_check Pose.PrismHexagonalPrism.poly_eq Pose.PrismHexagonalPrism.ok

end Nieuwland.Polyhedra
