theorem sqrt_ok : sqrtOk 3 12 sqrtD = true := by
  decide +kernel

/-- The points of the solid as exact values of the lift, times 24. -/
def points : List (V3 (ZTheta root)) :=
  [⟨⟨[24]⟩, ⟨[0]⟩, ⟨[12]⟩⟩, ⟨⟨[24]⟩, ⟨[0]⟩, ⟨[-12]⟩⟩, ⟨⟨[-24]⟩, ⟨[0]⟩, ⟨[12]⟩⟩, ⟨⟨[-24]⟩, ⟨[0]⟩, ⟨[-12]⟩⟩, ⟨⟨[12]⟩, ⟨[13, 1]⟩, ⟨[12]⟩⟩, ⟨⟨[12]⟩, ⟨[13, 1]⟩, ⟨[-12]⟩⟩, ⟨⟨[12]⟩, ⟨[-13, -1]⟩, ⟨[12]⟩⟩, ⟨⟨[12]⟩, ⟨[-13, -1]⟩, ⟨[-12]⟩⟩, ⟨⟨[-12]⟩, ⟨[13, 1]⟩, ⟨[12]⟩⟩, ⟨⟨[-12]⟩, ⟨[13, 1]⟩, ⟨[-12]⟩⟩, ⟨⟨[-12]⟩, ⟨[-13, -1]⟩, ⟨[12]⟩⟩, ⟨⟨[-12]⟩, ⟨[-13, -1]⟩, ⟨[-12]⟩⟩]

/-- The lift's points are the far field's under the embedding of `ℤ[√3]` (`ZSqrt.embed`), up to
the integer factors `1` and `1`. -/
theorem lift_ok : liftOk (ZSqrt.embed (d := 3) 12 sqrtD) 1 1 Nieuwland.Polyhedra.PrismHexagonalPrismDim.points points = true := by
  decide +kernel

theorem points_eq : Polyhedron.ofPoints points = (Polyhedron.ofPoints Nieuwland.Polyhedra.PrismHexagonalPrismDim.points).smul (((1 : ℕ) : ℝ) * ((12 : ℕ) : ℝ) / ((1 : ℕ) : ℝ)) :=
  ofPoints_of_liftOk (ZSqrt.re_embed sqrt_ok) lift_ok

/-- The fit, with the hole polygon. -/
