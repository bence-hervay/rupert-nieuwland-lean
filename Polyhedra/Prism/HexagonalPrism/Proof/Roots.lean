import Polyhedra.Prism.HexagonalPrism.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Prism.HexagonalPrism.polyhedron`

`prismHexagonalPrism_nu_system_<j>`: the systems of `prismHexagonalPrism_exact` (`Nieuwland.Certs.NieuwlandPrismHexagonalPrism.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`prismHexagonalPrism_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Prism.HexagonalPrism.polyhedron` is the largest scale among
those roots (`prismHexagonalPrism_nu_roots_list`). `prismHexagonalPrism_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `prismHexagonalPrism_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`prismHexagonalPrism_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPrismHexagonalPrism` and `Nieuwland.Certs.NieuwlandPrismHexagonalPrism.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Prism.HexagonalPrism.polyhedron`: the equation `12 * ℓ - 13 = 0` with `ℓ` in the interval of the number's decimals (the system of `prismHexagonalPrism_exact`). -/
noncomputable def prismHexagonalPrism_nu_system_0 : PolynomialSystem :=
  ⟨[([(12, [(0, 1)])],
     [(13, [])])],
   [(1083333333333333333333333333333/1000000000000000000000000000000, 541666666666666666666666666667/500000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Prism.HexagonalPrism.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `prismHexagonalPrism_nu_roots`. -/
theorem prismHexagonalPrism_nu_roots_list :
    PolynomialSystem.IsRootMax [prismHexagonalPrism_nu_system_0] Prism.HexagonalPrism.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var prismHexagonalPrism_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Prism.HexagonalPrism.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem prismHexagonalPrism_nu_system_0_oneRoot : prismHexagonalPrism_nu_system_0.HasUniqueRoot :=
  prismHexagonalPrism_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Prism.HexagonalPrism.polyhedron`, by roots**: `ν Prism.HexagonalPrism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `prismHexagonalPrism_nu_system_<j>`. -/
theorem prismHexagonalPrism_nu_roots :
    ν Prism.HexagonalPrism.polyhedron ∈ Set.Icc ((1083333333333333333333333333333 : ℝ) / 10 ^ 30) ((1083333333333333333333333333334 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Prism.HexagonalPrism.polyhedron) :=
  ⟨prismHexagonalPrism_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) prismHexagonalPrism_nu_roots_list⟩

end

end Nieuwland.Polyhedra
