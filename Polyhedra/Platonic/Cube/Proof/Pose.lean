/-!
# Pose root of `Platonic.Cube.polyhedron`

ν and one optimal pose of `Platonic.Cube.polyhedron` (`fixtures/nieuwland/platonic/cube`) as the one root of a system, downstream of the representatives' theorem `platonicCube_nu_reps_list` (a closed form). The weak fit at `ν` is the exact record's over the lift `ℤ[α]` (`rupert-lean-export lift-weak`), checked by the kernel (`weak_check`); the lift's points are the solid's `Dim` points (`points_eq`). The system `S` is `cfSystem` (`Modules/Pose/PoseCheck.lean`): `x 0 = ℓ`, `x 1 = α`, the pose's chart coordinates `x 2, …, x 9`, three helpers, `R₂ = matAt x 13`, `R₁ = matAt x 22`, `t = (x 31, x 32)`. Generated by `lean/scripts/poseroot.py`.
-/

namespace Nieuwland.Pose.PlatonicCube

open Check PolynomialSystem

/-- The lift's root. -/
def root : Root :=
  ⟨[-9/8, 0, 1], 0, 4,
    4, [-18, 0, 1],
    16, 66, 69, 256, 18,
    13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084096,
    56884511448655060360995158733912955560507250464187979182754660010303913820868844948772734370444524398041598543685078695744409903429447863902622454443207796,
    56884511448655060360995158733912955560507250464187979182754660010303913820868844948772734370444524398041598543685078695744409903429447863902622454443207797,
    by decide +kernel⟩

/-- The far field's points as exact values of the lift. -/
def points : List (V3 (ZTheta root)) :=
  liftPts (ZTheta root) Nieuwland.Polyhedra.PlatonicCubeDim.points

theorem points_eq : Polyhedron.ofPoints points = Polyhedron.ofPoints Nieuwland.Polyhedra.PlatonicCubeDim.points :=
  ofPoints_liftPts _ _

/-- The fit, with the hole polygon. -/
def fit : FitData (ZTheta root) :=
  { view := 1
    D := ⟨[2]⟩
    S := ⟨[1]⟩
    T := ⟨[2]⟩
    rot := 3
    q := ⟨⟨[9, -1]⟩,
      ⟨[-3, 5]⟩,
      ⟨[-3, -2]⟩,
      ⟨[21]⟩⟩
    τ₀ := ⟨[0]⟩
    τ₁ := ⟨[0]⟩
    E := ⟨[1]⟩
    corners := [2, 3, 1, 5, 4, 6] }

/-- The weak fit at the exact scale, with an interior witness. -/
def weak : WeakFitData (ZTheta root) :=
  { fit := fit
    scaleNum := ⟨[0, 1]⟩
    scaleDen := 4
    h₀ := ⟨[0]⟩
    h₁ := ⟨[0]⟩
    H := ⟨[1]⟩ }

theorem weak_check : weak.check points = true := by
  decide +kernel

/-- The representatives' system (`platonicCube_nu_reps_list`). -/
noncomputable def reps : PolynomialSystem :=
  ⟨[([(8, [(0, 2)])],
     [(9, [])])],
   [(1060660171779821286601266543157/1000000000000000000000000000000, 530330085889910643300633271579/500000000000000000000000000000)]⟩

/-- `α`'s interval: the root's enclosure. -/
def I : ℚ × ℚ := (, )

/-- The intervals of `s, t, q₀, …, q₃, τ₀, τ₁`. -/
def B₁ : List (ℚ × ℚ) := [(1/2, 1/2), (1, 1), (5946699141/1250000000, 47573593129/10000000000), (36426406871/2000000000, 45533008589/2500000000), (-114852813743/10000000000, -57426406871/5000000000), (21, 21), (0, 0), (0, 0)]

/-- The intervals of the pose's twenty variables. -/
def B₃ : List (ℚ × ℚ) := [(0, 0), (-1/2, 0), (0, 1), (0, 5/4), (-1, 0), (-1/2, 0), (0, 1), (0, 1), (0, 1/2), (-999045455709/10000000000, 10834175310951/10000000000), (-5596538956601/10000000000, 223861558263/400000000), (-2318162338167/5000000000, 1582940258949/2000000000), (-13530655839053/10000000000, 4306545455719/5000000000), (-5069558441257/5000000000, 10139116882469/10000000000), (-3684152595843/10000000000, 3687369475741/2000000000), (-4956396103087/5000000000, 9912792206153/10000000000), (-2040110389699/1250000000, 241190908861/1000000000), (-9967707781161/10000000000, 9967707781113/10000000000), (0, 0), (0, 0)]

/-- The quotients of `S₀`'s equations at `ℓ = λ(α)` by `α`'s polynomial. -/
def quot : List RationalPolynomial := [[(1/2, [])]]

/-- The lift's points to the polyhedron's. -/
def kappa : ℚ := 1

/-- The system (`Polynomials.lean`). -/
noncomputable abbrev S : PolynomialSystem := Platonic.Cube.system

theorem ok : cfOk reps root weak kappa I B₁ B₃ quot = true := by
  decide +kernel

theorem S_eq : S = cfSystem reps root weak kappa I B₁ B₃ := by
  decide +kernel

theorem poly_eq : Platonic.Cube.polyhedron = (Polyhedron.ofPoints points).smul ((kappa : ℚ) : ℝ) := by
  rw [Nieuwland.Polyhedra.PlatonicCubeDim.eq_smul, points_eq]
  congr 1
  norm_num [kappa]

end Nieuwland.Pose.PlatonicCube

namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Platonic.Cube.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Platonic.Cube.polyhedron` scaled by `N` through itself. -/
theorem platonicCube_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.PlatonicCube.reps] N) :
    PolynomialSystem.IsPoseRoot Platonic.Cube.polyhedron Pose.PlatonicCube.S N 22 13 31 := by
  rw [Pose.PlatonicCube.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.PlatonicCube.weak_check Pose.PlatonicCube.poly_eq Pose.PlatonicCube.ok

end Nieuwland.Polyhedra
