import Polyhedra.Platonic.Cube.Proof.Roots
import Modules.Root.Reps

set_option linter.style.longLine false

/-!
# One shared scale: `ν Platonic.Cube.polyhedron`

`platonicCube_nu_shared_list`: **every system of `platonicCube_nu_roots_list` has its one root at the scale
`ν Platonic.Cube.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `platonicCube_nu_reps_list`:
the same for the same system, and `platonicCube_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Platonic.Cube.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPlatonicCube`, `Nieuwland.Certs.NieuwlandPlatonicCube.Exact` and
`Nieuwland.Certs.NieuwlandPlatonicCube.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Platonic.Cube.polyhedron` has its one root at `ν Platonic.Cube.polyhedron`**: each of the systems of `platonicCube_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem platonicCube_nu_shared_list :
    PolynomialSystem.IsRootEq [platonicCube_nu_system_0] Platonic.Cube.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton platonicCube_nu_roots_list

/-- **The representatives of `ν Platonic.Cube.polyhedron`**: the same system, each with exactly one root, at the scale `ν Platonic.Cube.polyhedron`. -/
theorem platonicCube_nu_reps_list :
    PolynomialSystem.IsRootEq [platonicCube_nu_system_0] Platonic.Cube.polyhedron.nieuwland :=
  platonicCube_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Platonic.Cube.polyhedron`, by representatives**: `ν Platonic.Cube.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `platonicCube_nu_reps_list`. -/
theorem platonicCube_nu_reps :
    ν Platonic.Cube.polyhedron ∈ Set.Icc ((1060660171779821286601266543157 : ℝ) / 10 ^ 30) ((1060660171779821286601266543158 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Platonic.Cube.polyhedron) :=
  ⟨platonicCube_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) platonicCube_nu_reps_list⟩

end

end Nieuwland.Polyhedra
