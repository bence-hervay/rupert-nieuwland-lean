/-- The blocks of 14 points cover the points. -/
theorem weak_check : weak.check points = true :=
  weak.check_of_blocks (k := 14) (nb := 2) (by decide +kernel) weak_head fun c hc ↦
    match c, hc with
    | 0, _ => weak_block0
    | 1, _ => weak_block1
    | _ + 2, h => absurd h (by omega)

