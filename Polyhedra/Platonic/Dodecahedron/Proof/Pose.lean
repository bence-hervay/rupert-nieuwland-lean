namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Platonic.Dodecahedron.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Platonic.Dodecahedron.polyhedron` scaled by `N` through itself. -/
theorem platonicDodecahedron_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.PlatonicDodecahedron.reps] N) :
    PolynomialSystem.IsPoseRoot Platonic.Dodecahedron.polyhedron Pose.PlatonicDodecahedron.S N 22 13 31 := by
  rw [Pose.PlatonicDodecahedron.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.PlatonicDodecahedron.weak_check Pose.PlatonicDodecahedron.poly_eq Pose.PlatonicDodecahedron.ok

end Nieuwland.Polyhedra
