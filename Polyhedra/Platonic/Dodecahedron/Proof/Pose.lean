theorem weak_head : weak.checkHead points = true := by
  decide +kernel

theorem weak_block0 : weak.checkBlock points (0 * 14) 14 = true := by
  decide +kernel

theorem weak_block1 : weak.checkBlock points (1 * 14) 14 = true := by
