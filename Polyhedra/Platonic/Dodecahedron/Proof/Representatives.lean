import Polyhedra.Platonic.Dodecahedron.Proof.Roots
import Modules.Root.Reps

set_option linter.style.longLine false

/-!
# One shared scale: `ν Platonic.Dodecahedron.polyhedron`

`platonicDodecahedron_nu_shared_list`: **every system of `platonicDodecahedron_nu_roots_list` has its one root at the scale
`ν Platonic.Dodecahedron.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `platonicDodecahedron_nu_reps_list`:
the same for the same system, and `platonicDodecahedron_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Platonic.Dodecahedron.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPlatonicDodecahedron`, `Nieuwland.Certs.NieuwlandPlatonicDodecahedron.Exact` and
`Nieuwland.Certs.NieuwlandPlatonicDodecahedron.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Platonic.Dodecahedron.polyhedron` has its one root at `ν Platonic.Dodecahedron.polyhedron`**: each of the systems of `platonicDodecahedron_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem platonicDodecahedron_nu_shared_list :
    PolynomialSystem.IsRootEq [platonicDodecahedron_nu_system_0] Platonic.Dodecahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton platonicDodecahedron_nu_roots_list

/-- **The representatives of `ν Platonic.Dodecahedron.polyhedron`**: the same system, each with exactly one root, at the scale `ν Platonic.Dodecahedron.polyhedron`. -/
theorem platonicDodecahedron_nu_reps_list :
    PolynomialSystem.IsRootEq [platonicDodecahedron_nu_system_0] Platonic.Dodecahedron.polyhedron.nieuwland :=
  platonicDodecahedron_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Platonic.Dodecahedron.polyhedron`, by representatives**: `ν Platonic.Dodecahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `platonicDodecahedron_nu_reps_list`. -/
theorem platonicDodecahedron_nu_reps :
    ν Platonic.Dodecahedron.polyhedron ∈ Set.Icc ((1010823060752900471365498240195 : ℝ) / 10 ^ 30) ((1010823060752900471365498240196 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Platonic.Dodecahedron.polyhedron) :=
  ⟨platonicDodecahedron_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) platonicDodecahedron_nu_reps_list⟩

end

end Nieuwland.Polyhedra
