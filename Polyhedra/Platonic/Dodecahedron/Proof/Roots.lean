import Polyhedra.Platonic.Dodecahedron.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Platonic.Dodecahedron.polyhedron`

`platonicDodecahedron_nu_system_<j>`: the systems of `platonicDodecahedron_exact` (`Nieuwland.Certs.NieuwlandPlatonicDodecahedron.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`platonicDodecahedron_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Platonic.Dodecahedron.polyhedron` is the largest scale among
those roots (`platonicDodecahedron_nu_roots_list`). `platonicDodecahedron_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `platonicDodecahedron_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`platonicDodecahedron_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPlatonicDodecahedron` and `Nieuwland.Certs.NieuwlandPlatonicDodecahedron.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Platonic.Dodecahedron.polyhedron`: the equation `2025 * ℓ ^ 8 - 11970 * ℓ ^ 6 + 17009 * ℓ ^ 4 - 9000 * ℓ ^ 2 + 2000 = 0` with `ℓ` in the interval of the number's decimals (the system of `platonicDodecahedron_exact`). -/
noncomputable def platonicDodecahedron_nu_system_0 : PolynomialSystem :=
  ⟨[([(2000, []), (17009, [(0, 4)]), (2025, [(0, 8)])],
     [(9000, [(0, 2)]), (11970, [(0, 6)])])],
   [(202164612150580094273099648039/200000000000000000000000000000, 252705765188225117841374560049/250000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Platonic.Dodecahedron.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `platonicDodecahedron_nu_roots`. -/
theorem platonicDodecahedron_nu_roots_list :
    PolynomialSystem.IsRootMax [platonicDodecahedron_nu_system_0] Platonic.Dodecahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var platonicDodecahedron_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Platonic.Dodecahedron.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem platonicDodecahedron_nu_system_0_oneRoot : platonicDodecahedron_nu_system_0.HasUniqueRoot :=
  platonicDodecahedron_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Platonic.Dodecahedron.polyhedron`, by roots**: `ν Platonic.Dodecahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `platonicDodecahedron_nu_system_<j>`. -/
theorem platonicDodecahedron_nu_roots :
    ν Platonic.Dodecahedron.polyhedron ∈ Set.Icc ((1010823060752900471365498240195 : ℝ) / 10 ^ 30) ((1010823060752900471365498240196 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Platonic.Dodecahedron.polyhedron) :=
  ⟨platonicDodecahedron_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) platonicDodecahedron_nu_roots_list⟩

end

end Nieuwland.Polyhedra
