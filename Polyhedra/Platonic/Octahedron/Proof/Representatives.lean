import Polyhedra.Platonic.Octahedron.Proof.Roots
import Modules.Root.Reps

set_option linter.style.longLine false

/-!
# One shared scale: `ν Platonic.Octahedron.polyhedron`

`platonicOctahedron_nu_shared_list`: **every system of `platonicOctahedron_nu_roots_list` has its one root at the scale
`ν Platonic.Octahedron.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `platonicOctahedron_nu_reps_list`:
the same for the same system, and `platonicOctahedron_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Platonic.Octahedron.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPlatonicOctahedron`, `Nieuwland.Certs.NieuwlandPlatonicOctahedron.Exact` and
`Nieuwland.Certs.NieuwlandPlatonicOctahedron.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Platonic.Octahedron.polyhedron` has its one root at `ν Platonic.Octahedron.polyhedron`**: each of the systems of `platonicOctahedron_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem platonicOctahedron_nu_shared_list :
    PolynomialSystem.IsRootEq [platonicOctahedron_nu_system_0] Platonic.Octahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton platonicOctahedron_nu_roots_list

/-- **The representatives of `ν Platonic.Octahedron.polyhedron`**: the same system, each with exactly one root, at the scale `ν Platonic.Octahedron.polyhedron`. -/
theorem platonicOctahedron_nu_reps_list :
    PolynomialSystem.IsRootEq [platonicOctahedron_nu_system_0] Platonic.Octahedron.polyhedron.nieuwland :=
  platonicOctahedron_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Platonic.Octahedron.polyhedron`, by representatives**: `ν Platonic.Octahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `platonicOctahedron_nu_reps_list`. -/
theorem platonicOctahedron_nu_reps :
    ν Platonic.Octahedron.polyhedron ∈ Set.Icc ((1060660171779821286601266543157 : ℝ) / 10 ^ 30) ((1060660171779821286601266543158 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Platonic.Octahedron.polyhedron) :=
  ⟨platonicOctahedron_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) platonicOctahedron_nu_reps_list⟩

end

end Nieuwland.Polyhedra
