import Polyhedra.Platonic.Octahedron.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Platonic.Octahedron.polyhedron`

`platonicOctahedron_nu_system_<j>`: the systems of `platonicOctahedron_exact` (`Nieuwland.Certs.NieuwlandPlatonicOctahedron.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`platonicOctahedron_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Platonic.Octahedron.polyhedron` is the largest scale among
those roots (`platonicOctahedron_nu_roots_list`). `platonicOctahedron_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `platonicOctahedron_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`platonicOctahedron_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPlatonicOctahedron` and `Nieuwland.Certs.NieuwlandPlatonicOctahedron.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Platonic.Octahedron.polyhedron`: the equation `8 * ℓ ^ 2 - 9 = 0` with `ℓ` in the interval of the number's decimals (the system of `platonicOctahedron_exact`). -/
noncomputable def platonicOctahedron_nu_system_0 : PolynomialSystem :=
  ⟨[([(8, [(0, 2)])],
     [(9, [])])],
   [(1060660171779821286601266543157/1000000000000000000000000000000, 530330085889910643300633271579/500000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Platonic.Octahedron.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `platonicOctahedron_nu_roots`. -/
theorem platonicOctahedron_nu_roots_list :
    PolynomialSystem.IsRootMax [platonicOctahedron_nu_system_0] Platonic.Octahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var platonicOctahedron_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Platonic.Octahedron.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem platonicOctahedron_nu_system_0_oneRoot : platonicOctahedron_nu_system_0.HasUniqueRoot :=
  platonicOctahedron_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Platonic.Octahedron.polyhedron`, by roots**: `ν Platonic.Octahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `platonicOctahedron_nu_system_<j>`. -/
theorem platonicOctahedron_nu_roots :
    ν Platonic.Octahedron.polyhedron ∈ Set.Icc ((1060660171779821286601266543157 : ℝ) / 10 ^ 30) ((1060660171779821286601266543158 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Platonic.Octahedron.polyhedron) :=
  ⟨platonicOctahedron_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) platonicOctahedron_nu_roots_list⟩

end

end Nieuwland.Polyhedra
