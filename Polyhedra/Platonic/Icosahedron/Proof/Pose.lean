namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Platonic.Icosahedron.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Platonic.Icosahedron.polyhedron` scaled by `N` through itself. -/
theorem platonicIcosahedron_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.PlatonicIcosahedron.reps] N) :
    PolynomialSystem.IsPoseRoot Platonic.Icosahedron.polyhedron Pose.PlatonicIcosahedron.S N 22 13 31 := by
  rw [Pose.PlatonicIcosahedron.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.PlatonicIcosahedron.weak_check Pose.PlatonicIcosahedron.poly_eq Pose.PlatonicIcosahedron.ok

end Nieuwland.Polyhedra
