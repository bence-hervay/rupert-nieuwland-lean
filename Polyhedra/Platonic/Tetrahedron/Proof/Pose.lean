/-!
# Pose root of `Platonic.Tetrahedron.polyhedron`

ν and one optimal pose of `Platonic.Tetrahedron.polyhedron` (`fixtures/nieuwland/platonic/tetrahedron`) as the one root of a system, downstream of the representatives' theorem `platonicTetrahedron_nu_reps_list` (a closed form). The weak fit at `ν` is the exact record's over the lift `ℤ[α]` (`rupert-lean-export lift-weak`), checked by the kernel (`weak_check`); the lift's points are the solid's `Dim` points (`points_eq`). The system `S` is `cfSystem` (`Modules/Pose/PoseCheck.lean`): `x 0 = ℓ`, `x 1 = α`, the pose's chart coordinates `x 2, …, x 9`, three helpers, `R₂ = matAt x 13`, `R₁ = matAt x 22`, `t = (x 31, x 32)`. Generated by `lean/scripts/poseroot.py`.
-/

namespace Nieuwland.Pose.PlatonicTetrahedron

open Check PolynomialSystem

/-- The lift's root. -/
def root : Root :=
  ⟨[36, 0, -36, 0, 1], 0, 4,
    1, [36, 0, -36, 0, 1],
    16, 15, 18, 64, 12,
    13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084096,
    13603721107969596754816819526400629342294244676148395158207755454948113876891241560677518911007075718690408328684906686901371619639491067470629903214301098,
    13603721107969596754816819526400629342294244676148395158207755454948113876891241560677518911007075718690408328684906686901371619639491067470629903214301099,
    by decide +kernel⟩

/-- The far field's points as exact values of the lift. -/
def points : List (V3 (ZTheta root)) :=
  liftPts (ZTheta root) Nieuwland.Polyhedra.PlatonicTetrahedronDim.points

theorem points_eq : Polyhedron.ofPoints points = Polyhedron.ofPoints Nieuwland.Polyhedra.PlatonicTetrahedronDim.points :=
  ofPoints_liftPts _ _

/-- The fit, with the hole polygon. -/
def fit : FitData (ZTheta root) :=
  { view := 2
    D := ⟨[1]⟩
    S := ⟨[-1]⟩
    T := ⟨[1]⟩
    rot := 1
    q := ⟨⟨[-6, 0, 1]⟩,
      ⟨[12]⟩,
      ⟨[18, -12, 1]⟩,
      ⟨[-24, 30, 2, -1]⟩⟩
    τ₀ := ⟨[0]⟩
    τ₁ := ⟨[2, 0, -1]⟩
    E := ⟨[4]⟩
    corners := [3, 0, 1] }

/-- The weak fit at the exact scale, with an interior witness. -/
def weak : WeakFitData (ZTheta root) :=
  { fit := fit
    scaleNum := ⟨[0, 1]⟩
    scaleDen := 1
    h₀ := ⟨[0]⟩
    h₁ := ⟨[0]⟩
    H := ⟨[1]⟩ }

theorem weak_check : weak.check points = true := by
  decide +kernel

/-- The representatives' system (`platonicTetrahedron_nu_reps_list`). -/
noncomputable def reps : PolynomialSystem :=
  ⟨[([(36, []), (1, [(0, 4)])],
     [(36, [(0, 2)])])],
   [(202922374470915297771521721661/200000000000000000000000000000, 507305936177288244428804304153/500000000000000000000000000000)]⟩

/-- `α`'s interval: the root's enclosure. -/
def I : ℚ × ℚ := (, )

/-- The intervals of `s, t, q₀, …, q₃, τ₀, τ₁`. -/
def B₁ : List (ℚ × ℚ) := [(-1, -1), (1, 1), (-9941125497/2000000000, -12426406871/2500000000), (12, 12), (8567618479/1250000000, 68540947833/10000000000), (18631878541/2500000000, 14905502833/2000000000), (0, 0), (2426406871/10000000000, 303300859/1250000000)]

/-- The intervals of the pose's twenty variables. -/
def B₃ : List (ℚ × ℚ) := [(0, 1), (0, 0), (0, 1), (0, 1), (0, 2), (-1, 0), (-1, 0), (0, 1), (0, 1), (-1025221189747/10000000000, 4157099444419/10000000000), (-29823376491/250000000, 3407507411387/10000000000), (-647790079269/2500000000, 259116031709/1000000000), (-995406087277/2000000000, 9720762571/19531250), (-1604002357/3200000, 5012507365631/10000000000), (-1483874141221/10000000000, 2031897799107/2500000000), (-1213976155831/5000000000, 514023844179/1000000000), (-696780026961/1250000000, 869244192727/5000000000), (-739689298589/2000000000, 1849223246481/5000000000), (0, 0), (0, 303300859/625000000)]

/-- The quotients of `S₀`'s equations at `ℓ = λ(α)` by `α`'s polynomial. -/
def quot : List RationalPolynomial := [[(1, [])]]

/-- The lift's points to the polyhedron's. -/
def kappa : ℚ := 1

/-- The system (`Polynomials.lean`). -/
noncomputable abbrev S : PolynomialSystem := Platonic.Tetrahedron.system

theorem ok : cfOk reps root weak kappa I B₁ B₃ quot = true := by
  decide +kernel

theorem S_eq : S = cfSystem reps root weak kappa I B₁ B₃ := by
  decide +kernel

theorem poly_eq : Platonic.Tetrahedron.polyhedron = (Polyhedron.ofPoints points).smul ((kappa : ℚ) : ℝ) := by
  rw [Nieuwland.Polyhedra.PlatonicTetrahedronDim.eq_smul, points_eq]
  congr 1
  norm_num [kappa]

end Nieuwland.Pose.PlatonicTetrahedron

namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Platonic.Tetrahedron.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Platonic.Tetrahedron.polyhedron` scaled by `N` through itself. -/
theorem platonicTetrahedron_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.PlatonicTetrahedron.reps] N) :
    PolynomialSystem.IsPoseRoot Platonic.Tetrahedron.polyhedron Pose.PlatonicTetrahedron.S N 22 13 31 := by
  rw [Pose.PlatonicTetrahedron.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.PlatonicTetrahedron.weak_check Pose.PlatonicTetrahedron.poly_eq Pose.PlatonicTetrahedron.ok

end Nieuwland.Polyhedra
