import Polyhedra.Platonic.Tetrahedron.Proof.Roots
import Modules.Root.Reps

set_option linter.style.longLine false

/-!
# One shared scale: `ν Platonic.Tetrahedron.polyhedron`

`platonicTetrahedron_nu_shared_list`: **every system of `platonicTetrahedron_nu_roots_list` has its one root at the scale
`ν Platonic.Tetrahedron.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `platonicTetrahedron_nu_reps_list`:
the same for the same system, and `platonicTetrahedron_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Platonic.Tetrahedron.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPlatonicTetrahedron`, `Nieuwland.Certs.NieuwlandPlatonicTetrahedron.Exact` and
`Nieuwland.Certs.NieuwlandPlatonicTetrahedron.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Platonic.Tetrahedron.polyhedron` has its one root at `ν Platonic.Tetrahedron.polyhedron`**: each of the systems of `platonicTetrahedron_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem platonicTetrahedron_nu_shared_list :
    PolynomialSystem.IsRootEq [platonicTetrahedron_nu_system_0] Platonic.Tetrahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton platonicTetrahedron_nu_roots_list

/-- **The representatives of `ν Platonic.Tetrahedron.polyhedron`**: the same system, each with exactly one root, at the scale `ν Platonic.Tetrahedron.polyhedron`. -/
theorem platonicTetrahedron_nu_reps_list :
    PolynomialSystem.IsRootEq [platonicTetrahedron_nu_system_0] Platonic.Tetrahedron.polyhedron.nieuwland :=
  platonicTetrahedron_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Platonic.Tetrahedron.polyhedron`, by representatives**: `ν Platonic.Tetrahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `platonicTetrahedron_nu_reps_list`. -/
theorem platonicTetrahedron_nu_reps :
    ν Platonic.Tetrahedron.polyhedron ∈ Set.Icc ((1014611872354576488857608608305 : ℝ) / 10 ^ 30) ((1014611872354576488857608608306 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Platonic.Tetrahedron.polyhedron) :=
  ⟨platonicTetrahedron_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) platonicTetrahedron_nu_reps_list⟩

end

end Nieuwland.Polyhedra
