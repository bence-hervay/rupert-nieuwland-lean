theorem catalanDisdyakisTriacontahedron_nu_roots_list :
    PolynomialSystem.IsRootMax [catalanDisdyakisTriacontahedron_nu_system_0] Catalan.DisdyakisTriacontahedron.polyhedron.nieuwland :=
