  rw [Nieuwland.Polyhedra.CatalanDisdyakisTriacontahedronDim.eq_smul, points_eq, Polyhedron.smul_smul_eq]
  congr 1
  norm_num [kappa]

end Nieuwland.Pose.CatalanDisdyakisTriacontahedron

