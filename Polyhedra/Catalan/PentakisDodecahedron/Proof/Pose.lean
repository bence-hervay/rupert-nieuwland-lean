theorem catalanPentakisDodecahedron_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.CatalanPentakisDodecahedron.reps] N) :
    PolynomialSystem.IsPoseRoot Catalan.PentakisDodecahedron.polyhedron Pose.CatalanPentakisDodecahedron.S N 22 13 31 := by
