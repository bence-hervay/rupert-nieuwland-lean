  exact PolynomialSystem.cf_isPoseRoot h Pose.CatalanPentakisDodecahedron.weak_check Pose.CatalanPentakisDodecahedron.poly_eq Pose.CatalanPentakisDodecahedron.ok

end Nieuwland.Polyhedra
