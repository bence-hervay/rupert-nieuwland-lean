import Definitions.Polyhedra
import Mathlib.Analysis.Real.Sqrt

/-!
# The pentakis dodecahedron

The polyhedron `Catalan.PentakisDodecahedron.polyhedron`: the convex hull of 32 points.
-/

namespace Nieuwland.Catalan.PentakisDodecahedron

open Classical in
/-- The pentakis dodecahedron: the convex hull of these 32 points. -/
noncomputable def polyhedron : Polyhedron where
  vertices := [
    ![0, -3/4 + 3/4 * √5, 3/4 + 3/4 * √5],
    ![0, -3/4 + 3/4 * √5, -3/4 - 3/4 * √5],
    ![0, 3/4 - 3/4 * √5, 3/4 + 3/4 * √5],
