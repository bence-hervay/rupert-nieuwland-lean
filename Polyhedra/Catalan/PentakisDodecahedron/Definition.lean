    ![3/4 + 3/4 * √5, 0, -3/4 + 3/4 * √5],
    ![3/4 + 3/4 * √5, 0, 3/4 - 3/4 * √5],
    ![-3/4 - 3/4 * √5, 0, -3/4 + 3/4 * √5],
    ![-3/4 - 3/4 * √5, 0, 3/4 - 3/4 * √5],
    ![-3/4 + 3/4 * √5, 3/4 + 3/4 * √5, 0],
    ![-3/4 + 3/4 * √5, -3/4 - 3/4 * √5, 0],
    ![3/4 - 3/4 * √5, 3/4 + 3/4 * √5, 0],
    ![3/4 - 3/4 * √5, -3/4 - 3/4 * √5, 0],
    ![81/76 + 9/76 * √5, 0, 63/76 + 45/76 * √5],
    ![81/76 + 9/76 * √5, 0, -63/76 - 45/76 * √5],
    ![-81/76 - 9/76 * √5, 0, 63/76 + 45/76 * √5],
    ![-81/76 - 9/76 * √5, 0, -63/76 - 45/76 * √5],
