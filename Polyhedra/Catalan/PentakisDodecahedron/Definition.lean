    ![63/76 + 45/76 * √5, -81/76 - 9/76 * √5, 0],
    ![-63/76 - 45/76 * √5, 81/76 + 9/76 * √5, 0],
    ![-63/76 - 45/76 * √5, -81/76 - 9/76 * √5, 0],
    ![0, 63/76 + 45/76 * √5, 81/76 + 9/76 * √5],
    ![0, 63/76 + 45/76 * √5, -81/76 - 9/76 * √5],
    ![0, -63/76 - 45/76 * √5, 81/76 + 9/76 * √5],
