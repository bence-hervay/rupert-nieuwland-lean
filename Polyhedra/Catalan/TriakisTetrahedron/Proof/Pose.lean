/-- **ν and an optimal pose of `Catalan.TriakisTetrahedron.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Catalan.TriakisTetrahedron.polyhedron` scaled by `N` through itself. -/
theorem catalanTriakisTetrahedron_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.CatalanTriakisTetrahedron.reps] N) :
    PolynomialSystem.IsPoseRoot Catalan.TriakisTetrahedron.polyhedron Pose.CatalanTriakisTetrahedron.S N 22 13 31 := by
  rw [Pose.CatalanTriakisTetrahedron.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.CatalanTriakisTetrahedron.weak_check Pose.CatalanTriakisTetrahedron.poly_eq Pose.CatalanTriakisTetrahedron.ok

end Nieuwland.Polyhedra
