/-!
# One shared scale: `ν Catalan.TriakisTetrahedron.polyhedron`

`catalanTriakisTetrahedron_nu_shared_list`: **every system of `catalanTriakisTetrahedron_nu_roots_list` has its one root at the scale
`ν Catalan.TriakisTetrahedron.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `catalanTriakisTetrahedron_nu_reps_list`:
the same for the same system, and `catalanTriakisTetrahedron_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Catalan.TriakisTetrahedron.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandCatalanTriakisTetrahedron`, `Nieuwland.Certs.NieuwlandCatalanTriakisTetrahedron.Exact` and
`Nieuwland.Certs.NieuwlandCatalanTriakisTetrahedron.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Catalan.TriakisTetrahedron.polyhedron` has its one root at `ν Catalan.TriakisTetrahedron.polyhedron`**: each of the systems of `catalanTriakisTetrahedron_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem catalanTriakisTetrahedron_nu_shared_list :
    PolynomialSystem.IsRootEq [catalanTriakisTetrahedron_nu_system_0] Catalan.TriakisTetrahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton catalanTriakisTetrahedron_nu_roots_list

/-- **The representatives of `ν Catalan.TriakisTetrahedron.polyhedron`**: the same system, each with exactly one root, at the scale `ν Catalan.TriakisTetrahedron.polyhedron`. -/
theorem catalanTriakisTetrahedron_nu_reps_list :
    PolynomialSystem.IsRootEq [catalanTriakisTetrahedron_nu_system_0] Catalan.TriakisTetrahedron.polyhedron.nieuwland :=
  catalanTriakisTetrahedron_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Catalan.TriakisTetrahedron.polyhedron`, by representatives**: `ν Catalan.TriakisTetrahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `catalanTriakisTetrahedron_nu_reps_list`. -/
theorem catalanTriakisTetrahedron_nu_reps :
    ν Catalan.TriakisTetrahedron.polyhedron ∈ Set.Icc ((1000004088639406444485636493954 : ℝ) / 10 ^ 30) ((1000004088639406444485636493955 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Catalan.TriakisTetrahedron.polyhedron) :=
  ⟨catalanTriakisTetrahedron_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) catalanTriakisTetrahedron_nu_reps_list⟩

end

end Nieuwland.Polyhedra
