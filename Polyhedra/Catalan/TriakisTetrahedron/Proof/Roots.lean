import Polyhedra.Catalan.TriakisTetrahedron.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Catalan.TriakisTetrahedron.polyhedron`

`catalanTriakisTetrahedron_nu_system_<j>`: the systems of `catalanTriakisTetrahedron_exact` (`Nieuwland.Certs.NieuwlandCatalanTriakisTetrahedron.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`catalanTriakisTetrahedron_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Catalan.TriakisTetrahedron.polyhedron` is the largest scale among
those roots (`catalanTriakisTetrahedron_nu_roots_list`). `catalanTriakisTetrahedron_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `catalanTriakisTetrahedron_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`catalanTriakisTetrahedron_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandCatalanTriakisTetrahedron` and `Nieuwland.Certs.NieuwlandCatalanTriakisTetrahedron.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Catalan.TriakisTetrahedron.polyhedron`: the equation `241025625 * ℓ ^ 6 - 5248891917 * ℓ ^ 4 + 7788757288 * ℓ ^ 2 - 2780874756 = 0` with `ℓ` in the interval of the number's decimals (the system of `catalanTriakisTetrahedron_exact`). -/
noncomputable def catalanTriakisTetrahedron_nu_system_0 : PolynomialSystem :=
  ⟨[([(7788757288, [(0, 2)]), (241025625, [(0, 6)])],
     [(2780874756, []), (5248891917, [(0, 4)])])],
   [(500002044319703222242818246977/500000000000000000000000000000, 200000817727881288897127298791/200000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Catalan.TriakisTetrahedron.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `catalanTriakisTetrahedron_nu_roots`. -/
theorem catalanTriakisTetrahedron_nu_roots_list :
    PolynomialSystem.IsRootMax [catalanTriakisTetrahedron_nu_system_0] Catalan.TriakisTetrahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var catalanTriakisTetrahedron_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Catalan.TriakisTetrahedron.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem catalanTriakisTetrahedron_nu_system_0_oneRoot : catalanTriakisTetrahedron_nu_system_0.HasUniqueRoot :=
  catalanTriakisTetrahedron_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Catalan.TriakisTetrahedron.polyhedron`, by roots**: `ν Catalan.TriakisTetrahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `catalanTriakisTetrahedron_nu_system_<j>`. -/
theorem catalanTriakisTetrahedron_nu_roots :
    ν Catalan.TriakisTetrahedron.polyhedron ∈ Set.Icc ((1000004088639406444485636493954 : ℝ) / 10 ^ 30) ((1000004088639406444485636493955 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Catalan.TriakisTetrahedron.polyhedron) :=
  ⟨catalanTriakisTetrahedron_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) catalanTriakisTetrahedron_nu_roots_list⟩

end

end Nieuwland.Polyhedra
