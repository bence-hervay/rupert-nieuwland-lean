/-- **ν and an optimal pose of `Catalan.DeltoidalIcositetrahedron.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Catalan.DeltoidalIcositetrahedron.polyhedron` scaled by `N` through itself. -/
theorem catalanDeltoidalIcositetrahedron_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.CatalanDeltoidalIcositetrahedron.reps] N) :
    PolynomialSystem.IsPoseRoot Catalan.DeltoidalIcositetrahedron.polyhedron Pose.CatalanDeltoidalIcositetrahedron.S N 22 13 31 := by
  rw [Pose.CatalanDeltoidalIcositetrahedron.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.CatalanDeltoidalIcositetrahedron.weak_check Pose.CatalanDeltoidalIcositetrahedron.poly_eq Pose.CatalanDeltoidalIcositetrahedron.ok

end Nieuwland.Polyhedra
