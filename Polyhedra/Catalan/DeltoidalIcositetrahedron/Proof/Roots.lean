open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Catalan.DeltoidalIcositetrahedron.polyhedron`, by roots**: `ν Catalan.DeltoidalIcositetrahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `catalanDeltoidalIcositetrahedron_nu_system_<j>`. -/
theorem catalanDeltoidalIcositetrahedron_nu_roots :
    ν Catalan.DeltoidalIcositetrahedron.polyhedron ∈ Set.Icc ((1007636465375136619140462648220 : ℝ) / 10 ^ 30) ((1007636465375136619140462648221 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Catalan.DeltoidalIcositetrahedron.polyhedron) :=
  ⟨catalanDeltoidalIcositetrahedron_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) catalanDeltoidalIcositetrahedron_nu_roots_list⟩

end

