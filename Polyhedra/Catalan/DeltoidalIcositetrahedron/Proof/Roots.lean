/-!
# Exactly one root per system: `ν Catalan.DeltoidalIcositetrahedron.polyhedron`

`catalanDeltoidalIcositetrahedron_nu_system_<j>`: the systems of `catalanDeltoidalIcositetrahedron_exact` (`Nieuwland.Certs.NieuwlandCatalanDeltoidalIcositetrahedron.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`catalanDeltoidalIcositetrahedron_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Catalan.DeltoidalIcositetrahedron.polyhedron` is the largest scale among
those roots (`catalanDeltoidalIcositetrahedron_nu_roots_list`). `catalanDeltoidalIcositetrahedron_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `catalanDeltoidalIcositetrahedron_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`catalanDeltoidalIcositetrahedron_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandCatalanDeltoidalIcositetrahedron` and `Nieuwland.Certs.NieuwlandCatalanDeltoidalIcositetrahedron.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Catalan.DeltoidalIcositetrahedron.polyhedron`: the equation `64 * ℓ ^ 8 - 256 * ℓ ^ 6 + 304 * ℓ ^ 4 - 160 * ℓ ^ 2 + 49 = 0` with `ℓ` in the interval of the number's decimals (the system of `catalanDeltoidalIcositetrahedron_exact`). -/
noncomputable def catalanDeltoidalIcositetrahedron_nu_system_0 : PolynomialSystem :=
  ⟨[([(49, []), (304, [(0, 4)]), (64, [(0, 8)])],
     [(160, [(0, 2)]), (256, [(0, 6)])])],
   [(50381823268756830957023132411/50000000000000000000000000000, 1007636465375136619140462648221/1000000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Catalan.DeltoidalIcositetrahedron.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `catalanDeltoidalIcositetrahedron_nu_roots`. -/
theorem catalanDeltoidalIcositetrahedron_nu_roots_list :
    PolynomialSystem.IsRootMax [catalanDeltoidalIcositetrahedron_nu_system_0] Catalan.DeltoidalIcositetrahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var catalanDeltoidalIcositetrahedron_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Catalan.DeltoidalIcositetrahedron.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem catalanDeltoidalIcositetrahedron_nu_system_0_oneRoot : catalanDeltoidalIcositetrahedron_nu_system_0.HasUniqueRoot :=
  catalanDeltoidalIcositetrahedron_nu_roots_list.2 _ (by simp)

