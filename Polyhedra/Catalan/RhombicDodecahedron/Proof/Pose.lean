def kappa : ℚ := 1

/-- The system (`Polynomials.lean`). -/
noncomputable abbrev S : PolynomialSystem := Catalan.RhombicDodecahedron.system

theorem ok : cfOk reps root weak kappa I B₁ B₃ quot = true := by
  decide +kernel

theorem S_eq : S = cfSystem reps root weak kappa I B₁ B₃ := by
  decide +kernel

theorem poly_eq : Catalan.RhombicDodecahedron.polyhedron = (Polyhedron.ofPoints points).smul ((kappa : ℚ) : ℝ) := by
  rw [Nieuwland.Polyhedra.CatalanRhombicDodecahedronDim.eq_smul, points_eq]
  congr 1
  norm_num [kappa]

