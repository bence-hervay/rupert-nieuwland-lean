namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Catalan.RhombicDodecahedron.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Catalan.RhombicDodecahedron.polyhedron` scaled by `N` through itself. -/
theorem catalanRhombicDodecahedron_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.CatalanRhombicDodecahedron.reps] N) :
    PolynomialSystem.IsPoseRoot Catalan.RhombicDodecahedron.polyhedron Pose.CatalanRhombicDodecahedron.S N 22 13 31 := by
  rw [Pose.CatalanRhombicDodecahedron.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.CatalanRhombicDodecahedron.weak_check Pose.CatalanRhombicDodecahedron.poly_eq Pose.CatalanRhombicDodecahedron.ok

end Nieuwland.Polyhedra
