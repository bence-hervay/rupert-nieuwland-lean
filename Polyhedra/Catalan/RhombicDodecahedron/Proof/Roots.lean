import Polyhedra.Catalan.RhombicDodecahedron.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Catalan.RhombicDodecahedron.polyhedron`

`catalanRhombicDodecahedron_nu_system_<j>`: the systems of `catalanRhombicDodecahedron_exact` (`Nieuwland.Certs.NieuwlandCatalanRhombicDodecahedron.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`catalanRhombicDodecahedron_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Catalan.RhombicDodecahedron.polyhedron` is the largest scale among
those roots (`catalanRhombicDodecahedron_nu_roots_list`). `catalanRhombicDodecahedron_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `catalanRhombicDodecahedron_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`catalanRhombicDodecahedron_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandCatalanRhombicDodecahedron` and `Nieuwland.Certs.NieuwlandCatalanRhombicDodecahedron.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Catalan.RhombicDodecahedron.polyhedron`: the equation `16 * ℓ ^ 4 - 51 * ℓ ^ 2 + 36 = 0` with `ℓ` in the interval of the number's decimals (the system of `catalanRhombicDodecahedron_exact`). -/
noncomputable def catalanRhombicDodecahedron_nu_system_0 : PolynomialSystem :=
  ⟨[([(36, []), (16, [(0, 4)])],
     [(51, [(0, 2)])])],
   [(1027227945437165281727168983563/1000000000000000000000000000000, 256806986359291320431792245891/250000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Catalan.RhombicDodecahedron.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `catalanRhombicDodecahedron_nu_roots`. -/
theorem catalanRhombicDodecahedron_nu_roots_list :
    PolynomialSystem.IsRootMax [catalanRhombicDodecahedron_nu_system_0] Catalan.RhombicDodecahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var catalanRhombicDodecahedron_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Catalan.RhombicDodecahedron.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem catalanRhombicDodecahedron_nu_system_0_oneRoot : catalanRhombicDodecahedron_nu_system_0.HasUniqueRoot :=
  catalanRhombicDodecahedron_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Catalan.RhombicDodecahedron.polyhedron`, by roots**: `ν Catalan.RhombicDodecahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `catalanRhombicDodecahedron_nu_system_<j>`. -/
theorem catalanRhombicDodecahedron_nu_roots :
    ν Catalan.RhombicDodecahedron.polyhedron ∈ Set.Icc ((1027227945437165281727168983563 : ℝ) / 10 ^ 30) ((1027227945437165281727168983564 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Catalan.RhombicDodecahedron.polyhedron) :=
  ⟨catalanRhombicDodecahedron_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) catalanRhombicDodecahedron_nu_roots_list⟩

end

end Nieuwland.Polyhedra
