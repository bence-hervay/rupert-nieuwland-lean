theorem catalanRhombicTriacontahedron_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.CatalanRhombicTriacontahedron.reps] N) :
    PolynomialSystem.IsPoseRoot Catalan.RhombicTriacontahedron.polyhedron Pose.CatalanRhombicTriacontahedron.S N 22 13 31 := by
