import Definitions.Polyhedra
import Mathlib.Analysis.Real.Sqrt

/-!
# The rhombic triacontahedron

The polyhedron `Catalan.RhombicTriacontahedron.polyhedron`: the convex hull of 32 points.
-/

namespace Nieuwland.Catalan.RhombicTriacontahedron

open Classical in
/-- The rhombic triacontahedron: the convex hull of these 32 points. -/
noncomputable def polyhedron : Polyhedron where
  vertices := [
    ![5/8 + 1/8 * √5, 0, 5/8 + 3/8 * √5],
    ![5/8 + 1/8 * √5, 0, -5/8 - 3/8 * √5],
    ![-5/8 - 1/8 * √5, 0, 5/8 + 3/8 * √5],
    ![-5/8 - 1/8 * √5, 0, -5/8 - 3/8 * √5],
    ![5/8 + 3/8 * √5, 5/8 + 1/8 * √5, 0],
    ![5/8 + 3/8 * √5, -5/8 - 1/8 * √5, 0],
    ![-5/8 - 3/8 * √5, 5/8 + 1/8 * √5, 0],
    ![-5/8 - 3/8 * √5, -5/8 - 1/8 * √5, 0],
    ![0, 5/8 + 3/8 * √5, 5/8 + 1/8 * √5],
    ![0, 5/8 + 3/8 * √5, -5/8 - 1/8 * √5],
    ![0, -5/8 - 3/8 * √5, 5/8 + 1/8 * √5],
    ![0, -5/8 - 3/8 * √5, -5/8 - 1/8 * √5],
    ![0, 1/4 * √5, 5/8 + 3/8 * √5],
    ![0, 1/4 * √5, -5/8 - 3/8 * √5],
    ![0, -(1/4 * √5), 5/8 + 3/8 * √5],
    ![0, -(1/4 * √5), -5/8 - 3/8 * √5],
    ![5/8 + 3/8 * √5, 0, 1/4 * √5],
    ![5/8 + 3/8 * √5, 0, -(1/4 * √5)],
    ![-5/8 - 3/8 * √5, 0, 1/4 * √5],
    ![-5/8 - 3/8 * √5, 0, -(1/4 * √5)],
    ![1/4 * √5, 5/8 + 3/8 * √5, 0],
    ![1/4 * √5, -5/8 - 3/8 * √5, 0],
    ![-(1/4 * √5), 5/8 + 3/8 * √5, 0],
    ![-(1/4 * √5), -5/8 - 3/8 * √5, 0],
    ![5/8 + 1/8 * √5, 5/8 + 1/8 * √5, 5/8 + 1/8 * √5],
    ![5/8 + 1/8 * √5, 5/8 + 1/8 * √5, -5/8 - 1/8 * √5],
    ![5/8 + 1/8 * √5, -5/8 - 1/8 * √5, 5/8 + 1/8 * √5],
    ![5/8 + 1/8 * √5, -5/8 - 1/8 * √5, -5/8 - 1/8 * √5],
    ![-5/8 - 1/8 * √5, 5/8 + 1/8 * √5, 5/8 + 1/8 * √5],
    ![-5/8 - 1/8 * √5, 5/8 + 1/8 * √5, -5/8 - 1/8 * √5],
    ![-5/8 - 1/8 * √5, -5/8 - 1/8 * √5, 5/8 + 1/8 * √5],
    ![-5/8 - 1/8 * √5, -5/8 - 1/8 * √5, -5/8 - 1/8 * √5]].toFinset

end Nieuwland.Catalan.RhombicTriacontahedron
