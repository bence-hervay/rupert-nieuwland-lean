noncomputable abbrev S : PolynomialSystem := Catalan.TriakisIcosahedron.system

theorem par_ok : Root.RootBasis.parCheck (ZSqrt 5) touch.par = true := by
  decide +kernel

/-- The contacts of the record's duplicates and coincidences, whose identities check on the balls of the box (compiled evaluation: the identities' polynomials are expanded by well-founded recursion, which the kernel does not evaluate). -/
def zs : List (ℕ × ℕ × ℕ) := [(11, 5, 27), (5, 4, 4), (5, 4, 5), (4, 8, 0)]

theorem zs_eq : Root.Sys.zeroCons (ZSqrt 5) (touch.sys Nieuwland.Polyhedra.CatalanTriakisIcosahedronDim.points) (touch.kraw Nieuwland.Polyhedra.CatalanTriakisIcosahedronDim.points).boxBalls touch.W = zs := by
  native_decide

