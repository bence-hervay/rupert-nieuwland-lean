/-- **ν and an optimal pose of `Catalan.TriakisIcosahedron.polyhedron` as one root**: when the representatives' systems have
exactly one root each, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it
`matAt x 41`, `matAt x 32` and `(x 50, x 51)` are a weak fit of `Catalan.TriakisIcosahedron.polyhedron` scaled
by `N` through itself. -/
theorem catalanTriakisIcosahedron_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.CatalanTriakisIcosahedron.reps0] N) :
    PolynomialSystem.IsPoseRoot Catalan.TriakisIcosahedron.polyhedron Pose.CatalanTriakisIcosahedron.S N 41 32 50 := by
  rw [Pose.CatalanTriakisIcosahedron.S_eq]
  exact PolynomialSystem.ct_isPoseRoot h List.mem_cons_self Pose.CatalanTriakisIcosahedron.len_eq Pose.CatalanTriakisIcosahedron.reps_eq
    (Root.ParData.sqrt_spec (by decide +kernel)) Pose.CatalanTriakisIcosahedron.par_ok Pose.CatalanTriakisIcosahedron.zs_eq Pose.CatalanTriakisIcosahedron.weak_ok Pose.CatalanTriakisIcosahedron.poly_eq Pose.CatalanTriakisIcosahedron.ok

end Nieuwland.Polyhedra
