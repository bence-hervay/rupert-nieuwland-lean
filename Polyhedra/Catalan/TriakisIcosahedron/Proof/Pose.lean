  decide +kernel

theorem poly_eq : Catalan.TriakisIcosahedron.polyhedron = (Polyhedron.ofPoints Nieuwland.Polyhedra.CatalanTriakisIcosahedronDim.points).smul ((kappa : ℚ) : ℝ) := by
  rw [Nieuwland.Polyhedra.CatalanTriakisIcosahedronDim.eq_smul]
  congr 1
  norm_num [kappa]

