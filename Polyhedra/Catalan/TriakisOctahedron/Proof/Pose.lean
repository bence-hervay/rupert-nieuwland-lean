/-- The system (`Polynomials.lean`). -/
noncomputable abbrev S : PolynomialSystem := Catalan.TriakisOctahedron.system

theorem ok : cfOk reps root weak kappa I B₁ B₃ quot = true := by
  decide +kernel

theorem S_eq : S = cfSystem reps root weak kappa I B₁ B₃ := by
  decide +kernel

theorem poly_eq : Catalan.TriakisOctahedron.polyhedron = (Polyhedron.ofPoints points).smul ((kappa : ℚ) : ℝ) := by
  rw [Nieuwland.Polyhedra.CatalanTriakisOctahedronDim.eq_smul, points_eq, Polyhedron.smul_smul_eq]
  congr 1
