namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Catalan.TriakisOctahedron.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Catalan.TriakisOctahedron.polyhedron` scaled by `N` through itself. -/
theorem catalanTriakisOctahedron_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.CatalanTriakisOctahedron.reps] N) :
    PolynomialSystem.IsPoseRoot Catalan.TriakisOctahedron.polyhedron Pose.CatalanTriakisOctahedron.S N 22 13 31 := by
  rw [Pose.CatalanTriakisOctahedron.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.CatalanTriakisOctahedron.weak_check Pose.CatalanTriakisOctahedron.poly_eq Pose.CatalanTriakisOctahedron.ok

end Nieuwland.Polyhedra
