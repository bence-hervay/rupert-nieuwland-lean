import Polyhedra.Catalan.TetrakisHexahedron.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Catalan.TetrakisHexahedron.polyhedron`

`catalanTetrakisHexahedron_nu_system_<j>`: the systems of `catalanTetrakisHexahedron_exact` (`Nieuwland.Certs.NieuwlandCatalanTetrakisHexahedron.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`catalanTetrakisHexahedron_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Catalan.TetrakisHexahedron.polyhedron` is the largest scale among
those roots (`catalanTetrakisHexahedron_nu_roots_list`). `catalanTetrakisHexahedron_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `catalanTetrakisHexahedron_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`catalanTetrakisHexahedron_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandCatalanTetrakisHexahedron` and `Nieuwland.Certs.NieuwlandCatalanTetrakisHexahedron.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Catalan.TetrakisHexahedron.polyhedron`: the equation `4096 * ℓ ^ 8 - 14848 * ℓ ^ 6 + 23545 * ℓ ^ 4 - 18000 * ℓ ^ 2 + 5184 = 0` with `ℓ` in the interval of the number's decimals (the system of `catalanTetrakisHexahedron_exact`). -/
noncomputable def catalanTetrakisHexahedron_nu_system_0 : PolynomialSystem :=
  ⟨[([(5184, []), (23545, [(0, 4)]), (4096, [(0, 8)])],
     [(18000, [(0, 2)]), (14848, [(0, 6)])])],
   [(505649194386081446814340120349/500000000000000000000000000000, 1011298388772162893628680240699/1000000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Catalan.TetrakisHexahedron.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `catalanTetrakisHexahedron_nu_roots`. -/
theorem catalanTetrakisHexahedron_nu_roots_list :
    PolynomialSystem.IsRootMax [catalanTetrakisHexahedron_nu_system_0] Catalan.TetrakisHexahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var catalanTetrakisHexahedron_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Catalan.TetrakisHexahedron.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem catalanTetrakisHexahedron_nu_system_0_oneRoot : catalanTetrakisHexahedron_nu_system_0.HasUniqueRoot :=
  catalanTetrakisHexahedron_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Catalan.TetrakisHexahedron.polyhedron`, by roots**: `ν Catalan.TetrakisHexahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `catalanTetrakisHexahedron_nu_system_<j>`. -/
theorem catalanTetrakisHexahedron_nu_roots :
    ν Catalan.TetrakisHexahedron.polyhedron ∈ Set.Icc ((1011298388772162893628680240698 : ℝ) / 10 ^ 30) ((1011298388772162893628680240699 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Catalan.TetrakisHexahedron.polyhedron) :=
  ⟨catalanTetrakisHexahedron_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) catalanTetrakisHexahedron_nu_roots_list⟩

end

end Nieuwland.Polyhedra
