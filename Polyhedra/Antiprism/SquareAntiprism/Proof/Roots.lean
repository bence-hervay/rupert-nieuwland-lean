import Polyhedra.Antiprism.SquareAntiprism.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Antiprism.SquareAntiprism.polyhedron`

`prismSquareAntiprism_nu_system_<j>`: the systems of `prismSquareAntiprism_exact` (`Nieuwland.Certs.NieuwlandPrismSquareAntiprism.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`prismSquareAntiprism_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Antiprism.SquareAntiprism.polyhedron` is the largest scale among
those roots (`prismSquareAntiprism_nu_roots_list`). `prismSquareAntiprism_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `prismSquareAntiprism_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`prismSquareAntiprism_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPrismSquareAntiprism` and `Nieuwland.Certs.NieuwlandPrismSquareAntiprism.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Antiprism.SquareAntiprism.polyhedron`: the equation `5329 * ℓ ^ 8 - 50976 * ℓ ^ 6 + 11392 * ℓ ^ 4 + 34816 * ℓ ^ 2 + 4096 = 0` with `ℓ` in the interval of the number's decimals (the system of `prismSquareAntiprism_exact`). -/
noncomputable def prismSquareAntiprism_nu_system_0 : PolynomialSystem :=
  ⟨[([(4096, []), (34816, [(0, 2)]), (11392, [(0, 4)]), (5329, [(0, 8)])],
     [(50976, [(0, 6)])])],
   [(205707091260023596333532173321/200000000000000000000000000000, 514267728150058990833830433303/500000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Antiprism.SquareAntiprism.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `prismSquareAntiprism_nu_roots`. -/
theorem prismSquareAntiprism_nu_roots_list :
    PolynomialSystem.IsRootMax [prismSquareAntiprism_nu_system_0] Antiprism.SquareAntiprism.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var prismSquareAntiprism_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Antiprism.SquareAntiprism.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem prismSquareAntiprism_nu_system_0_oneRoot : prismSquareAntiprism_nu_system_0.HasUniqueRoot :=
  prismSquareAntiprism_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Antiprism.SquareAntiprism.polyhedron`, by roots**: `ν Antiprism.SquareAntiprism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `prismSquareAntiprism_nu_system_<j>`. -/
theorem prismSquareAntiprism_nu_roots :
    ν Antiprism.SquareAntiprism.polyhedron ∈ Set.Icc ((1028535456300117981667660866605 : ℝ) / 10 ^ 30) ((1028535456300117981667660866606 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Antiprism.SquareAntiprism.polyhedron) :=
  ⟨prismSquareAntiprism_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) prismSquareAntiprism_nu_roots_list⟩

end

end Nieuwland.Polyhedra
