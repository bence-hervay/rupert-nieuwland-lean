set_option maxHeartbeats 0 in
/-- **Every system of `ν Antiprism.SquareAntiprism.polyhedron` has its one root at `ν Antiprism.SquareAntiprism.polyhedron`**: each of the systems of `prismSquareAntiprism_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem prismSquareAntiprism_nu_shared_list :
    PolynomialSystem.IsRootEq [prismSquareAntiprism_nu_system_0] Antiprism.SquareAntiprism.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton prismSquareAntiprism_nu_roots_list

/-- **The representatives of `ν Antiprism.SquareAntiprism.polyhedron`**: the same system, each with exactly one root, at the scale `ν Antiprism.SquareAntiprism.polyhedron`. -/
theorem prismSquareAntiprism_nu_reps_list :
    PolynomialSystem.IsRootEq [prismSquareAntiprism_nu_system_0] Antiprism.SquareAntiprism.polyhedron.nieuwland :=
  prismSquareAntiprism_nu_shared_list

