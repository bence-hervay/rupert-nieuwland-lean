/-!
# One shared scale: `ν Antiprism.HexagonalAntiprism.polyhedron`

`prismHexagonalAntiprism_nu_shared_list`: **every system of `prismHexagonalAntiprism_nu_roots_list` has its one root at the scale
`ν Antiprism.HexagonalAntiprism.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `prismHexagonalAntiprism_nu_reps_list`:
the same for the same system, and `prismHexagonalAntiprism_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Antiprism.HexagonalAntiprism.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPrismHexagonalAntiprism`, `Nieuwland.Certs.NieuwlandPrismHexagonalAntiprism.Exact` and
`Nieuwland.Certs.NieuwlandPrismHexagonalAntiprism.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Antiprism.HexagonalAntiprism.polyhedron` has its one root at `ν Antiprism.HexagonalAntiprism.polyhedron`**: each of the systems of `prismHexagonalAntiprism_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem prismHexagonalAntiprism_nu_shared_list :
    PolynomialSystem.IsRootEq [prismHexagonalAntiprism_nu_system_0] Antiprism.HexagonalAntiprism.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton prismHexagonalAntiprism_nu_roots_list

/-- **The representatives of `ν Antiprism.HexagonalAntiprism.polyhedron`**: the same system, each with exactly one root, at the scale `ν Antiprism.HexagonalAntiprism.polyhedron`. -/
theorem prismHexagonalAntiprism_nu_reps_list :
    PolynomialSystem.IsRootEq [prismHexagonalAntiprism_nu_system_0] Antiprism.HexagonalAntiprism.polyhedron.nieuwland :=
  prismHexagonalAntiprism_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Antiprism.HexagonalAntiprism.polyhedron`, by representatives**: `ν Antiprism.HexagonalAntiprism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `prismHexagonalAntiprism_nu_reps_list`. -/
theorem prismHexagonalAntiprism_nu_reps :
    ν Antiprism.HexagonalAntiprism.polyhedron ∈ Set.Icc ((1001100063301559273715492070249 : ℝ) / 10 ^ 30) ((1001100063301559273715492070250 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Antiprism.HexagonalAntiprism.polyhedron) :=
  ⟨prismHexagonalAntiprism_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) prismHexagonalAntiprism_nu_reps_list⟩

end

