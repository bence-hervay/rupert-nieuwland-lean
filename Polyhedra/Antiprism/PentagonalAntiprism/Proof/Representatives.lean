theorem prismPentagonalAntiprism_nu_reps :
    ν Antiprism.PentagonalAntiprism.polyhedron ∈ Set.Icc ((1037811738630136038012569258910 : ℝ) / 10 ^ 30) ((1037811738630136038012569258911 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Antiprism.PentagonalAntiprism.polyhedron) :=
