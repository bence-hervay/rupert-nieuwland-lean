/-!
# One shared scale: `ν Antiprism.PentagonalAntiprism.polyhedron`

`prismPentagonalAntiprism_nu_shared_list`: **every system of `prismPentagonalAntiprism_nu_roots_list` has its one root at the scale
`ν Antiprism.PentagonalAntiprism.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): links from root 0 reach each of the roots 0, 1, 2. `prismPentagonalAntiprism_nu_reps_list`:
the same for the system of root 0 alone (one picture class: the roots {0, 1, 2}), and `prismPentagonalAntiprism_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Antiprism.PentagonalAntiprism.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). The roots' scales are shown equal by links (`Root.linkGroupsOk`, evaluated by compiled code in `Nieuwland.Certs.NieuwlandPrismPentagonalAntiprism.links_ok`): isometries of the solid that take one root's contacts onto another's give a pose map taking the first root's zero to a zero of the other's system inside the other's Krawczyk box, where its zero is unique (`Root.scale_eq_of_linksOk`, `Modules/Root/LinkCheck.lean`; `Root.isRootEq_of_links`, `Modules/Root/Reps.lean`). The representatives are the first root of each class of roots whose pictures (the hole's silhouette and the placed plug's) are congruent: a fact of the data measured in floating point (`lean/scripts/links.py`), not a theorem; the links show the scales equal either way.
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPrismPentagonalAntiprism`, `Nieuwland.Certs.NieuwlandPrismPentagonalAntiprism.Exact` and
`Nieuwland.Certs.NieuwlandPrismPentagonalAntiprism.Roots`, which it does not change.
-/

namespace Nieuwland.Certs.NieuwlandPrismPentagonalAntiprism

open Nieuwland

/-- The link from root 0 to root 1 (`Root.LinkRec`): per contact its image, the flips, the antipodes, and the frames of the hole's and the plug's isometries. -/
def link_0_1 : Root.LinkRec :=
  ⟨[3, 4, 2, 0, 1], [true, true, true, true, true], [false, false, false, false, false], [(0, 3), (6, 7), (7, 6)], 0, [(0, 1), (1, 0), (6, 7)], 0⟩

/-- The link from root 0 to root 2 (`Root.LinkRec`): per contact its image, the flips, the antipodes, and the frames of the hole's and the plug's isometries. -/
def link_0_2 : Root.LinkRec :=
  ⟨[2, 3, 4, 1, 0], [false, false, false, false, false], [false, false, false, true, true], [(0, 6), (6, 7), (7, 3)], 0, [(0, 0), (1, 1), (6, 6)], 0⟩

/-- **The links' checks** (`Root.linkGroupsOk`, `Modules/Root/Reps.lean`): each link's isometries and contacts, and the image of its source root's zero inside its target's box; compiled code evaluates it, and `links_ok` rests on the axiom that `native_decide` records for it. -/
theorem links_ok :
    Root.linkGroupsOk points [touch0, touch1, touch2] touch0 [0]
      [(0, [(1, link_0_1), (2, link_0_2)])] = true := by
  native_decide

end Nieuwland.Certs.NieuwlandPrismPentagonalAntiprism

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Antiprism.PentagonalAntiprism.polyhedron` has its one root at `ν Antiprism.PentagonalAntiprism.polyhedron`**: each of the systems of `prismPentagonalAntiprism_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem prismPentagonalAntiprism_nu_shared_list :
    PolynomialSystem.IsRootEq [prismPentagonalAntiprism_nu_system_0, prismPentagonalAntiprism_nu_system_1, prismPentagonalAntiprism_nu_system_2] Antiprism.PentagonalAntiprism.polyhedron.nieuwland :=
  Root.isRootEq_of_links (F := (Root.ParData.sqrt 5 2 3)) (Root.ParData.sqrt_spec (by decide +kernel))
    (Root.ParData.sqrt_unique (by decide +kernel)) (by decide)
    (fun _ h ↦ Root.ok_of_certOk Nieuwland.Certs.NieuwlandPrismPentagonalAntiprism.touch_ok h) prismPentagonalAntiprism_nu_roots_list [0, 1, 2]
    (.cons prismPentagonalAntiprism_nu_system_0_of (.cons prismPentagonalAntiprism_nu_system_1_of (.cons prismPentagonalAntiprism_nu_system_2_of .nil)))
    _ Nieuwland.Certs.NieuwlandPrismPentagonalAntiprism.links_ok (by decide) (by simp) (fun _ h ↦ h)

/-- **The representatives of `ν Antiprism.PentagonalAntiprism.polyhedron`**: the system of root 0 alone (one picture class: the roots {0, 1, 2}), each with exactly one root, at the scale `ν Antiprism.PentagonalAntiprism.polyhedron`. -/
theorem prismPentagonalAntiprism_nu_reps_list :
    PolynomialSystem.IsRootEq [prismPentagonalAntiprism_nu_system_0] Antiprism.PentagonalAntiprism.polyhedron.nieuwland :=
  prismPentagonalAntiprism_nu_shared_list.sub (by simp) (by simp)

