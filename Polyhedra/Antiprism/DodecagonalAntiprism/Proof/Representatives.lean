set_option maxHeartbeats 0 in
/-- **Every system of `ν Antiprism.DodecagonalAntiprism.polyhedron` has its one root at `ν Antiprism.DodecagonalAntiprism.polyhedron`**: each of the systems of `prismDodecagonalAntiprism_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem prismDodecagonalAntiprism_nu_shared_list :
    PolynomialSystem.IsRootEq [prismDodecagonalAntiprism_nu_system_0] Antiprism.DodecagonalAntiprism.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton prismDodecagonalAntiprism_nu_roots_list

/-- **The representatives of `ν Antiprism.DodecagonalAntiprism.polyhedron`**: the same system, each with exactly one root, at the scale `ν Antiprism.DodecagonalAntiprism.polyhedron`. -/
theorem prismDodecagonalAntiprism_nu_reps_list :
    PolynomialSystem.IsRootEq [prismDodecagonalAntiprism_nu_system_0] Antiprism.DodecagonalAntiprism.polyhedron.nieuwland :=
  prismDodecagonalAntiprism_nu_shared_list

