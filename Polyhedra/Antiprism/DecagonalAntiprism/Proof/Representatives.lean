/-!
# One shared scale: `ν Antiprism.DecagonalAntiprism.polyhedron`

`prismDecagonalAntiprism_nu_shared_list`: **every system of `prismDecagonalAntiprism_nu_roots_list` has its one root at the scale
`ν Antiprism.DecagonalAntiprism.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `prismDecagonalAntiprism_nu_reps_list`:
the same for the same system, and `prismDecagonalAntiprism_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Antiprism.DecagonalAntiprism.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPrismDecagonalAntiprism`, `Nieuwland.Certs.NieuwlandPrismDecagonalAntiprism.Exact` and
`Nieuwland.Certs.NieuwlandPrismDecagonalAntiprism.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Antiprism.DecagonalAntiprism.polyhedron` has its one root at `ν Antiprism.DecagonalAntiprism.polyhedron`**: each of the systems of `prismDecagonalAntiprism_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem prismDecagonalAntiprism_nu_shared_list :
    PolynomialSystem.IsRootEq [prismDecagonalAntiprism_nu_system_0] Antiprism.DecagonalAntiprism.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton prismDecagonalAntiprism_nu_roots_list

/-- **The representatives of `ν Antiprism.DecagonalAntiprism.polyhedron`**: the same system, each with exactly one root, at the scale `ν Antiprism.DecagonalAntiprism.polyhedron`. -/
theorem prismDecagonalAntiprism_nu_reps_list :
    PolynomialSystem.IsRootEq [prismDecagonalAntiprism_nu_system_0] Antiprism.DecagonalAntiprism.polyhedron.nieuwland :=
  prismDecagonalAntiprism_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Antiprism.DecagonalAntiprism.polyhedron`, by representatives**: `ν Antiprism.DecagonalAntiprism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `prismDecagonalAntiprism_nu_reps_list`. -/
theorem prismDecagonalAntiprism_nu_reps :
    ν Antiprism.DecagonalAntiprism.polyhedron ∈ Set.Icc ((1000478770859692288487592639610 : ℝ) / 10 ^ 30) ((1000478770859692288487592639611 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Antiprism.DecagonalAntiprism.polyhedron) :=
  ⟨prismDecagonalAntiprism_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) prismDecagonalAntiprism_nu_reps_list⟩

end

end Nieuwland.Polyhedra
