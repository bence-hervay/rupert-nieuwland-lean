/-!
# The octagonal antiprism

The polyhedron `Antiprism.OctagonalAntiprism.polyhedron`: the convex hull of 16 points,
with coordinates in `ℚ(θ)` (`polyEval c θ` is `∑ cᵢ θⁱ`).
-/

namespace Nieuwland.Antiprism.OctagonalAntiprism

/-- `θ`: the largest root of
`79/512 + 7/16 * x - 69/16 * x ^ 2 + 3 * x ^ 3 + 13/2 * x ^ 4 - 4 * x ^ 5 - 3 * x ^ 6 + x ^ 8`
in the interval `(1, 5/2)` (`realRoot`, `Definitions/Polynomials.lean`). -/
noncomputable def theta : ℝ :=
  realRoot [79/512, 7/16, -69/16, 3, 13/2, -4, -3, 0, 1] 1 (5/2)

@[inherit_doc] local notation "θ" => theta

