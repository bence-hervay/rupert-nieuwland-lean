/-!
# One shared scale: `ν Antiprism.OctagonalAntiprism.polyhedron`

`prismOctagonalAntiprism_nu_shared_list`: **every system of `prismOctagonalAntiprism_nu_roots_list` has its one root at the scale
`ν Antiprism.OctagonalAntiprism.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `prismOctagonalAntiprism_nu_reps_list`:
the same for the same system, and `prismOctagonalAntiprism_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Antiprism.OctagonalAntiprism.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandPrismOctagonalAntiprism`, `Nieuwland.Certs.NieuwlandPrismOctagonalAntiprism.Exact` and
`Nieuwland.Certs.NieuwlandPrismOctagonalAntiprism.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Antiprism.OctagonalAntiprism.polyhedron` has its one root at `ν Antiprism.OctagonalAntiprism.polyhedron`**: each of the systems of `prismOctagonalAntiprism_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem prismOctagonalAntiprism_nu_shared_list :
    PolynomialSystem.IsRootEq [prismOctagonalAntiprism_nu_system_0] Antiprism.OctagonalAntiprism.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton prismOctagonalAntiprism_nu_roots_list

/-- **The representatives of `ν Antiprism.OctagonalAntiprism.polyhedron`**: the same system, each with exactly one root, at the scale `ν Antiprism.OctagonalAntiprism.polyhedron`. -/
theorem prismOctagonalAntiprism_nu_reps_list :
    PolynomialSystem.IsRootEq [prismOctagonalAntiprism_nu_system_0] Antiprism.OctagonalAntiprism.polyhedron.nieuwland :=
  prismOctagonalAntiprism_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Antiprism.OctagonalAntiprism.polyhedron`, by representatives**: `ν Antiprism.OctagonalAntiprism.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `prismOctagonalAntiprism_nu_reps_list`. -/
theorem prismOctagonalAntiprism_nu_reps :
    ν Antiprism.OctagonalAntiprism.polyhedron ∈ Set.Icc ((1000704608563946106154948627684 : ℝ) / 10 ^ 30) ((1000704608563946106154948627685 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Antiprism.OctagonalAntiprism.polyhedron) :=
  ⟨prismOctagonalAntiprism_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) prismOctagonalAntiprism_nu_reps_list⟩

end

end Nieuwland.Polyhedra
