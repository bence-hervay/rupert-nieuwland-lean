/-!
# One shared scale: `ν Other.HexagonalDipyramid.polyhedron`

`dipyramidHexagonalDipyramid_nu_shared_list`: **every system of `dipyramidHexagonalDipyramid_nu_roots_list` has its one root at the scale
`ν Other.HexagonalDipyramid.polyhedron`** (`PolynomialSystem.IsRootEq`, `Modules/System/PolyRootEq.lean`): it is the one system. `dipyramidHexagonalDipyramid_nu_reps_list`:
the same for the same system, and `dipyramidHexagonalDipyramid_nu_reps` the statement in Mathlib's terms alone (`IsPolyRootEq`):
`ν Other.HexagonalDipyramid.polyhedron` is the first coordinate of the root of each of these systems, each with exactly one root in its
box; it implies `IsPolyRootMax` (`IsPolyRootEq.isPolyRootMax`). There is one system (`PolynomialSystem.IsRootMax.isRootEq_singleton`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandDipyramidHexagonalDipyramid`, `Nieuwland.Certs.NieuwlandDipyramidHexagonalDipyramid.Exact` and
`Nieuwland.Certs.NieuwlandDipyramidHexagonalDipyramid.Roots`, which it does not change.
-/

namespace Nieuwland.Polyhedra

set_option maxHeartbeats 0 in
/-- **Every system of `ν Other.HexagonalDipyramid.polyhedron` has its one root at `ν Other.HexagonalDipyramid.polyhedron`**: each of the systems of `dipyramidHexagonalDipyramid_nu_roots_list` has exactly one root, and its scale is the Nieuwland number. -/
theorem dipyramidHexagonalDipyramid_nu_shared_list :
    PolynomialSystem.IsRootEq [dipyramidHexagonalDipyramid_nu_system_0] Other.HexagonalDipyramid.polyhedron.nieuwland :=
  PolynomialSystem.IsRootMax.isRootEq_singleton dipyramidHexagonalDipyramid_nu_roots_list

/-- **The representatives of `ν Other.HexagonalDipyramid.polyhedron`**: the same system, each with exactly one root, at the scale `ν Other.HexagonalDipyramid.polyhedron`. -/
theorem dipyramidHexagonalDipyramid_nu_reps_list :
    PolynomialSystem.IsRootEq [dipyramidHexagonalDipyramid_nu_system_0] Other.HexagonalDipyramid.polyhedron.nieuwland :=
  dipyramidHexagonalDipyramid_nu_shared_list

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Other.HexagonalDipyramid.polyhedron`, by representatives**: `ν Other.HexagonalDipyramid.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the first coordinate of the root of each of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootEq`, `Modules/System/PolyRootEq.lean`); the systems are those of `dipyramidHexagonalDipyramid_nu_reps_list`. -/
theorem dipyramidHexagonalDipyramid_nu_reps :
    ν Other.HexagonalDipyramid.polyhedron ∈ Set.Icc ((1083333333333333333333333333333 : ℝ) / 10 ^ 30) ((1083333333333333333333333333334 : ℝ) / 10 ^ 30) ∧
      IsPolyRootEq (ν Other.HexagonalDipyramid.polyhedron) :=
  ⟨dipyramidHexagonalDipyramid_nu.1, PolynomialSystem.isPolyRootEq (by decide +kernel) dipyramidHexagonalDipyramid_nu_reps_list⟩

end

end Nieuwland.Polyhedra
