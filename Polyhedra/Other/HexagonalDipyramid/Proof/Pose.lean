namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Other.HexagonalDipyramid.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Other.HexagonalDipyramid.polyhedron` scaled by `N` through itself. -/
theorem dipyramidHexagonalDipyramid_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.DipyramidHexagonalDipyramid.reps] N) :
    PolynomialSystem.IsPoseRoot Other.HexagonalDipyramid.polyhedron Pose.DipyramidHexagonalDipyramid.S N 22 13 31 := by
  rw [Pose.DipyramidHexagonalDipyramid.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.DipyramidHexagonalDipyramid.weak_check Pose.DipyramidHexagonalDipyramid.poly_eq Pose.DipyramidHexagonalDipyramid.ok

end Nieuwland.Polyhedra
