theorem points_eq : Polyhedron.ofPoints points = (Polyhedron.ofPoints Nieuwland.Polyhedra.DipyramidHexagonalDipyramidDim.points).smul (((1 : ℕ) : ℝ) * ((12 : ℕ) : ℝ) / ((1 : ℕ) : ℝ)) :=
