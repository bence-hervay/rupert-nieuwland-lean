import Polyhedra.Other.HexagonalDipyramid.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Other.HexagonalDipyramid.polyhedron`

`dipyramidHexagonalDipyramid_nu_system_<j>`: the systems of `dipyramidHexagonalDipyramid_exact` (`Nieuwland.Certs.NieuwlandDipyramidHexagonalDipyramid.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`dipyramidHexagonalDipyramid_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Other.HexagonalDipyramid.polyhedron` is the largest scale among
those roots (`dipyramidHexagonalDipyramid_nu_roots_list`). `dipyramidHexagonalDipyramid_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `dipyramidHexagonalDipyramid_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`dipyramidHexagonalDipyramid_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandDipyramidHexagonalDipyramid` and `Nieuwland.Certs.NieuwlandDipyramidHexagonalDipyramid.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Other.HexagonalDipyramid.polyhedron`: the equation `12 * ℓ - 13 = 0` with `ℓ` in the interval of the number's decimals (the system of `dipyramidHexagonalDipyramid_exact`). -/
noncomputable def dipyramidHexagonalDipyramid_nu_system_0 : PolynomialSystem :=
  ⟨[([(12, [(0, 1)])],
     [(13, [])])],
   [(1083333333333333333333333333333/1000000000000000000000000000000, 541666666666666666666666666667/500000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Other.HexagonalDipyramid.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `dipyramidHexagonalDipyramid_nu_roots`. -/
theorem dipyramidHexagonalDipyramid_nu_roots_list :
    PolynomialSystem.IsRootMax [dipyramidHexagonalDipyramid_nu_system_0] Other.HexagonalDipyramid.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var dipyramidHexagonalDipyramid_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Other.HexagonalDipyramid.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem dipyramidHexagonalDipyramid_nu_system_0_oneRoot : dipyramidHexagonalDipyramid_nu_system_0.HasUniqueRoot :=
  dipyramidHexagonalDipyramid_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Other.HexagonalDipyramid.polyhedron`, by roots**: `ν Other.HexagonalDipyramid.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `dipyramidHexagonalDipyramid_nu_system_<j>`. -/
theorem dipyramidHexagonalDipyramid_nu_roots :
    ν Other.HexagonalDipyramid.polyhedron ∈ Set.Icc ((1083333333333333333333333333333 : ℝ) / 10 ^ 30) ((1083333333333333333333333333334 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Other.HexagonalDipyramid.polyhedron) :=
  ⟨dipyramidHexagonalDipyramid_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) dipyramidHexagonalDipyramid_nu_roots_list⟩

end

end Nieuwland.Polyhedra
