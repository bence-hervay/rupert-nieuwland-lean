namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Other.CornerTetrahedron.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Other.CornerTetrahedron.polyhedron` scaled by `N` through itself. -/
theorem otherCornerTetrahedron_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.OtherCornerTetrahedron.reps] N) :
    PolynomialSystem.IsPoseRoot Other.CornerTetrahedron.polyhedron Pose.OtherCornerTetrahedron.S N 22 13 31 := by
  rw [Pose.OtherCornerTetrahedron.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.OtherCornerTetrahedron.weak_check Pose.OtherCornerTetrahedron.poly_eq Pose.OtherCornerTetrahedron.ok

end Nieuwland.Polyhedra
