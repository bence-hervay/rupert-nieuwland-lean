import Polyhedra.Other.CornerTetrahedron.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Other.CornerTetrahedron.polyhedron`

`otherCornerTetrahedron_nu_system_<j>`: the systems of `otherCornerTetrahedron_exact` (`Nieuwland.Certs.NieuwlandOtherCornerTetrahedron.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`otherCornerTetrahedron_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Other.CornerTetrahedron.polyhedron` is the largest scale among
those roots (`otherCornerTetrahedron_nu_roots_list`). `otherCornerTetrahedron_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `otherCornerTetrahedron_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`otherCornerTetrahedron_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandOtherCornerTetrahedron` and `Nieuwland.Certs.NieuwlandOtherCornerTetrahedron.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Other.CornerTetrahedron.polyhedron`: the equation `3 * ℓ ^ 2 - 4 = 0` with `ℓ` in the interval of the number's decimals (the system of `otherCornerTetrahedron_exact`). -/
noncomputable def otherCornerTetrahedron_nu_system_0 : PolynomialSystem :=
  ⟨[([(3, [(0, 2)])],
     [(4, [])])],
   [(1154700538379251529018297561003/1000000000000000000000000000000, 288675134594812882254574390251/250000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Other.CornerTetrahedron.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `otherCornerTetrahedron_nu_roots`. -/
theorem otherCornerTetrahedron_nu_roots_list :
    PolynomialSystem.IsRootMax [otherCornerTetrahedron_nu_system_0] Other.CornerTetrahedron.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var otherCornerTetrahedron_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Other.CornerTetrahedron.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem otherCornerTetrahedron_nu_system_0_oneRoot : otherCornerTetrahedron_nu_system_0.HasUniqueRoot :=
  otherCornerTetrahedron_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Other.CornerTetrahedron.polyhedron`, by roots**: `ν Other.CornerTetrahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `otherCornerTetrahedron_nu_system_<j>`. -/
theorem otherCornerTetrahedron_nu_roots :
    ν Other.CornerTetrahedron.polyhedron ∈ Set.Icc ((1154700538379251529018297561003 : ℝ) / 10 ^ 30) ((1154700538379251529018297561004 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Other.CornerTetrahedron.polyhedron) :=
  ⟨otherCornerTetrahedron_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) otherCornerTetrahedron_nu_roots_list⟩

end

end Nieuwland.Polyhedra
