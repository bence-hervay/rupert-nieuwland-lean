import Polyhedra.Other.DecagonalDipyramid.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Other.DecagonalDipyramid.polyhedron`

`dipyramidDecagonalDipyramid_nu_system_<j>`: the systems of `dipyramidDecagonalDipyramid_exact` (`Nieuwland.Certs.NieuwlandDipyramidDecagonalDipyramid.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`dipyramidDecagonalDipyramid_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Other.DecagonalDipyramid.polyhedron` is the largest scale among
those roots (`dipyramidDecagonalDipyramid_nu_roots_list`). `dipyramidDecagonalDipyramid_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `dipyramidDecagonalDipyramid_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`dipyramidDecagonalDipyramid_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandDipyramidDecagonalDipyramid` and `Nieuwland.Certs.NieuwlandDipyramidDecagonalDipyramid.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Other.DecagonalDipyramid.polyhedron`: the equation `80 * ℓ ^ 4 - 80 * ℓ ^ 3 - 160 * ℓ ^ 2 + 260 * ℓ - 101 = 0` with `ℓ` in the interval of the number's decimals (the system of `dipyramidDecagonalDipyramid_exact`). -/
noncomputable def dipyramidDecagonalDipyramid_nu_system_0 : PolynomialSystem :=
  ⟨[([(260, [(0, 1)]), (80, [(0, 4)])],
     [(101, []), (160, [(0, 2)]), (80, [(0, 3)])])],
   [(1042030336564058065843113417329/1000000000000000000000000000000, 104203033656405806584311341733/100000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Other.DecagonalDipyramid.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `dipyramidDecagonalDipyramid_nu_roots`. -/
theorem dipyramidDecagonalDipyramid_nu_roots_list :
    PolynomialSystem.IsRootMax [dipyramidDecagonalDipyramid_nu_system_0] Other.DecagonalDipyramid.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var dipyramidDecagonalDipyramid_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Other.DecagonalDipyramid.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem dipyramidDecagonalDipyramid_nu_system_0_oneRoot : dipyramidDecagonalDipyramid_nu_system_0.HasUniqueRoot :=
  dipyramidDecagonalDipyramid_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Other.DecagonalDipyramid.polyhedron`, by roots**: `ν Other.DecagonalDipyramid.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `dipyramidDecagonalDipyramid_nu_system_<j>`. -/
theorem dipyramidDecagonalDipyramid_nu_roots :
    ν Other.DecagonalDipyramid.polyhedron ∈ Set.Icc ((1042030336564058065843113417329 : ℝ) / 10 ^ 30) ((1042030336564058065843113417330 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Other.DecagonalDipyramid.polyhedron) :=
  ⟨dipyramidDecagonalDipyramid_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) dipyramidDecagonalDipyramid_nu_roots_list⟩

end

end Nieuwland.Polyhedra
