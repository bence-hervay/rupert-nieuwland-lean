theorem trapezohedronPentagonalTrapezohedron_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.TrapezohedronPentagonalTrapezohedron.reps] N) :
    PolynomialSystem.IsPoseRoot Other.PentagonalTrapezohedron.polyhedron Pose.TrapezohedronPentagonalTrapezohedron.S N 22 13 31 := by
