  exact PolynomialSystem.cf_isPoseRoot h Pose.TrapezohedronPentagonalTrapezohedron.weak_check Pose.TrapezohedronPentagonalTrapezohedron.poly_eq Pose.TrapezohedronPentagonalTrapezohedron.ok

