import Polyhedra.Other.PentagonalDipyramid.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Other.PentagonalDipyramid.polyhedron`

`dipyramidPentagonalDipyramid_nu_system_<j>`: the systems of `dipyramidPentagonalDipyramid_exact` (`Nieuwland.Certs.NieuwlandDipyramidPentagonalDipyramid.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`dipyramidPentagonalDipyramid_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Other.PentagonalDipyramid.polyhedron` is the largest scale among
those roots (`dipyramidPentagonalDipyramid_nu_roots_list`). `dipyramidPentagonalDipyramid_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `dipyramidPentagonalDipyramid_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`dipyramidPentagonalDipyramid_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandDipyramidPentagonalDipyramid` and `Nieuwland.Certs.NieuwlandDipyramidPentagonalDipyramid.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Other.PentagonalDipyramid.polyhedron`: the equation `361 * ℓ ^ 8 - 2954 * ℓ ^ 6 + 4331 * ℓ ^ 4 - 3394 * ℓ ^ 2 + 1681 = 0` with `ℓ` in the interval of the number's decimals (the system of `dipyramidPentagonalDipyramid_exact`). -/
noncomputable def dipyramidPentagonalDipyramid_nu_system_0 : PolynomialSystem :=
  ⟨[([(1681, []), (4331, [(0, 4)]), (361, [(0, 8)])],
     [(3394, [(0, 2)]), (2954, [(0, 6)])])],
   [(1005724530430691755678083591599/1000000000000000000000000000000, 2514311326076729389195208979/2500000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Other.PentagonalDipyramid.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `dipyramidPentagonalDipyramid_nu_roots`. -/
theorem dipyramidPentagonalDipyramid_nu_roots_list :
    PolynomialSystem.IsRootMax [dipyramidPentagonalDipyramid_nu_system_0] Other.PentagonalDipyramid.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var dipyramidPentagonalDipyramid_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Other.PentagonalDipyramid.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem dipyramidPentagonalDipyramid_nu_system_0_oneRoot : dipyramidPentagonalDipyramid_nu_system_0.HasUniqueRoot :=
  dipyramidPentagonalDipyramid_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Other.PentagonalDipyramid.polyhedron`, by roots**: `ν Other.PentagonalDipyramid.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `dipyramidPentagonalDipyramid_nu_system_<j>`. -/
theorem dipyramidPentagonalDipyramid_nu_roots :
    ν Other.PentagonalDipyramid.polyhedron ∈ Set.Icc ((1005724530430691755678083591599 : ℝ) / 10 ^ 30) ((1005724530430691755678083591600 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Other.PentagonalDipyramid.polyhedron) :=
  ⟨dipyramidPentagonalDipyramid_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) dipyramidPentagonalDipyramid_nu_roots_list⟩

end

end Nieuwland.Polyhedra
