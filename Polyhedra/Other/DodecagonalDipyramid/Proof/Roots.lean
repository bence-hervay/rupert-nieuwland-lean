set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Other.DodecagonalDipyramid.polyhedron`

`dipyramidDodecagonalDipyramid_nu_system_<j>`: the systems of `dipyramidDodecagonalDipyramid_exact` (`Nieuwland.Certs.NieuwlandDipyramidDodecagonalDipyramid.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`dipyramidDodecagonalDipyramid_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Other.DodecagonalDipyramid.polyhedron` is the largest scale among
those roots (`dipyramidDodecagonalDipyramid_nu_roots_list`). `dipyramidDodecagonalDipyramid_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `dipyramidDodecagonalDipyramid_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`dipyramidDodecagonalDipyramid_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandDipyramidDodecagonalDipyramid` and `Nieuwland.Certs.NieuwlandDipyramidDodecagonalDipyramid.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Other.DodecagonalDipyramid.polyhedron`: the equation `32 * ℓ ^ 4 - 32 * ℓ ^ 3 + 72 * ℓ ^ 2 + 112 * ℓ - 193 = 0` with `ℓ` in the interval of the number's decimals (the system of `dipyramidDodecagonalDipyramid_exact`). -/
noncomputable def dipyramidDodecagonalDipyramid_nu_system_0 : PolynomialSystem :=
  ⟨[([(112, [(0, 1)]), (72, [(0, 2)]), (32, [(0, 4)])],
     [(193, []), (32, [(0, 3)])])],
   [(206138161717707776185244789169/200000000000000000000000000000, 515345404294269440463111972923/500000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Other.DodecagonalDipyramid.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `dipyramidDodecagonalDipyramid_nu_roots`. -/
theorem dipyramidDodecagonalDipyramid_nu_roots_list :
    PolynomialSystem.IsRootMax [dipyramidDodecagonalDipyramid_nu_system_0] Other.DodecagonalDipyramid.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var dipyramidDodecagonalDipyramid_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Other.DodecagonalDipyramid.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem dipyramidDodecagonalDipyramid_nu_system_0_oneRoot : dipyramidDodecagonalDipyramid_nu_system_0.HasUniqueRoot :=
  dipyramidDodecagonalDipyramid_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Other.DodecagonalDipyramid.polyhedron`, by roots**: `ν Other.DodecagonalDipyramid.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `dipyramidDodecagonalDipyramid_nu_system_<j>`. -/
theorem dipyramidDodecagonalDipyramid_nu_roots :
    ν Other.DodecagonalDipyramid.polyhedron ∈ Set.Icc ((1030690808588538880926223945845 : ℝ) / 10 ^ 30) ((1030690808588538880926223945846 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Other.DodecagonalDipyramid.polyhedron) :=
  ⟨dipyramidDodecagonalDipyramid_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) dipyramidDodecagonalDipyramid_nu_roots_list⟩

end

end Nieuwland.Polyhedra
