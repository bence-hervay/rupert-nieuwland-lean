theorem S_eq : S = ctSystem reps0 touch kappa B := by
  decide +kernel

theorem len_eq : reps0.box.length = 33 := by
  decide +kernel

theorem poly_eq : Other.EnneagonalDipyramid.polyhedron = (Polyhedron.ofPoints Nieuwland.Polyhedra.DipyramidEnneagonalDipyramidDim.points).smul ((kappa : ℚ) : ℝ) := by
  rw [Nieuwland.Polyhedra.DipyramidEnneagonalDipyramidDim.eq_smul]
  congr 1
  norm_num [kappa]

end Nieuwland.Pose.DipyramidEnneagonalDipyramid

namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Other.EnneagonalDipyramid.polyhedron` as one root**: when the representatives' systems have
exactly one root each, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it
`matAt x 45`, `matAt x 36` and `(x 54, x 55)` are a weak fit of `Other.EnneagonalDipyramid.polyhedron` scaled
by `N` through itself. -/
theorem dipyramidEnneagonalDipyramid_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.DipyramidEnneagonalDipyramid.reps0] N) :
    PolynomialSystem.IsPoseRoot Other.EnneagonalDipyramid.polyhedron Pose.DipyramidEnneagonalDipyramid.S N 45 36 54 := by
  rw [Pose.DipyramidEnneagonalDipyramid.S_eq]
  exact PolynomialSystem.ct_isPoseRoot h List.mem_cons_self Pose.DipyramidEnneagonalDipyramid.len_eq Pose.DipyramidEnneagonalDipyramid.reps_eq
    (Root.ParData.theta_spec Nieuwland.Polyhedra.DipyramidEnneagonalDipyramidDim.root) Pose.DipyramidEnneagonalDipyramid.par_ok Pose.DipyramidEnneagonalDipyramid.zs_eq Pose.DipyramidEnneagonalDipyramid.weak_ok Pose.DipyramidEnneagonalDipyramid.poly_eq Pose.DipyramidEnneagonalDipyramid.ok

end Nieuwland.Polyhedra
