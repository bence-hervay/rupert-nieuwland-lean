/-!
# The dodecagonal trapezohedron

The polyhedron `Other.DodecagonalTrapezohedron.polyhedron`: the convex hull of 26 points,
with coordinates in `ℚ(θ)` (`polyEval c θ` is `∑ cᵢ θⁱ`).
-/

namespace Nieuwland.Other.DodecagonalTrapezohedron

/-- `θ`: the largest root of
`-2 + 76 * x ^ 2 - 858 * x ^ 4 + 2944 * x ^ 6 + x ^ 8`
in the interval `(3/16, 9/32)` (`realRoot`, `Definitions/Polynomials.lean`). -/
noncomputable def theta : ℝ :=
  realRoot [-2, 0, 76, 0, -858, 0, 2944, 0, 1] (3/16) (9/32)

@[inherit_doc] local notation "θ" => theta

open Classical in
/-- The dodecagonal trapezohedron: the convex hull of these 26 points. -/
noncomputable def polyhedron : Polyhedron where
