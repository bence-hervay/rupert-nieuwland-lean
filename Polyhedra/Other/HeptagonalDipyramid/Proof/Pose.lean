  decide +kernel

theorem len_eq : reps0.box.length = 33 := by
  decide +kernel

theorem poly_eq : Other.HeptagonalDipyramid.polyhedron = (Polyhedron.ofPoints Nieuwland.Polyhedra.DipyramidHeptagonalDipyramidDim.points).smul ((kappa : ℚ) : ℝ) := by
  rw [Nieuwland.Polyhedra.DipyramidHeptagonalDipyramidDim.eq_smul]
  congr 1
  norm_num [kappa]

end Nieuwland.Pose.DipyramidHeptagonalDipyramid

