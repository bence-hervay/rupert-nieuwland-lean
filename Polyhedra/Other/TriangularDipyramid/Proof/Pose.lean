namespace Nieuwland.Polyhedra

/-- **ν and an optimal pose of `Other.TriangularDipyramid.polyhedron` as one root**: when the representatives' system has exactly
one root, of scale `N`, the system `S` has exactly one root, of scale `N`, and at it `matAt x 22`,
`matAt x 13` and `(x 31, x 32)` are a weak fit of `Other.TriangularDipyramid.polyhedron` scaled by `N` through itself. -/
theorem dipyramidTriangularDipyramid_pose_of_reps {N : ℝ} (h : PolynomialSystem.IsRootEq [Pose.DipyramidTriangularDipyramid.reps] N) :
    PolynomialSystem.IsPoseRoot Other.TriangularDipyramid.polyhedron Pose.DipyramidTriangularDipyramid.S N 22 13 31 := by
  rw [Pose.DipyramidTriangularDipyramid.S_eq]
  exact PolynomialSystem.cf_isPoseRoot h Pose.DipyramidTriangularDipyramid.weak_check Pose.DipyramidTriangularDipyramid.poly_eq Pose.DipyramidTriangularDipyramid.ok

end Nieuwland.Polyhedra
