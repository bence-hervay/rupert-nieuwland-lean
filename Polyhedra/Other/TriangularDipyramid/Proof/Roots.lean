import Polyhedra.Other.TriangularDipyramid.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Other.TriangularDipyramid.polyhedron`

`dipyramidTriangularDipyramid_nu_system_<j>`: the systems of `dipyramidTriangularDipyramid_exact` (`Nieuwland.Certs.NieuwlandDipyramidTriangularDipyramid.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`dipyramidTriangularDipyramid_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Other.TriangularDipyramid.polyhedron` is the largest scale among
those roots (`dipyramidTriangularDipyramid_nu_roots_list`). `dipyramidTriangularDipyramid_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `dipyramidTriangularDipyramid_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`dipyramidTriangularDipyramid_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandDipyramidTriangularDipyramid` and `Nieuwland.Certs.NieuwlandDipyramidTriangularDipyramid.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Other.TriangularDipyramid.polyhedron`: the equation `25 * ℓ ^ 4 - 272 * ℓ ^ 2 + 256 = 0` with `ℓ` in the interval of the number's decimals (the system of `dipyramidTriangularDipyramid_exact`). -/
noncomputable def dipyramidTriangularDipyramid_nu_system_0 : PolynomialSystem :=
  ⟨[([(256, []), (25, [(0, 4)])],
     [(272, [(0, 2)])])],
   [(1020160444656816516032289308351/1000000000000000000000000000000, 15940006947762758063004520443/15625000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Other.TriangularDipyramid.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `dipyramidTriangularDipyramid_nu_roots`. -/
theorem dipyramidTriangularDipyramid_nu_roots_list :
    PolynomialSystem.IsRootMax [dipyramidTriangularDipyramid_nu_system_0] Other.TriangularDipyramid.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var dipyramidTriangularDipyramid_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Other.TriangularDipyramid.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem dipyramidTriangularDipyramid_nu_system_0_oneRoot : dipyramidTriangularDipyramid_nu_system_0.HasUniqueRoot :=
  dipyramidTriangularDipyramid_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Other.TriangularDipyramid.polyhedron`, by roots**: `ν Other.TriangularDipyramid.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `dipyramidTriangularDipyramid_nu_system_<j>`. -/
theorem dipyramidTriangularDipyramid_nu_roots :
    ν Other.TriangularDipyramid.polyhedron ∈ Set.Icc ((1020160444656816516032289308351 : ℝ) / 10 ^ 30) ((1020160444656816516032289308352 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Other.TriangularDipyramid.polyhedron) :=
  ⟨dipyramidTriangularDipyramid_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) dipyramidTriangularDipyramid_nu_roots_list⟩

end

end Nieuwland.Polyhedra
