namespace Nieuwland.Polyhedra

/-- **Rectified Rhombic Triacontahedron (Zomeball) is not Rupert.** -/
theorem otherRectifiedRhombicTriacontahedron_not_isRupert : ¬ Other.RectifiedRhombicTriacontahedron.polyhedron.IsRupert := by
  rw [Nieuwland.Results.Gen.OtherRectifiedRhombicTriacontahedron.eq_smul, Polyhedron.isRupert_smul_iff (by norm_num)]
  exact Nieuwland.Results.Gen.OtherRectifiedRhombicTriacontahedron.not_isRupert

/-- **The Nieuwland number of Rectified Rhombic Triacontahedron (Zomeball) is 1**: it is full-dimensional (`Nieuwland.Results.Gen.OtherRectifiedRhombicTriacontahedron.span_ok`) and not
Rupert, so no copy of a ratio above 1 passes through it and every smaller one does. -/
theorem otherRectifiedRhombicTriacontahedron_nieuwland : Other.RectifiedRhombicTriacontahedron.polyhedron.nieuwland = 1 := by
  refine Polyhedron.nieuwland_eq_one_of_not_isRupert ?_ otherRectifiedRhombicTriacontahedron_not_isRupert
  rw [Nieuwland.Results.Gen.OtherRectifiedRhombicTriacontahedron.eq_smul]
  exact (Check.Polyhedron.fullDim_of_spanOk Nieuwland.Results.Gen.OtherRectifiedRhombicTriacontahedron.span_ok).smul (by norm_num)

/-- Rectified Rhombic Triacontahedron (Zomeball): the exact Nieuwland number in the list form of `Modules/System/System.lean`: the
largest scale `x 0` of the solutions of the system `x 0 = 1` (no box), its one scale, and so
between these decimals. -/
theorem otherRectifiedRhombicTriacontahedron_exact_list :
    PolynomialSystem.IsMaxSingle [⟨[([(1, [(0, 1)])], [(1, [])])], []⟩] Other.RectifiedRhombicTriacontahedron.polyhedron.nieuwland ∧
      Other.RectifiedRhombicTriacontahedron.polyhedron.nieuwland ∈ Set.Icc ((1000000000000000000000000000000 : ℝ) / 10 ^ 30)
        ((1000000000000000000000000000000 : ℝ) / 10 ^ 30) := by
  obtain ⟨h, h1, h2⟩ := isMaxSingle_scales_one otherRectifiedRhombicTriacontahedron_nieuwland
  exact ⟨h, le_trans (by norm_num) h1, le_trans h2 (by norm_num)⟩

section

open scoped Nieuwland.Notation

/-- **Rectified Rhombic Triacontahedron (Zomeball): the exact Nieuwland number `ν Other.RectifiedRhombicTriacontahedron.polyhedron`**: the largest scale `ℓ` of the real solutions
of `ℓ - 1 = 0`, and its decimals (the statement of `Modules/System/Readable.lean`, from
`otherRectifiedRhombicTriacontahedron_exact_list`). -/
theorem otherRectifiedRhombicTriacontahedron_exact :
    IsGreatest {ℓ : ℝ | ℓ - 1 = 0}
      (ν Other.RectifiedRhombicTriacontahedron.polyhedron) ∧
      ν Other.RectifiedRhombicTriacontahedron.polyhedron ∈ Set.Icc ((1000000000000000000000000000000 : ℝ) / 10 ^ 30)
        ((1000000000000000000000000000000 : ℝ) / 10 ^ 30) :=
  ⟨Readable.isGreatest [0] (by decide +kernel) otherRectifiedRhombicTriacontahedron_exact_list.1.1, otherRectifiedRhombicTriacontahedron_exact_list.2⟩

/-- **The Nieuwland number of `Other.RectifiedRhombicTriacontahedron.polyhedron`**: `ν Other.RectifiedRhombicTriacontahedron.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the
largest value of the first variable over the real solutions of finitely many systems of integer
polynomial equations in rational intervals, each system's solutions with one value of it
(`IsPolynomialSystemMax`, `Modules/System/PolyMax.lean`); `otherRectifiedRhombicTriacontahedron_exact` writes the system out. -/
theorem otherRectifiedRhombicTriacontahedron_nu :
    ν Other.RectifiedRhombicTriacontahedron.polyhedron ∈ Set.Icc ((1000000000000000000000000000000 : ℝ) / 10 ^ 30) ((1000000000000000000000000000001 : ℝ) / 10 ^ 30) ∧
      IsPolynomialSystemMax (ν Other.RectifiedRhombicTriacontahedron.polyhedron) :=
  ⟨PolynomialSystem.mem_Icc_dec 1000000000000000000000000000000 1000000000000000000000000000000 1000000000000000000000000000000 1000000000000000000000000000001 30 ⟨otherRectifiedRhombicTriacontahedron_exact_list.1.1, otherRectifiedRhombicTriacontahedron_exact_list.2⟩ (by decide +kernel),
   PolynomialSystem.isPolynomialSystemMax (by decide +kernel) otherRectifiedRhombicTriacontahedron_exact_list.1⟩

end

