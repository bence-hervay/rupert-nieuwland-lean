/-!
# The Noperthedron

The polyhedron `Other.Noperthedron.polyhedron`: the convex hull of 90 points,
with coordinates in `ℚ(θ)` (`polyEval c θ` is `∑ cᵢ θⁱ`).
-/

namespace Nieuwland.Other.Noperthedron

/-- `θ`: the largest root of
`1 - 8 * x ^ 2 + 14 * x ^ 4 - 7 * x ^ 6 + x ^ 8`
in the interval `(99/50, 199/100)` (`realRoot`, `Definitions/Polynomials.lean`). -/
noncomputable def theta : ℝ :=
  realRoot [1, 0, -8, 0, 14, 0, -7, 0, 1] (99/50) (199/100)

@[inherit_doc] local notation "θ" => theta

