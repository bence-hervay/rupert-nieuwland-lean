import Polyhedra.Other.OctagonalDipyramid.Proof.Exact
import Modules.System.OneRoot

set_option linter.style.longLine false

/-!
# Exactly one root per system: `ν Other.OctagonalDipyramid.polyhedron`

`dipyramidOctagonalDipyramid_nu_system_<j>`: the systems of `dipyramidOctagonalDipyramid_exact` (`Nieuwland.Certs.NieuwlandDipyramidOctagonalDipyramid.Exact`) (here one: the number's minimal polynomial in the interval of its decimals). Each has
**exactly one real solution with every variable in its interval** (`dipyramidOctagonalDipyramid_nu_system_<j>_oneRoot`:
`PolynomialSystem.HasUniqueRoot`, `Modules/System/PolyRootOf.lean`), and `ν Other.OctagonalDipyramid.polyhedron` is the largest scale among
those roots (`dipyramidOctagonalDipyramid_nu_roots_list`). `dipyramidOctagonalDipyramid_nu_roots` is the statement in Mathlib's terms alone
(`IsPolyRootMax`, `Modules/System/PolyRoot.lean`), which implies that of the headline `dipyramidOctagonalDipyramid_nu`
(`IsPolyRootMax.isPolynomialSystemMax`). The system has one variable, the scale, so its one scale (`dipyramidOctagonalDipyramid_exact_list`) is its one root (`PolynomialSystem.IsMaxSingle.isRootMax_of_one_var`).
Generated by `lean/scripts/exact_n.py` from the theorems of `Nieuwland.Certs.NieuwlandDipyramidOctagonalDipyramid` and `Nieuwland.Certs.NieuwlandDipyramidOctagonalDipyramid.Exact`,
which it does not change.
-/

namespace Nieuwland.Polyhedra

open Check

set_option maxHeartbeats 0 in
/-- System 0 of `ν Other.OctagonalDipyramid.polyhedron`: the equation `4 * ℓ ^ 4 - 12 * ℓ ^ 2 + 24 * ℓ - 17 = 0` with `ℓ` in the interval of the number's decimals (the system of `dipyramidOctagonalDipyramid_exact`). -/
noncomputable def dipyramidOctagonalDipyramid_nu_system_0 : PolynomialSystem :=
  ⟨[([(24, [(0, 1)]), (4, [(0, 4)])],
     [(17, []), (12, [(0, 2)])])],
   [(1059619101218428896564535253241/1000000000000000000000000000000, 529809550609214448282267626621/500000000000000000000000000000)]⟩

set_option maxHeartbeats 0 in
/-- **`ν Other.OctagonalDipyramid.polyhedron` is the largest scale of the roots of its system**, each of which has exactly one root: the list form of `dipyramidOctagonalDipyramid_nu_roots`. -/
theorem dipyramidOctagonalDipyramid_nu_roots_list :
    PolynomialSystem.IsRootMax [dipyramidOctagonalDipyramid_nu_system_0] Other.OctagonalDipyramid.polyhedron.nieuwland :=
  PolynomialSystem.IsMaxSingle.isRootMax_of_one_var dipyramidOctagonalDipyramid_exact_list.1 (by decide) (by decide +kernel)

/-- **System 0 of `ν Other.OctagonalDipyramid.polyhedron` has exactly one root**: one real point with every variable in its interval solves its equations. -/
theorem dipyramidOctagonalDipyramid_nu_system_0_oneRoot : dipyramidOctagonalDipyramid_nu_system_0.HasUniqueRoot :=
  dipyramidOctagonalDipyramid_nu_roots_list.2 _ (by simp)

section

open scoped Nieuwland.Notation

set_option maxHeartbeats 0 in
/-- **The Nieuwland number of `Other.OctagonalDipyramid.polyhedron`, by roots**: `ν Other.OctagonalDipyramid.polyhedron` lies in `[k, k + 1] / 10 ^ 30`, and it is the largest first coordinate of the roots of finitely many systems of integer polynomial equations, each in a rational box of all its variables and each with exactly one root in its box (`IsPolyRootMax`, `Modules/System/PolyRoot.lean`); the systems are `dipyramidOctagonalDipyramid_nu_system_<j>`. -/
theorem dipyramidOctagonalDipyramid_nu_roots :
    ν Other.OctagonalDipyramid.polyhedron ∈ Set.Icc ((1059619101218428896564535253241 : ℝ) / 10 ^ 30) ((1059619101218428896564535253242 : ℝ) / 10 ^ 30) ∧
      IsPolyRootMax (ν Other.OctagonalDipyramid.polyhedron) :=
  ⟨dipyramidOctagonalDipyramid_nu.1, PolynomialSystem.isPolyRootMax (by decide +kernel) dipyramidOctagonalDipyramid_nu_roots_list⟩

end

end Nieuwland.Polyhedra
