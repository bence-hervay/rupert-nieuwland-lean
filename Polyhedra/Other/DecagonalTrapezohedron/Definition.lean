import Definitions.Polynomials

/-!
# The decagonal trapezohedron

The polyhedron `Other.DecagonalTrapezohedron.polyhedron`: the convex hull of 22 points,
with coordinates in `ℚ(θ)` (`polyEval c θ` is `∑ cᵢ θⁱ`).
-/

namespace Nieuwland.Other.DecagonalTrapezohedron

/-- `θ`: the largest root of
`25 - 450 * x ^ 2 + 1090 * x ^ 4 + 1330 * x ^ 6 + x ^ 8`
in the interval `(3/16, 3/8)` (`realRoot`, `Definitions/Polynomials.lean`). -/
noncomputable def theta : ℝ :=
  realRoot [25, 0, -450, 0, 1090, 0, 1330, 0, 1] (3/16) (3/8)

@[inherit_doc] local notation "θ" => theta

open Classical in
/-- The decagonal trapezohedron: the convex hull of these 22 points. -/
